# linux-gcc16-release — the gcc-16.2 ship/CI toolchain (replaces gcc-15.3; Founder green light
# 2026-08-16 on the eval: 27/27 packages, 2822/2822 tests, determinism digest byte-identical to
# 15.3, +34% ship-leg compile cost accepted). Flags MIRROR linux-clang21-release EXACTLY so the
# determinism gate proves gcc-16.2 ≡ clang-21 bit-identity (det_math is integer / no-libm /
# -ffp-contract-invariant by design, so the serialized document MUST match across both).
# Auto-keys to the 'gcc16-release' conan cache + build-gcc16-release/ tree via _malf_profile_key.
#
# HISTORY: 16.1.0 parked this profile 2026-06-06 — ICE (segfault in build_special_member_call)
# on module-attached classes' member-init, filed as GCC PR 125768, CONFIRMED FIXED in 16.2.0 on
# the June repros. The 16.2 residual defect (lazy-pendings BMI read on insight-e2e's two
# contract-BMI-reading targets) is scoped where it lives: insight-e2e's CMake carries the
# GNU-gated -fno-module-lazy with the upstream PR number and its removal trigger.
#
# SOURCE: the sha256-pinned from-source build published by build-gcc-toolchain.yml (x64+arm64
# native bootstraps, release tag gcc-16.2.0); setup-gcc extracts it to /opt/gcc-16.2 in CI and
# the devcontainer — the desk mirrors it. Never the ubuntu-toolchain-r PPA (snapshot, not a
# determinism-leg compiler).
[settings]
arch=x86_64
build_type=Release
compiler=gcc
# EXACT version token, not the gcc15-style major-only "16": the gcc16-release keyed cache carried
# 16.1-era third-party binaries, and under version=16 they share a package_id with 16.2 builds —
# conan would silently serve a 16.1-built .a to a 16.2 link. 16.2 (declared in the seeded
# settings_user.yml) makes cross-16.x staleness structurally impossible; a future 16.x point bump
# rebuilds third-party once in this cache, a rare bounded cost.
compiler.version=16.2
compiler.cppstd=gnu23
compiler.libcxx=libstdc++11
os=Linux

[buildenv]
CC=/opt/gcc-16.2/bin/gcc
CXX=/opt/gcc-16.2/bin/g++
# 16.2 binaries link its newer libstdc++; expose it to build-time gtest_discover_tests runs.
LD_LIBRARY_PATH=/opt/gcc-16.2/lib64

[conf]
# Portable x86_64 baseline (SSE4.2 / POPCNT / CX16). Safe on every GitHub-hosted runner;
# -march=native would make the build host emit AVX2/AVX-512 the test runner may not support
# (SIGILL in gtest_discover_tests). Going through [conf] (not [buildenv] CXXFLAGS) is
# mandatory: only tools.build:cflags / tools.build:cxxflags are propagated by Conan's
# CMakeToolchain into CMAKE_C_FLAGS_INIT / CMAKE_CXX_FLAGS_INIT.
tools.build:cflags=["-O3", "-march=x86-64-v2"]
tools.build:cxxflags=["-O3", "-march=x86-64-v2"]
# from-source gcc-16.2 lives under /opt; rpath its libstdc++ into every binary so tests run
# without LD_LIBRARY_PATH (determinism-neutral — the gate compares serialized output, not the
# loader path).
tools.build:exelinkflags=["-Wl,-rpath,/opt/gcc-16.2/lib64"]
tools.build:sharedlinkflags=["-Wl,-rpath,/opt/gcc-16.2/lib64"]
# Editable build-dir keying: the profile carries the keyed build dir so a RAW
# `conan create --profile <this>` (no malf env) still resolves an editable dep's
# matching-profile build tree, closing the cross-stdlib editable .a contamination.
# malf still sets MALF_EDITABLE_BUILD_DIR (takes precedence; covers sanitizer profiles).
user.malf:editable_build_dir=build-gcc16-release
# gcc-16's -Wmaybe-uninitialized false positive on constructor initializer lists (GCC PR 125203,
# a [16 Regression]) fires inside redis-plus-plus 1.3.15's OWN -Werror build (reply.h:54
# ParseError / sentinel.h:130 StopIterError — the diagnostic cannot even name a variable).
# Upstream confirmed + fixed on master (sewenew/redis-plus-plus#678, 2026-07-18: _err_info/_to_msg
# made static), but NO release carries it and conancenter's head is 1.3.15. Desk-verified
# 2026-08-16: without this line the package REDS on exactly those two sites; with it, the build is
# green and all 5 diagnostics stay VISIBLE as warnings (-Wno-error=<name> is per-diagnostic and
# position-independent under the library's blanket -Werror). Scope: this one package, this one
# named diagnostic — any NEW warning class still reds (fail-closed). The per-package conf REPLACES
# the global cxxflags, so the base flags are repeated verbatim. REMOVAL TRIGGER, first to land:
# conan-center-index PR #30798 (our backport of the upstream fix; on merge the 1.3.15 recipe
# revision carries the patch — take it at the next lock --update, delete this block), a
# redis-plus-plus release > 1.3.15 on conancenter, or a ship gcc with the PR 125203 fix. A local
# recipe fork or a source-mutating hook was rejected: the first grows the supply-chain surface
# we'd own forever, the second makes the SBOM lie about the built bits.
redis-plus-plus/*:tools.build:cxxflags=["-O3", "-march=x86-64-v2", "-Wno-error=maybe-uninitialized"]
