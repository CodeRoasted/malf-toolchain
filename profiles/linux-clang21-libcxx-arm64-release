# linux-clang21-libcxx-arm64-release — the Linux-arm64 (aarch64) twin of linux-clang21-libcxx-release.
# The clang/libc++ half of the arm64 cross-stdlib diagonal: paired with linux-gcc16-arm64-release it
# proves gcc-16/libstdc++ and clang-21/libc++ agree byte-for-byte ON arm64 — the axis that exposes
# unordered-container / hash-iteration-order leaks, which can differ by ISA. Flags MIRROR the x86
# libc++ profile except arch=armv8 and the armv8-a baseline (see linux-gcc16-arm64-release for the
# ISA-specific notes). clang-21 + libc++-21 come from apt.llvm.org, which serves aarch64 — so
# setup-clang21-libcxx is already arch-agnostic; only the profile's arch/-march change here.
[settings]
arch=armv8
build_type=Release
compiler=clang
compiler.version=21
compiler.cppstd=gnu23
compiler.libcxx=libc++
os=Linux

[buildenv]
CC=clang-21
CXX=clang++-21

[conf]
tools.build:cflags=["-O3", "-march=armv8-a"]
tools.build:cxxflags=["-O3", "-march=armv8-a", "-stdlib=libc++"]
tools.build:exelinkflags=["-stdlib=libc++"]
tools.build:sharedlinkflags=["-stdlib=libc++"]
# arm64-keyed build dir (see linux-gcc16-arm64-release); keeps the arm64 libc++ tree off the x86 one.
user.malf:editable_build_dir=build-clang21-libcxx-arm64-release
