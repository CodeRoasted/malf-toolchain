# linux-clang21-libcxx-debug — clang-21 + libc++ + Debug, NO sanitizer. THE DESK DEBUG LEG.
#
# WHY IT EXISTS. Four first-party behaviours are gated on the Debug CONFIGURATION, not on a flag
# anyone passes: (1) spdlog's compile-time elision threshold — `$<IF:$<CONFIG:Debug>,TRACE,INFO>`,
# so debug/trace records exist as code at all; (2) insight-canon's arena reset-poison instrument
# (`INSIGHT_CANON_ARENA_POISON_MODE=AUTO` resolves to `$<CONFIG:Debug>`), without which the
# use-after-reset arms in core/tests/arena/ SKIP; (3) `NDEBUG`, hence the one shipped first-party
# `assert()` (core/src/arena/arena_allocator.cpp, `assert(is_power_of_two(alignment))`); (4)
# LogCraft's console default (core/src/logging/logger.cpp: `default_build_level()` and
# `default_build_console()` both branch on `NDEBUG`). Every other Linux profile here declares
# `build_type=Release`, and the only Debug one arrives with AddressSanitizer attached — so before
# this file the desk could not have the four without paying the ASan tax. It is a DEVELOPMENT
# convenience leg: it ships nothing, gates nothing, and is not part of the determinism diagonal.
#
# DERIVATION: this is `linux-clang21-asan` MINUS the sanitizer — one axis moved — and deliberately
# NOT the dev default `linux-clang21-libcxx-release` re-declared at Debug. The dev default carries
# `-O3`, and a profile whose NAME says debug while its codegen is the release codegen is exactly
# the name-vs-configuration divergence the build-type-as-profile-coordinate change removed; a
# debugger reading inlined frames and optimised-out locals is the thing this leg is supposed to
# fix. `-O1 -g -fno-omit-frame-pointer` is kept verbatim from the ASan leg rather than lowered to
# `-O0`: that would be a SECOND axis move past the stated derivation, and the ASan leg's codegen is
# already the workspace's proven debuggable one, with test runtimes the existing timeouts are sized
# for. `-march=x86-64-v2` is kept for the same reason — the canon hot path compiles against it.
#
# libc++ (NOT libstdc++) is MANDATORY, same as every clang leg here: the first-party targets are
# C++23 modules that `import std`, and clang-21's std module ships ONLY with libc++-21. It also
# keeps this leg the same PROGRAM as the dev default — same standard library, one coordinate (the
# build type) apart — so a difference observed under it is attributable to the build type alone.
# Requires clang-21 + libc++-21-dev + libc++abi-21-dev (LLVM apt) and the libc++.modules.json
# symlink bridge documented in linux-clang21-libcxx-release (same import-std prerequisite).
[settings]
arch=x86_64
build_type=Debug
compiler=clang
compiler.version=21
compiler.cppstd=gnu23
compiler.libcxx=libc++
os=Linux

[buildenv]
CC=clang-21
CXX=clang++-21

[conf]
# -stdlib=libc++ is implied by libcxx=libc++; explicit on compile + link for robustness.
tools.build:cflags=["-O1", "-g", "-march=x86-64-v2", "-fno-omit-frame-pointer"]
tools.build:cxxflags=["-O1", "-g", "-march=x86-64-v2", "-fno-omit-frame-pointer", "-stdlib=libc++"]
tools.build:exelinkflags=["-stdlib=libc++"]
tools.build:sharedlinkflags=["-stdlib=libc++"]
# Editable build-dir keying: the profile carries the keyed build dir so a RAW
# `conan create --profile <this>` (no malf env) still resolves an editable dep's
# matching-profile build tree, closing the cross-stdlib editable .a contamination.
# malf still sets MALF_EDITABLE_BUILD_DIR (takes precedence; covers sanitizer profiles).
user.malf:editable_build_dir=build-clang21-libcxx-debug
