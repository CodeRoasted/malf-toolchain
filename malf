#!/usr/bin/env bash
# malf — unified build system for coderoast C++ projects
#
# Usage:
#   malf build   [subdir] [--asan|--profile <name>]
#   malf test    [subdir] [--asan|--profile <name>] [--filter PATTERN]
#   malf lint    [--all-files] [-c|--console]
#   malf format  [--check]
#   malf commands|compile-commands
#   malf bench   [subdir] [--quick] [--filter REGEX] [--compare] [--repetitions N]
#   malf clean   <build|conan|editables|stale|all>   (NO default; `all` is the nuclear form)
#   malf bump    X.Y.Z
#   malf inventory [dir]
#   malf cut-verify [pkg] [--profile <name>] [--list]
#   malf run     <exe-name>
#   malf editables [list|sync]
#   malf slot    [status|acquire|release]
#
# Verb semantics:
#   `build` compiles EVERYTHING — package + tests + benches (one compile
#   surface; a bench-only TU can't rot unseen), and since the inventory contract (ADR-3.D9) that promise is
#   ENFORCED rather than asserted: `build`/`test` also run the INVENTORY, which
#   fails on any CMake `project()` no package build configures. That clause used
#   to be false — `insight-canon/proof/` rotted unseen for a whole release cycle. `test` runs ctest and `bench`
#   runs the bench executables, each on top of the same incremental build.
#
# Targets:
#   No arg = every package under the current dir, dependency-ordered (a
#   mono-package root degenerates to the single package). An explicit arg
#   naming a package dir = exactly that package. Build trees are package-
#   anchored (<pkg>/build-<profile-key>) — the same tree whether the package
#   is the target, a sibling's editable dep, or built from its own subfolder,
#   from any invocation directory.
#
# Workspace Dependencies:
#   Workspace packages are automatically registered as Conan editables and
#   built in dependency order. This keeps local builds fast and incremental.
#   CMakeDeps resolves concrete library files from each dependency's
#   package-anchored build tree, and header paths from each package's api/
#   directory.
#
# Run from any directory that contains a conanfile.py (or any parent of
# dirs that contain one).

set -euo pipefail

# Did the CALLER export MALF_BUILD_PROFILE? Captured HERE, at the top, for two reasons: the
# default seeding further down makes the variable non-empty either way (so the two cases become
# indistinguishable after it), and `set -u` makes reading an undefined name fatal — so the answer
# has to exist before any function that consults it can possibly run, whatever the call order.
# _malf_apply_profile needs the distinction: a caller's override must survive `--profile`, this
# file's own default must not. See the arm64 defect recorded there.
MALF_BUILD_PROFILE_EXPLICIT="${MALF_BUILD_PROFILE:+1}"

MALF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CWD="$(pwd)"
MALF_WORKSPACE_ROOT="${MALF_WORKSPACE_ROOT:-$(cd "$MALF_DIR/.." && pwd)}"
# Build-time codegen reachability. logcraft/core's CMake generates the Intent library by
# invoking ${MALF_TOOLCHAIN_DIR}/intent_library_codegen.py, resolving cache var -> env ->
# the SIBLING default <workspace>/malf, and FATALs if the tool is absent.
#
# The sibling default holds for an EDITABLE build (source stays in the worktree) and breaks
# for `conan create` (sources are exported to <cache>/p/<pkg>/es, so ../../malf resolves
# inside the conan cache and does not exist). That is the whole released path: cut-verify and
# every release-publish create. Exporting it here fixes every malf-driven create at once, and
# malf is the one component that always knows where the toolchain is -- it IS the toolchain.
# Respects a caller's value so an out-of-tree checkout can still point elsewhere.
export MALF_TOOLCHAIN_DIR="${MALF_TOOLCHAIN_DIR:-$MALF_DIR}"
# The dev-default toolchain (founder 2026-06-04, the clang→libc++ flip). Single
# source of truth — the profile fallback, the cache-key arm, and the build-dir
# naming below all derive from it.
# Env-overridable so a single-profile context (e.g. a CI benchmark job that vendored its
# first-party deps into the BASE cache) can make its profile THE default — which makes
# _malf_profile_key return "" (no keyed sub-cache), so the build resolves those vendored
# deps from the base cache instead of an empty keyed one. Unset → the dev default below.
MALF_DEFAULT_PROFILE="${MALF_DEFAULT_PROFILE:-linux-clang21-libcxx-release}"
MALF_AUTO_WORKSPACE_DEPS="${MALF_AUTO_WORKSPACE_DEPS:-1}"

# ─── Source-walk guards (format + lint) ──────────────────────────────────────
# Both `format` and `lint` walk the tree for source extensions and hand what
# they find to an LLVM tool. Both tools' peak memory scales with input size,
# steeply: clang-format-21 costs several HUNDRED times a file's size (measured:
# 1.3 MB -> 1.27 GB RSS, 5.4 MB -> 2.52 GB, 10.8 MB aborts past an 8 GB cap,
# 27 MB does not finish in 2 min). So ONE stray large file carrying a source
# extension — a vendored blob, a generated table, a dumped model — exhausts the
# box. Under WSL that does not OOM-kill a single process: the kernel thrashes
# the swap file until the whole distro dies (founder, 2026-07-21, `format` at
# the workspace root over a GGUF-adjacent tree).
# Two independent guards, because either alone leaves a hole:
#   size cap — keeps pathological inputs out of the tool entirely
#   address-space cap — bounds the damage when a *small* file behaves badly
# The largest real source file in this workspace is ~99 KB and a real clang-tidy
# TU peaks at ~436 MB, so both defaults sit an order of magnitude above anything
# legitimate and well below the RAM whose exhaustion kills the box.
MALF_SOURCE_MAX_FILE_KB="${MALF_SOURCE_MAX_FILE_KB:-2048}"
MALF_SOURCE_MEM_LIMIT_KB="${MALF_SOURCE_MEM_LIMIT_KB:-4194304}"
# Files per clang-format process. Bounds the blast radius of a pathological
# file to its own batch instead of the whole run; ~15 processes for this
# workspace's 713 files, so the startup cost is noise. (`lint` fans out at
# -n 1 already, so it needs no equivalent.)
MALF_FORMAT_BATCH_SIZE="${MALF_FORMAT_BATCH_SIZE:-50}"

# The WORKSPACE BUILD SLOT (see cmd_slot). Under ${TMPDIR:-/tmp} and not in the worktree: it
# coordinates lanes across every repo at once, so it belongs to no repo, and a git-visible lock
# would be staged by somebody eventually. The default path is the one the hand-rolled protocol
# already used, so this replaces that practice rather than starting a second one beside it.
MALF_BUILD_SLOT_DIR="${MALF_BUILD_SLOT_DIR:-${TMPDIR:-/tmp}/coderoast-build-slot}"
# How long `malf slot` waits for the mutex around one read-decide-write. Not how long it waits
# for the SLOT — the slot is never waited on, it is reported.
MALF_BUILD_SLOT_WAIT_S="${MALF_BUILD_SLOT_WAIT_S:-10}"
# Directory BASENAMES (glob-matched) pruned from BOTH walks — the single
# hazard baseline, so the two commands cannot drift apart the way two
# hand-maintained exclusion lists always do. Pruned, not filtered: a
# `-not -path` test still descends into and stat-s every entry beneath the
# directory it claims to exclude.
# `.model` / `.model-build` are the explain-overlay trees: the latter holds a
# full llama.cpp checkout (thousands of TUs), the former the GGUF asset.
# Add project-specific dirs via MALF_{FORMAT,LINT}_EXCLUDE_EXTRA, not here.
MALF_SOURCE_EXCLUDE_DIRS="${MALF_SOURCE_EXCLUDE_DIRS:-build build-* .conan2 .cache .git data node_modules .venv venv third_party vendor _deps .model .model-build}"
# ─── D-LSRC-2 · the corpus EVIDENCE shelf is OUTSIDE the clang-format surface ─
# THE LAW. `format` never walks a directory named `sift_assessment`.
# `coderoast-corpora/sift_assessment/<version>/` holds Sift measurement runs —
# "evidence, not tooling" (`coderoast-corpora/README.md`). A `.cpp` sitting there
# is the program that produced the `census_output.txt` and `RESULTS.md` beside
# it, kept so those numbers have a provenance. Reformatting it edits a record to
# satisfy a gate that has no consumer for the result.
#
# Measured 2026-08-31, four legs and none of them quoted:
#   * `coderoast-corpora` carries NO conanfile.py and NO CMakeLists.txt anywhere.
#     It is not a package. `format` reaches it only because it walks directories
#     by file EXTENSION — so nothing compiles the file, and no reviewer reads it
#     as source.
#   * exactly ONE file in the whole repository carries a source extension:
#     `sift_assessment/1.10.2/m3_where_anchor/m3_where_anchor_census_test.cpp`,
#     12 clang-format violations, committed red long before this ruling. It could
#     not build here anyway: it imports `insight.sift.test`, a module owned by
#     another repo, with no build file within reach.
#   * its own first line declares what it is — "throwaway measurement code
#     (`DN-59.O2` M3) … its source and its numbers live beside each other" — and
#     its author had already taken the LINT arm off it by hand: NOLINTBEGIN at
#     line 1, NOLINTEND at line 283. `format` has no per-file escape that does not
#     itself rewrite the file, which is the whole difficulty.
#   * a SECOND workspace instrument already classifies this exact prefix as a
#     record shelf — `scripts/registry_grammar_lint.py`'s LEGACY_RECORD_PREFIXES,
#     331 record exemptions on its 2026-08-31 run. This line makes the two agree
#     instead of leaving one gate rewriting what the other protects.
#
# THE BOUNDARY IS THE README'S, NOT THE REPOSITORY'S. A corpus's `scripts/` holds
# real collector tooling and stays fully in scope; only the evidence shelf leaves
# it. So what is excluded is the DIRECTORY NAME `sift_assessment` — glob-matched
# at any depth by `_malf_prune_args`, one directory in the workspace today — and
# never the repo. A future C++ collector under `<platform>_corpora/…/scripts/` is
# formatted like any other source.
#
# LINT NEEDS NO COUNTERPART, and that is a fact about the mechanism rather than a
# second policy: `lint --all-files` filters its walk against the compile database,
# and a file no package builds has no entry, so it is dropped before clang-tidy
# is spent on it. Read out of cmd_lint on 2026-08-31, NOT measured by running —
# re-derive it before relying on it if that filter ever moves.
#
# ITS ONE HOLE, declared because an env default is not a config file and malf
# reads none: an operator who sets MALF_FORMAT_EXCLUDE_EXTRA for a reason of their
# own REPLACES this default and silently loses the exclusion. That is the same
# override shape MALF_SOURCE_EXCLUDE_DIRS already carries. What the default buys
# is that the exclusion lives in git and needs nobody to remember it — before this
# line, `malf format --check coderoast-corpora` was red for everyone who ran it,
# and so was a no-arg sweep from the workspace root.
#
# WHAT THIS DOES NOT MAKE GREEN, because the surprise is worth pre-empting:
# `malf format --check coderoast-corpora` — an EXPLICIT pathspec — still exits 1,
# now saying "no source file under". That is cmd_format's anti-vacuity rule, not
# a residue of this exclusion: an explicit path matching nothing is a typo or a
# wrong directory, and reporting it as a clean format is the silent-green shape.
# `coderoast-web` has answered exactly that way for as long as it has existed, so
# this line moves `coderoast-corpora` into a class that was already declared
# rather than inventing a state. The two invocations that carry a verdict are
# both green and both measured 2026-08-31: a no-arg sweep INSIDE the repo exits 0
# ("nothing to do"), and the workspace-root sweep no longer walks the shelf.
MALF_FORMAT_EXCLUDE_EXTRA="${MALF_FORMAT_EXCLUDE_EXTRA:-sift_assessment}"
# ─── D-LSRC-1 · test and benchmark TUs are OUTSIDE the clang-tidy surface ────
# THE LAW, and it is unconditional. `lint` never walks test_package/,
# technical_docs/, tests/ or benchmarks/. Founder, 2026-08-31: "excluding test
# files is wanted. tidy the test is unecessary and adds compute time for
# nothing." It rests on no implementation fact, so no implementation fix
# retires it.
#
# Declared here because the exclusion was read as an accident and written up as
# a coverage hole — "every arm written to guard the product is itself
# unguarded." The only ground on record for tests/ and benchmarks/ was a
# HAZARD: they import the heavy re-export aggregator BMIs that race clang's
# ASTReader under the parallel fan-out (see cmd_lint's --header-filter note).
# That hazard is real and still holds, but it is CONTINGENT — repair the race
# and it stops arguing for anything, while the law above does not move. What
# re-opening would cost is measured, not estimated: 430 test/bench translation
# units across the eight C++ repos on 2026-08-31 — insight-eidos 143,
# logcraft 101, insight-canon 68, coderoast-server 54, insight-metalog 37,
# coderoast-ipc 13, coderoast-security 13, insight-twin 1.
#
# ENFORCEMENT IS ONE AUTHORING and these four names are it. Three consumers
# derive from them and none restates them: `_malf_prune_args` builds the
# --all-files walk's `find -prune` arguments, `_malf_lint_path_excluded` builds
# the incremental leg's per-path test, and `_malf_lint_header_filter` builds
# cmd_lint's --header-filter alternatives.
#
# The incremental leg used to hard-code the same four spellings as `*/NAME/*`
# globs, and that copy had not merely been AT RISK of drifting — it HAD drifted.
# A leading `*/` demands at least one path component ahead of the name, while
# `git diff --name-only` emits REPO-RELATIVE paths, so an excluded directory
# sitting at a repo ROOT was invisible to it. Measured 2026-08-31, before the
# repair: 41 tracked translation units in exactly that shape (insight-metalog
# tests/ 29, benchmarks/ 5, test_package/ 1 · insight-eidos test_package/ 1 ·
# logcraft technical_docs/ 5) — pruned by --all-files and linted by the default
# leg, off the same list. Component-exact matching is why the predicate splits a
# path instead of globbing it.
#
# A NAME LIST CANNOT SEE A SPELLING IT DOES NOT CARRY, and that blindness is
# silent: the TU is simply linted, which reads as coverage. So the names are
# backed by a name-BLIND detector — `_malf_lint_assert_no_test_tu` fails the run
# on any selected TU carrying a test or benchmark framework dependency. That is
# what makes this list's residue LOUD. It reproduces the one leak the list has
# actually had: insight-canon spelled its benchmark package `bench`, and its 2
# TUs were linted for as long as the list stood. That directory is `benchmarks`
# since 2026-08-31 — all eight C++ repos now spell it alike and the list stays
# four names long.
MALF_LINT_EXCLUDE_EXTRA="${MALF_LINT_EXCLUDE_EXTRA:-test_package technical_docs tests benchmarks}"
# Wall-clock ceiling for ONE clang-tidy translation unit. This is a WEDGE guard, not a
# performance bar, and the two caps above do not cover the state it closes: a clang-tidy that
# SEGFAULTS does not exit — it hangs symbolizing its own stack, indefinitely and while
# allocating almost nothing, so neither the size cap nor the address-space cap ever fires and
# the gate stalls forever on one dead TU. Measured twice on this workspace, on two unrelated
# checks: cppcoreguidelines-owning-memory (2026-07-23) and modernize-use-std-print
# (2026-08-30) — with symbolization suppressed the same crash returns in 0.22 s, so the whole
# cost is the stack walk. The ceiling sits roughly twenty times above the worst legitimate TU
# measured here: run serially on an idle box, insight-eidos/sift/src/engine/diff_engine.cpp
# costs 30.3 s and coderoast-server/server/src/main.cpp 14.7 s (2026-08-30).
MALF_LINT_TU_TIMEOUT_DEFAULT_S=600
MALF_LINT_TU_TIMEOUT_S="${MALF_LINT_TU_TIMEOUT_S:-$MALF_LINT_TU_TIMEOUT_DEFAULT_S}"

# ─── Cache resolution ────────────────────────────────────────────────────────
# Local cache: workspace-shared .conan2 by default so sibling repos reuse the
# same internal and third-party packages. Override with CONAN_HOME when you
# explicitly need an isolated cache.
export CONAN_HOME="${CONAN_HOME:-$MALF_WORKSPACE_ROOT/.conan2}"
# Build-type isolation: CONAN_HOME is the BASE cache. Per-build-type builds get a keyed SUBDIR
# under it (_malf_use_keyed_cache, after the profile is resolved) so a sanitizer build's
# instrumented deps can never be served to a non-instrumented link — even when CI pins
# CONAN_HOME=$WORKSPACE/.conan2 (conan's package_id ignores the sanitizer cflags, so isolation
# must be by cache PATH, not package_id). The base stays the default-release cache.
MALF_CONAN_HOME_BASE="$CONAN_HOME"

# ─── Profile resolution ──────────────────────────────────────────────────────
# 1) CONAN_HOME/profiles/, 2) malf dir, 3) per-repo dir (if in a subdirectory)
_malf_profile_path() {
    # Resolve a conan profile by name to a path in the conan cache (conan create finds
    # profiles there by name). Source of truth, in order: the registry malf/profiles/,
    # a flat malf/ profile, then a per-repo profile. When a source exists we COPY it into
    # the cache EVERY time (overwrite) so a profile EDIT always propagates — the prior
    # "cache wins" shortcut silently served a stale copy after an edit (a real footgun).
    local name="${MALF_PROFILE_NAME:-$MALF_DEFAULT_PROFILE}"
    local cache_p="$CONAN_HOME/profiles/$name"
    local src
    for src in "$MALF_DIR/profiles/$name" "$MALF_DIR/$name"; do
        if [[ -f "$src" ]]; then
            mkdir -p "$CONAN_HOME/profiles"; cp -f "$src" "$cache_p"; echo "$cache_p"; return
        fi
    done
    local repo_p
    while IFS= read -r repo_p; do
        if [[ -f "$repo_p/$name" ]]; then
            mkdir -p "$CONAN_HOME/profiles"; cp -f "$repo_p/$name" "$cache_p"; echo "$cache_p"; return
        fi
    done < <(find "$MALF_WORKSPACE_ROOT" -maxdepth 1 -type d ! -name '.*' ! -path "$MALF_WORKSPACE_ROOT")
    # No in-tree source: fall back to a pre-existing cache profile (e.g. conan-detected).
    [[ -f "$cache_p" ]] && { echo "$cache_p"; return; }
    echo "malf: error: Conan profile '$name' not found in $MALF_DIR/profiles/, $MALF_DIR/, any repo dir, or $CONAN_HOME/profiles/" >&2
    exit 1
}

# Select a build profile by name (the registry: malf/profiles/<name>). Derives the build
# type FROM the profile so the cmake preset matches, and — for a sanitizer profile — points
# the BUILD context at a clean profile so build tools (m4/autoconf/cmake) are never
# instrumented (an ASan/MSan-built m4 breaks libcurl/autotools autoreconf).
# THE BUILD TYPE IS A COORDINATE OF THE PROFILE AND OF NOTHING ELSE — the one reader.
# It is FATAL on a profile declaring no build_type rather than silently leaving the previous
# value standing: an undeclared build type is what let a tree carry a configuration its name
# does not name, and a fallback here is the same defect wearing a default.
_malf_profile_build_type() {
    local bt
    bt="$(sed -nE 's/^[[:space:]]*build_type[[:space:]]*=[[:space:]]*([A-Za-z]+).*/\1/p' "$MALF_PROFILE" | head -n1)"
    if [[ -z "$bt" ]]; then
        echo "malf: error: profile '$MALF_PROFILE_NAME' ($MALF_PROFILE) declares no [settings] build_type." >&2
        echo "       Every malf profile must declare one — the build tree is named for the profile," >&2
        echo "       so a profile with no build type produces a tree nothing can adjudicate." >&2
        exit 1
    fi
    echo "$bt"
}

_malf_apply_profile() {
    MALF_PROFILE_NAME="$1"
    MALF_PROFILE="$(_malf_profile_path)" || exit 1
    MALF_CONFIG="$(_malf_profile_build_type)"
    # Match the actual conf FLAG lines (tools.build:...-fsanitize=...), not a comment that
    # merely mentions -fsanitize (e.g. the libc++ profile's "NOT a sanitizer profile" note).
    if grep -qE '^[[:space:]]*tools\.build:.*-fsanitize=' "$MALF_PROFILE"; then
        MALF_BUILD_PROFILE="$(MALF_PROFILE_NAME="${MALF_CLEAN_BUILD_PROFILE:-linux-gcc16-release}" _malf_profile_path)"
        MALF_IS_SANITIZER=1
    else
        # An EXPLICIT MALF_BUILD_PROFILE wins. Sanitizers are not the only reason the tool
        # context must differ from the host one: a NEW/UNRELEASED host toolchain has to build
        # the whole tool closure too, and a build tool can simply fail under it for reasons
        # that say nothing about the target. Measured 2026-07-22: pkgconf 2.5.1 cannot compile
        # under clang -std=c99 with glibc >= 2.38 — bsdstubs.c redefines strlcpy/strlcat/strndup
        # as static, which glibc now declares — so evaluating a candidate compiler died on a
        # BUILD TOOL before reaching a single line of first-party code. Without this override the
        # only escape was a sanitizer flag the profile must not carry.
        #
        # KEY ON THE CALLER'S EXPORT, NOT ON EMPTINESS. This used to read
        # `${MALF_BUILD_PROFILE:-$MALF_PROFILE}`, which never fired: the top-level default seeding
        # already made the variable non-empty, so `--profile <name>` moved the HOST context and
        # left the BUILD context on the default profile forever. Invisible on x86 (both sides are
        # x86 anyway) and fatal on arm64 — measured 2026-07-27 on the eidos v1.8.4 golden legs,
        # where conan reported `Profile host: arch=armv8` beside `Profile build: arch=x86_64`
        # + `-march=x86-64-v2`, so m4/1.4.19 configured for x86 on an aarch64 runner and died with
        # "C compiler cannot create executables". Both arm64 legs of the 5-leg determinism proof
        # were down. It had been masked for as long as the arm64 conan cache kept a prebuilt m4;
        # the first cache miss exposed it.
        [[ -z "$MALF_BUILD_PROFILE_EXPLICIT" ]] && MALF_BUILD_PROFILE="$MALF_PROFILE"
        MALF_IS_SANITIZER=0
    fi
    # The profile-named editable subdir, for malf's OWN build-dir logic (_malf_editable_build_dir /
    # _malf_build_dir). NOT exported: a recipe's package_info reads this env unconditionally, so a
    # CROSS-REPO CACHED dep (no editable build tree) would prepend a BOGUS build-<key> path that
    # becomes <pkg>_DIR and shadows its packaged lib/cmake config → find_package fails (the release
    # benchmark: editable target + cached cross-repo deps, 2026-07-10). Keeping it un-exported
    # means conan never sees it → recipe LAYOUTS fall back to the profile's user.malf:editable_build_dir
    # conf (same value, every profile carries it) for the editable case, and cached deps get the clean
    # lib/cmake path. Matches the cut-verify `unset MALF_EDITABLE_BUILD_DIR` discipline.
    MALF_EDITABLE_BUILD_DIR="build-$(_malf_build_key)"
}

# ─── Build-type isolation ──────────────────────────────────────────────────────
# CONAN-CACHE isolation key from the active profile. The dev default -> "" so the
# shared base cache (.conan2) is reused; any other profile (gcc-16 ship /
# clang-libstdc++ / sanitizer / msan) -> a distinct key, so its conan packages can
# never collide with the base (an ASan-built libz.a reaching a release link, or a
# libstdc++ .a reaching a libc++ link).
#
# NOTE: this keys the CACHE only. BUILD TREES are named by _malf_build_key below,
# which names EVERY leg — the default included (build-clang21-libcxx-release/) —
# so an unnamed build/ can never be mistaken for "whichever toolchain built last".
_malf_profile_key() {
    # Dev default is clang-21 + libc++ (devXP/tooling + the cross-stdlib determinism diagonal;
    # founder 2026-06-04, the clang→libc++ flip) -> IT is the unkeyed base cache.
    # gcc-16+libstdc++ (ship + the diagonal's reference leg) and clang-21+libstdc++ are explicit
    # + keyed. Conan coexists the stdlibs by package_id (the -stdlib flag folds into it).
    case "${MALF_PROFILE_NAME:-$MALF_DEFAULT_PROFILE}" in
        $MALF_DEFAULT_PROFILE|"") echo "" ;;
        linux-*)                  echo "${MALF_PROFILE_NAME#linux-}" ;;
        *)                        echo "$MALF_PROFILE_NAME" ;;
    esac
}

# BUILD-TREE name key from the active profile: ALWAYS named, default included.
# Every leg builds into build-<key>/ (build-clang21-libcxx-release/,
# build-gcc16-release/, build-clang21-asan/, ...): the tree self-documents its
# toolchain, and the old asymmetry — the default leg squatting on a bare build/
# while the gcc leg was named — is gone.
_malf_build_key() {
    local name="${MALF_PROFILE_NAME:-$MALF_DEFAULT_PROFILE}"
    case "$name" in
        linux-*) echo "${name#linux-}" ;;
        *)       echo "$name" ;;
    esac
}

# The DEFAULT profile's build root under a directory (what .clangd's
# CompilationDatabase points at, whatever profile the CURRENT command runs).
_malf_default_build_root() {
    echo "$1/build-${MALF_DEFAULT_PROFILE#linux-}"
}

# Sync the in-tree conan config (the source of truth) into the active CONAN_HOME, OVERWRITING when
# it differs: global.conf (package_id/download policy) + settings_user.yml (compiler versions newer
# than the installed conan — the from-source gcc legs). The profiles + hooks already re-seed every
# run; these must too — a PERSISTENT conan home (the self-hosted runner) that was seeded once would
# otherwise SHADOW a policy change forever (a `package_id` mode change silently never applied →
# stale-binary ABI skew, 2026-07-10). cmp -s keeps it a no-op when already in sync.
_malf_sync_conan_conf() {
    local conf_file
    for conf_file in global.conf settings_user.yml; do
        [[ -f "$MALF_DIR/$conf_file" ]] || continue
        mkdir -p "$CONAN_HOME"
        if [[ ! -f "$CONAN_HOME/$conf_file" ]] || ! cmp -s "$MALF_DIR/$conf_file" "$CONAN_HOME/$conf_file"; then
            cp "$MALF_DIR/$conf_file" "$CONAN_HOME/$conf_file"
        fi
    done
}

# Every conan home malf owns: the base + each keyed subdir, identified by the settings.yml
# marker MINUS conan's own home-schema entries (p/ profiles/ extensions/ migrations/ — the
# structural children conan creates INSIDE a home; a keyed cache can never take one of these
# names because _malf_profile_key derives keys from profile names). The name exclusion is a
# fact about conan-2's home layout, not a hand-kept denylist. WHY it exists: the bare marker
# was POISONED on 2026-07-22 — a stray conan run with CONAN_HOME pointed at each structural
# dir seeded a full home (settings.yml included) into all four, and from then on editables
# sync + clean stale treated them as caches: 4 phantom 27-entry editable registries, silently
# re-written on every sync. A marker an outside actor can mint needs a schema guard.
_malf_conan_homes() {
    echo "$MALF_CONAN_HOME_BASE"
    local home_dir name
    for home_dir in "$MALF_CONAN_HOME_BASE"/*/; do
        name="$(basename "$home_dir")"
        case "$name" in p|profiles|extensions|migrations) continue ;; esac
        [[ -f "${home_dir}settings.yml" ]] && echo "${home_dir%/}"
    done
}

# Point CONAN_HOME at a build-type-keyed SUBDIR of the base, then re-seed global.conf + hooks +
# re-resolve the profiles into it. No-op for the default profile (key == "") — the load-time base
# seed stands. Call AFTER the profile is resolved (post arg-parse), BEFORE conan install.
_malf_use_keyed_cache() {
    local key; key="$(_malf_profile_key)"
    [[ -z "$key" ]] && return 0
    export CONAN_HOME="$MALF_CONAN_HOME_BASE/$key"
    mkdir -p "$CONAN_HOME/profiles"
    _malf_sync_conan_conf
    # re-resolve the host + clean-build-context profiles INTO the keyed cache (paths live under
    # CONAN_HOME/profiles). This used to save and restore MALF_CONFIG around the call, to protect
    # an explicit --debug/--release from being overwritten by the profile. Those flags are gone
    # and so is the save: the build type is the profile's, and re-applying the SAME profile
    # cannot move it.
    _malf_apply_profile "$MALF_PROFILE_NAME"
}
MALF_PROFILE="$(_malf_profile_path)"
MALF_PROFILE_NAME="$(basename "$MALF_PROFILE")"
# THE DEFAULT PATH READS THE PROFILE TOO, and its absence here is the whole of `N120`. The default
# profile never goes through _malf_apply_profile (nothing names it on the command line), so until
# 2026-09-02 the only writer of MALF_CONFIG on that path was each verb's own hardcoded seed —
# `Debug` in build/test/commands, `Release` in bench/inventory. The dev default
# `linux-clang21-libcxx-release` declares build_type=Release and every one of its 24 build trees
# carried CMAKE_BUILD_TYPE=Debug, under a directory name saying `release`. The cost was not
# cosmetic: the shipped TU coderoast-server/infra/redis/src/redis_session_store.cpp compiled at
# -DSPDLOG_ACTIVE_LEVEL=SPDLOG_LEVEL_TRACE with NO -DNDEBUG (measured from compile_commands.json),
# so every $<CONFIG:Debug> generator expression in the workspace evaluated TRUE under "release" and
# an arm asking "is the compile-time-elided log branch really elided" had nothing to test — which
# is exactly how a real mutation (an elided REDIS_LOG_DEBUG still evaluating its arguments) reddened
# on the gcc16 ship leg and GREENED on the dev default. It bought no compile time either: -O3 comes
# from the profile's own tools.build:cxxflags whatever the build type, so the Debug default was
# -O3 -g with asserts, never a debug build.
MALF_CONFIG="$(_malf_profile_build_type)"
# Seed the default-path value (the default profile never goes through _malf_apply_profile). NOT
# exported — see _malf_apply_profile: conan must not inherit this (cached cross-repo deps' package_info
# would prepend a bogus build-<key> path → find_package fails); recipe layouts use the profile conf.
MALF_EDITABLE_BUILD_DIR="build-$(_malf_build_key)"
# Build-context profile (the tools that DO the building — m4, autoconf, cmake). Defaults
# to the host profile; --asan points it at a NORMAL profile so sanitizer flags never
# instrument build tools (an ASan-built m4 breaks libcurl/autotools autoreconf).
MALF_BUILD_PROFILE="${MALF_BUILD_PROFILE:-$MALF_PROFILE}"
# The profile `--asan` selects (sugar for `--profile $MALF_ASAN_PROFILE`): clang-21 +
# libstdc++ + ASan/UBSan (libFuzzer via the harness target). Requires clang-21 installed.
MALF_ASAN_PROFILE="${MALF_ASAN_PROFILE:-linux-clang21-asan}"

# ─── Conan global.conf ───────────────────────────────────────────────────────
# Sync the local cache's global.conf from the in-tree source of truth (overwrite-if-different).
_malf_sync_conan_conf

# There is deliberately no repo-local conan HOOK installer here. malf carried one until
# 2026-09-03; the only hook that ever used it was ripped from both repos that had it, and
# the installer's unbounded workspace-wide `find` then cost 1.57 s on every invocation to
# copy nothing. Conan creates `extensions/hooks` itself and tolerates its absence, so
# nothing downstream needs the directory. If a third-party recipe ever needs patching
# again, the eleven lines are one `git revert` away — do not re-derive them from scratch.

# ─── Helpers ─────────────────────────────────────────────────────────────────
_malf_pkg_ref() {
    local conanfile="$1"
    python3 -c 'import ast,pathlib,sys
tree=ast.parse(pathlib.Path(sys.argv[1]).read_text())
nodes=list(tree.body)+[n for c in tree.body if isinstance(c,ast.ClassDef) for n in c.body]
get=lambda k:next(n.value.value for n in nodes if isinstance(n,ast.Assign) and any(getattr(t,"id","")==k for t in n.targets))
print(get("name")+"/"+get("version"))' "$conanfile"
}

# All three recipe-graph queries live in malf_graph.py (one AST recipe parser,
# no conan invocation): `deps` = the target's BUILD CLOSURE in dependency order
# (requires AND test_requires followed from every node — mode_deps' docstring
# owns why that is wider than what the target links); `all` = every workspace
# recipe (what `editables sync` re-registers); `members` = every recipe under a
# dir, topo-sorted member-to-member (the no-arg multi-package sweep order).
_malf_workspace_dep_entries() {
    local target="$1"
    python3 "$MALF_DIR/malf_graph.py" deps "$MALF_WORKSPACE_ROOT" "$target"
}

_malf_workspace_packages() {
    python3 "$MALF_DIR/malf_graph.py" all "$MALF_WORKSPACE_ROOT"
}

_malf_member_packages() {
    python3 "$MALF_DIR/malf_graph.py" members "$1"
}

_malf_resolve_dir() {
    # Resolve an optional subdir arg to an absolute directory (no conanfile
    # requirement — the caller decides whether it needs a package or a sweep root).
    local arg="${1:-}"
    if [[ -z "$arg" ]]; then
        echo "$CWD"
    elif [[ -d "$CWD/$arg" ]]; then
        echo "$(cd "$CWD/$arg" && pwd)"
    elif [[ -d "$arg" ]]; then
        echo "$(cd "$arg" && pwd)"
    else
        echo "malf: error: '$arg' is not a directory" >&2; exit 1
    fi
}

_malf_resolve_target() {
    # Given an optional subdir arg, return the absolute path to the dir
    # containing a conanfile.py. Errors if none found.
    local target
    target="$(_malf_resolve_dir "${1:-}")" || exit 1
    if [[ ! -f "$target/conanfile.py" ]]; then
        echo "malf: error: no conanfile.py found in $target" >&2; exit 1
    fi
    echo "$target"
}

# Resolve the verb's target — ONE package (sets MALF_TARGET, returns) or a
# dependency-ordered SWEEP over every package under the resolved dir (runs
# `malf <verb> <member> <flags…>` per member — the exact `&&`-chain semantics,
# each member a fresh process so no profile/cache/config state bleeds — and
# exits with the sweep's status).
#
# THE RULE IS INVOCATION-POINT INDEPENDENCE: `malf <verb> <dir>` is exactly
# `cd <dir> && malf <verb>`. The path spelling never changes the meaning.
#   * any resolved dir -> sweep every recipe under it, topo-ordered (a root-dir
#     recipe is a member too); a single found recipe degenerates to the plain
#     single-package build, so a leaf subfolder behaves as it always did.
#   * `--only` -> build exactly the recipe AT the resolved dir and nothing below.
#
# UNTIL 2026-09-04 AN EXPLICIT ARG NAMING A PACKAGE DIR MEANT "THAT PACKAGE ONLY",
# and that is the bug this replaced. It made the two spellings of one intent
# disagree wherever a repo has a root recipe AND sub-recipes — `insight-eidos`
# (5 recipes) and `coderoast-ipc` (4). `malf build insight-eidos` built ONE
# package; `cd insight-eidos && malf build` built five. The comment here used to
# claim the two "behave identically", which was true for every OTHER repo and
# false for exactly those two.
#
# It fails SILENTLY and that is what makes it worth a rule rather than a note:
# the short build exits 0, so the operator reads a green over a surface that was
# never compiled. Measured 2026-09-04 during the `N135` suite rename — the renamed
# gtest suites were verified by `ctest -N`, which reported the OLD names as still
# live because `malf build insight-eidos` had left `insight-eidos/sift` at the
# previous day's binary. The rename looked incomplete; it was the build that was.
#
# Rebuilding one package of a multi-package repo is still a real need — eidos's
# root recipe is a three-module compile target, not an umbrella — so the
# capability survives as `--only`, where it is a stated intent instead of an
# accident of how the path was typed.
_malf_resolve_target_or_sweep() {
    local verb="$1" arg="$2"; shift 2
    local root
    root="$(_malf_resolve_dir "$arg")" || exit 1
    if [[ -n "${MALF_ONLY:-}" ]]; then
        if [[ ! -f "$root/conanfile.py" ]]; then
            echo "malf: error: --only needs a recipe AT $root; there is no conanfile.py there." >&2
            exit 1
        fi
        MALF_TARGET="$root"; return 0
    fi
    local members=() entry ref dir
    while IFS=$'\t' read -r ref dir; do
        [[ -n "$ref" && -n "$dir" ]] && members+=("$dir")
    done < <(_malf_member_packages "$root")
    if [[ ${#members[@]} -eq 0 ]]; then
        if [[ -f "$root/conanfile.py" ]]; then
            # A recipe malf_graph could not parse a ref from — let the single-target
            # path surface the real error rather than claiming "no conanfile".
            MALF_TARGET="$root"; return 0
        fi
        echo "malf: error: no conanfile.py found in (or under) $root" >&2; exit 1
    fi
    if [[ ${#members[@]} -eq 1 ]]; then
        MALF_TARGET="${members[0]}"; return 0
    fi
    echo "=== malf $verb: ${#members[@]} packages under $root (dependency order) ==="
    local i=0 member label
    for member in "${members[@]}"; do
        i=$((i+1))
        label="${member#"$root"/}"; [[ "$member" == "$root" ]] && label="."
        echo "── malf $verb [$i/${#members[@]}] $label ──"
        # MALF_ONLY=1 IS LOAD-BEARING AND ITS ABSENCE DOES NOT FAIL, IT RUNS AWAY. A member may BE
        # the root — that is the whole shape this sweep exists for, a repo carrying a root recipe
        # plus sub-recipes (`insight-eidos`, `coderoast-ipc`) — and without it the child re-enters
        # this same resolver, re-derives this same member list, and sweeps again. Measured
        # 2026-09-04: `malf build insight-eidos` reached 717 nested processes with ZERO compilers
        # running. The root need not be FIRST in dependency order for this — only present:
        # `insight-eidos` puts it at member 2 of 5 (behind `insight_llm`) and `coderoast-ipc` at
        # member 1 of 4, so the second runs away before compiling anything at all. It presents as a
        # SLOW BUILD, which is the worst possible face: nothing errors, nothing is logged, the
        # machine looks busy, and the one visible symptom — no compiler in `ps` — is the symptom
        # nobody checks while a build is "still going".
        #
        # MALF_SWEEP does NOT prevent this and must not be made to: it answers "am I a member?"
        # for the inventory (run once per repo, never per member), which is a different question
        # from "may I sweep?". Conflating them would hide the recursion guard inside a flag whose
        # name is about something else.
        if ! MALF_SWEEP=1 MALF_ONLY=1 "$MALF_DIR/malf" "$verb" "$member" "$@"; then
            echo "malf $verb: sweep FAILED at $label ($((i-1))/${#members[@]} completed)" >&2
            exit 1
        fi
    done
    echo "=== malf $verb: all ${#members[@]} packages done ==="
    if [[ "$verb" == "build" || "$verb" == "test" ]]; then
        _malf_run_inventory "$root" || exit 1
    fi
    exit 0
}

# ── ADR-3.D9: the build system's INVENTORY ──────────────────────────────────────
# A CMake project that no package build ever configures is a build-system defect: `malf test`
# reports green while a translation unit in the repo does not compile, and the first thing that
# compiles it is the TAG. Measured 2026-08-08 — malf test 714/714, cut-verify 18/18, every gate
# green, then all five golden legs red on a three-argument call against a four-argument signature.
#
# So this runs in the DAILY loop, not at the cut: a false green repaired at the last gate is still
# a false green for the fourteen days before it. `malf build`/`malf test` fire it once per repo —
# once, never per sweep member (MALF_SWEEP marks a member), and never for a lone package build,
# where the caller asked about one package and gets what they asked for.
#
# Cost is why this is affordable daily: the inventory cell uses a PERSISTENT profile-keyed tree,
# so a no-change run is ~0.6s per repo. The determinism scripts' mktemp clean room is right for a
# DIGEST and wrong for a compile check.
_malf_repo_root_of() {
    local dir="$1"
    while [[ "$dir" != "/" && -n "$dir" ]]; do
        [[ -e "$dir/.git" ]] && { echo "$dir"; return 0; }
        dir="$(dirname "$dir")"
    done
    return 1
}

_malf_run_inventory() {
    local root="$1"
    [[ -n "${MALF_SWEEP:-}" ]] && return 0            # a sweep member — the root runs it once
    [[ -n "${MALF_SKIP_INVENTORY:-}" ]] && return 0   # the mutation arms drive the tool directly
    local repo; repo="$(_malf_repo_root_of "$root")" || return 0
    python3 "$MALF_DIR/build_inventory.py" lint --workspace "$MALF_WORKSPACE_ROOT" || return 1
    python3 "$MALF_DIR/build_inventory.py" build \
        --workspace "$MALF_WORKSPACE_ROOT" --repo "$repo" \
        --build-key "$(_malf_build_key)" --profile "$MALF_PROFILE_NAME" \
        --build-type "$MALF_CONFIG" || return 1

    # FOLD THE INVENTORY CELLS' DATABASES INTO THE REPO ROOT, exactly as a package build folds its
    # own. An inventory cell configures into `<dir>/build-inventory-$(_malf_build_key)/` and emits a
    # compile_commands.json there like any other CMake tree, but nothing merged it — so its sources
    # were walked by `malf lint` and then found absent from the root database. Measured on
    # insight-canon 2026-08-30: the root DB held 172 entries and ZERO for `proof/`, so
    # `proof/det_proof.cpp` reported as an uncovered TU. That was invisible while an uncovered TU
    # was only a note; now that --all-files treats it as the coverage hole it is, leaving this
    # unmerged would make the gate unpassable on any repo carrying an inventory cell.
    #
    # The remedy is to GAIN the coverage, not to exclude the file. Adding `proof` to
    # MALF_LINT_EXCLUDE_EXTRA would have silenced the same red by spending the coverage it reports,
    # which is the trade this whole command refuses to make.
    local _inv_root; _inv_root="$repo/build-$(_malf_build_key)"
    if [[ -f "$_inv_root/compile_commands.json" ]]; then
        local _inv_db
        while IFS= read -r _inv_db; do
            [[ -n "$_inv_db" ]] || continue
            _malf_merge_db_tree "$_inv_root" "$(dirname "$_inv_db")"
        done < <(find "$repo" -type d -name "build-inventory-$(_malf_build_key)" \
                     -exec test -f '{}/compile_commands.json' \; -print 2>/dev/null \
                 | sed 's|$|/compile_commands.json|')
    fi
}

_malf_build_dir() {
    # <pkg>/build-<key> — anchored at the PACKAGE, never the invocation CWD, and
    # ALWAYS profile-named (the default leg included), so an ASan tree never
    # clobbers the release one and a bare build/ can never masquerade as
    # "whichever toolchain built last". This is the SAME tree
    # _malf_editable_build_dir resolves (MALF_EDITABLE_BUILD_DIR == build-<key>):
    # one build tree per (package, profile), whether the package is built as the
    # target, as a sibling's editable dep, or from inside its own subfolder —
    # the root fix for the old "cd into a subdir -> second, inconsistent build
    # tree that links a stale dependency" footgun.
    echo "$1/build-$(_malf_build_key)"
}

_malf_preset() {
    case "${MALF_CONFIG:-Release}" in
        Debug)   echo "conan-debug" ;;
        Release) echo "conan-release" ;;
        *) echo "malf: error: unknown config ${MALF_CONFIG}" >&2; exit 1 ;;
    esac
}

# Workspace lockfile args. The lockfile lives in the MALF repo, not the superproject —
# CI checks out CodeRoasted/malf-toolchain into malf/ (see insight-eidos golden.yaml /
# release.yaml) and never checks out the superproject, so malf/ is the only tree that
# reaches BOTH the desk and every CI leg. Same reasoning that puts global.conf + profiles
# here. Absent file => no args, so a checkout without it still builds.
#
# WHY: third-party recipes require by RANGE (clickhouse-cpp -> lz4/[>=1.9.4 <2],
# libcurl -> openssl/[>=3 <4], zlib/[>=1.2.11 <2]) and conan resolves a range against the
# MUTABLE LOCAL CACHE unless --update. So the same recipe resolves differently depending on
# cache state: measured 2026-07-21, coderoast_infra_clickhouse standalone took lz4/1.10.0
# while coderoast_server — which LINKS it — took lz4/1.9.4. The openssl twin of that split
# failed loudly (version conflict, server offline); the lz4 one is silent. The lockfile makes
# the resolved graph a committed fact instead of a function of when you built.
#
# --lockfile-partial is deliberate for the DESK: the lockfile then PINS what it knows and
# lets a genuinely new dependency resolve, so adding a require does not brick every build
# until someone refreshes (that is how a lockfile gets disabled in practice). It means the
# desk lockfile pins rather than GATES. Set MALF_LOCKFILE_STRICT=1 (CI / release legs) to
# drop --lockfile-partial, turning "a dependency entered unlocked" into a hard red where a
# red is cheap and attributable.
_malf_lockfile_args() {
    [[ -f "$MALF_DIR/conan.lock" ]] || return 0
    echo "--lockfile=$MALF_DIR/conan.lock"
    [[ -n "${MALF_LOCKFILE_STRICT:-}" ]] || echo "--lockfile-partial"
}

_malf_conan_install_args() {
    local build_type="${MALF_CONFIG:-Release}"
    # shellcheck disable=SC2046
    echo "--build=missing" \
         "--profile:host=$MALF_PROFILE" \
         "--profile:build=$MALF_BUILD_PROFILE" \
         "-s" "build_type=$build_type" \
         $(_malf_lockfile_args)
}

_malf_editable_add() {
    local pkg_dir="$1"
    local pkg_ref name version
    pkg_ref="$(_malf_pkg_ref "$pkg_dir/conanfile.py")"
    # Extract name and version from ref (name/version)
    name="${pkg_ref%/*}"
    version="${pkg_ref#*/}"
    # Evict any STALE-version editable for this package before (re-)registering the
    # current one. The registry (editable_packages.json) is keyed by name/version, and
    # `conan editable add` REFUSES a version that mismatches the recipe (so a bump can't
    # add the new ref atop the old) — but conan never revalidates EXISTING entries, so a
    # coordinated bump (e.g. 1.5.3 -> 1.6.2) leaves the old ref orphaned at the same
    # path. The registry then carries BOTH refs, and a consumer still resolving the old
    # pin mid-bump silently builds from the stale editable. Removing every other-version
    # ref for this name first makes the per-build refresh self-healing across bumps — the
    # normal "bump then build the consumer" cycle needs no manual `editables sync`.
    # Idempotent: re-adding the current ref over itself is a no-op; the loop skips it.
    local existing
    while IFS= read -r existing; do
        [[ -n "$existing" && "$existing" != "$pkg_ref" ]] || continue
        conan editable remove --refs "$existing" >/dev/null 2>&1 || true
    done < <(conan editable list 2>/dev/null | grep -E "^${name}/")
    # Register this package as an editable pointing to its source directory
    conan editable add "$pkg_dir" --name="$name" --version="$version" -of "$pkg_dir"
}

_malf_editables_clear() {
    # Remove all editables by deleting the Conan editables config file
    # (Conan doesn't support removing all editables via command line)
    rm -f "$CONAN_HOME/editable_packages.json"
}

_malf_editable_build_dir() {
    # Build-type-keyed (2026-06-04 editable-isolation pass): editables build into <pkg>/build[-<key>],
    # MATCHING the recipe layout `cpp.build.libdirs = [os.environ.get("MALF_EDITABLE_BUILD_DIR","build")]`
    # (exported by _malf_apply_profile). So a keyed-profile consumer (gcc-16 / clang-21-libc++ / asan)
    # links the dep's OWN keyed build — no cross-stdlib/-compiler ABI mismatch. (The clang-21/libc++ leg
    # surfaced the old bug: a libc++ TU linking a libstdc++ editable .a — `__1` vs `__cxx11` mangling.)
    # ALWAYS profile-named now (default -> <pkg>/build-clang21-libcxx-release); a raw
    # `conan create --profile X` (env unset) reads the same name from the profile's
    # user.malf:editable_build_dir conf; the recipes' bare-"build" fallback is the
    # no-profile-conf last resort only. This is the "reviewed conanfile-layout pass".
    local pkg_dir="$1"
    echo "$pkg_dir/${MALF_EDITABLE_BUILD_DIR:-build}"
}

_malf_cmake_feature_args() {
    local target="$1"
    local tests="$2"
    local benches="$3"
    local cmakelists="$target/CMakeLists.txt"
    [[ -f "$cmakelists" ]] || return 0
    python3 - "$cmakelists" "$tests" "$benches" <<'PY'
import pathlib
import re
import sys

text = pathlib.Path(sys.argv[1]).read_text()
tests = sys.argv[2]
benches = sys.argv[3]
for name in re.findall(r"option\s*\(\s*([A-Za-z_][A-Za-z0-9_]*)", text):
    if "BUILD_TESTS" in name:
        print(f"-D{name}={tests}")
    elif "BUILD_BENCH" in name:
        print(f"-D{name}={benches}")
PY
}

_malf_dependency_cmake_args() {
    _malf_cmake_feature_args "$1" OFF OFF
}

# ── Concurrent-run safety: two malf runs may not build ONE tree at the same time ──
#
# Two malf runs started from DIFFERENT repo roots resolve the SAME conan editables, so both run
# ninja in the SAME build directory and write the same module BMIs. ninja takes no lock and neither
# did malf, so the loser reads a half-written BMI. Measured 2026-07-22: `malf test` in
# insight-eidos alongside `malf test` in coderoast-server share **seven** editable trees, and the
# overlap produced a clang ICE in `ASTReader::FindExternalVisibleDeclsByName` and
# `malformed or corrupted precompiled file: can't skip to bit N from M`. That is two terminals in
# two repos — the normal case, not an exotic one — and it fails as SILENT CORRUPTION rather than a
# clean error, which is why it must be enforced here instead of by a "don't do that" convention.
#
# Scope is the BUILD DIRECTORY, not the package: runs touching disjoint trees still proceed fully
# in parallel, and only the genuine overlap serializes.
#
# LOCKS ARE NEVER NESTED, and that is what makes deadlock impossible: `_malf_build_flow` lets
# `_malf_bootstrap_workspace_deps` finish first (each dep locks and releases inside
# `_malf_build_editable_package`) and only then takes its own target lock. **Do not hoist a lock
# around the bootstrap** — two runs whose dependency orders differ would then deadlock.
#
# RESIDUAL, stated rather than hidden: the lock keys on the build dir, so two runs of the same
# package under DIFFERENT profiles do not serialize. They write different trees, but they share
# `CMakeUserPresets.json` in the source dir (backup/rewrite/restore, inside the lock here so the
# same-profile case is covered). That window is unmeasured and narrower than the one being closed;
# widening the key to the package dir would serialize legitimate multi-profile work and would put a
# lock file in a git-tracked source dir.
_malf_with_build_lock() {
    local build_dir="$1"; shift
    local rc=0
    # Opt-out + graceful degradation: an environment with no flock still builds, just unserialized.
    if [[ "${MALF_BUILD_LOCK:-1}" == "0" ]] || ! command -v flock >/dev/null 2>&1; then
        "$@" || rc=$?
        return $rc
    fi
    local lock_fd
    # The lock file lives INSIDE the tree it guards: the directory path IS the identity, and a lock
    # kept elsewhere can be cleaned out from under a held lock (new inode -> no exclusion at all).
    # If the build dir is gone the resource is gone too, so co-locating cannot lose. Every real
    # build dir is already gitignored (build*/), so this adds no untracked-file noise.
    local lock_file="$build_dir/.malf-build.lock"
    # Probe writability with a SIMPLE command, never `exec {fd}>file 2>/dev/null`. A redirection-only
    # `exec` applies its redirections to THE SHELL, so a trailing 2>/dev/null there does not guard the
    # open — it silences stderr for the entire rest of the run, swallowing every compiler diagnostic
    # that follows. Measured while building this: all stderr after the lock vanished, errors included.
    if ! : > "$lock_file" 2>/dev/null; then
        echo "malf: warning: cannot create $lock_file — building unserialized" >&2
        "$@" || rc=$?
        return $rc
    fi
    exec {lock_fd}>"$lock_file"
    if ! flock -n "$lock_fd"; then
        echo "malf: another malf run is building $build_dir — waiting for it (MALF_BUILD_LOCK=0 opts out)" >&2
        # Blocking, with no timeout, ON PURPOSE: serializing is the whole point, a legitimate build
        # can run 20+ minutes, and the never-nested rule above means this cannot deadlock.
        flock "$lock_fd" || echo "malf: warning: could not lock $build_dir — proceeding unserialized" >&2
    fi
    "$@" || rc=$?
    # Release here rather than at process exit, so a sweep holds each tree only for its own build.
    exec {lock_fd}>&-
    return $rc
}

_malf_build_editable_package() {
    local pkg_dir="$1"
    local build_dir pkg_ref
    pkg_ref="$(_malf_pkg_ref "$pkg_dir/conanfile.py")"
    # Content-only packages (a conanfile but no CMakeLists.txt — e.g. a scenario/data corpus that
    # ships files via cpp_info.resdirs) are NOT CMake projects. Consumers read them straight from the
    # editable layout, so there is nothing to configure or build. Skip the CMake build for them.
    if [[ ! -f "$pkg_dir/CMakeLists.txt" ]]; then
        echo "malf: editable $pkg_ref is content-only (no CMakeLists.txt) — nothing to build"
        return 0
    fi
    build_dir="$(_malf_editable_build_dir "$pkg_dir")"
    mkdir -p "$build_dir"

    echo "malf: building editable $pkg_ref in $build_dir"

    _malf_with_build_lock "$build_dir" _malf_build_editable_package_locked "$pkg_dir" "$build_dir"
}

# The guarded half of the editable build. Split out so the whole conan-install + configure + build
# + presets backup/restore sequence sits inside ONE lock hold, rather than the build alone: the
# presets rewrite targets the shared source dir and must not interleave either.
_malf_build_editable_package_locked() {
    local pkg_dir="$1"
    local build_dir="$2"
    local user_presets_backup

    user_presets_backup="$(_malf_backup_user_presets "$pkg_dir")"

    # shellcheck disable=SC2046
    if ! conan install "$pkg_dir" \
        --output-folder="$build_dir" \
        $(_malf_conan_install_args); then
        _malf_restore_user_presets "$pkg_dir" "$user_presets_backup"
        return 1
    fi

    _malf_write_user_presets "$pkg_dir" "$build_dir"

    local cmake_args=()
    mapfile -t cmake_args < <(_malf_dependency_cmake_args "$pkg_dir")
    if ! _malf_configure_and_build "$pkg_dir" "$build_dir" "${cmake_args[@]}"; then
        _malf_restore_user_presets "$pkg_dir" "$user_presets_backup"
        return 1
    fi

    _malf_restore_user_presets "$pkg_dir" "$user_presets_backup"
}

# ONE list drives BOTH loops below, and it is the BUILD closure — every member this run
# will configure — never the narrower link closure. malf configures each dependency as the
# TOP-LEVEL project of its own `cmake --preset`, so that dependency's PROJECT_IS_TOP_LEVEL
# is true and its own test_requires become resolution requirements of THIS run even though
# conan's `test` trait never propagates them to the target. Emitting what the target links
# left one such package unregistered, and `malf build insight-twin/core` died inside
# `conan install logcraft/core` naming a package the target's recipe never mentions. There
# is deliberately no knob to narrow this: _malf_build_flow compiles the FULL target surface
# (package + tests + benches) and so does every editable dep it configures, so a caller that
# wanted less would be asking for a build that cannot link.
_malf_bootstrap_workspace_deps() {
    local target="$1"

    if [[ "$MALF_AUTO_WORKSPACE_DEPS" == "0" ]]; then
        return 0
    fi

    local entries=()
    mapfile -t entries < <(_malf_workspace_dep_entries "$target")
    if [[ ${#entries[@]} -eq 0 ]]; then
        return 0
    fi

    local entry ref dep_dir

    echo "malf: registering local workspace dependencies as editables from $MALF_WORKSPACE_ROOT"
    for entry in "${entries[@]}"; do
        IFS=$'\t' read -r ref dep_dir <<< "$entry"
        [[ -n "$ref" && -n "$dep_dir" ]] || continue
        _malf_editable_add "$dep_dir"
    done

    for entry in "${entries[@]}"; do
        IFS=$'\t' read -r ref dep_dir <<< "$entry"
        [[ -n "$ref" && -n "$dep_dir" ]] || continue
        _malf_build_editable_package "$dep_dir"
    done
}

_malf_write_user_presets() {
    local target="$1"
    local build_dir="$2"
    local rel_build
    rel_build="$(realpath --relative-to="$target" "$build_dir" 2>/dev/null || echo "build")"
    cat > "$target/CMakeUserPresets.json" <<JSON
{
    "version": 4,
    "vendor": {
        "conan": {}
    },
    "include": [
        "$rel_build/CMakePresets.json"
    ]
}
JSON
}

_malf_backup_user_presets() {
    local target="$1"
    local user_presets="$target/CMakeUserPresets.json"
    if [[ -f "$user_presets" ]]; then
        local backup
        backup="$(mktemp -t CMakeUserPresets.XXXXXX.json)"
        cp "$user_presets" "$backup"
        echo "$backup"
        return
    fi
    echo ""
}

_malf_restore_user_presets() {
    local target="$1"
    local backup="${2:-}"
    local user_presets="$target/CMakeUserPresets.json"
    if [[ -n "$backup" && -f "$backup" ]]; then
        cp "$backup" "$user_presets"
        rm -f "$backup"
    else
        rm -f "$user_presets"
    fi
}

# Build parallelism. Sanitizer builds (ASan/UBSan/MSan) are FAR heavier in the clang frontend:
# import-std module instantiation under instrumentation drives deep frontend recursion AND ~3 GB/TU.
# Under full -j$(nproc) on a memory-tight box this OOM-thrashes AND starves the frontend's stack →
# the intermittent "stack exhaustion" frontend ICE on the heaviest module TU (insight-eidos's
# metalog_pyramid.cpp, which imports the big metalog compose/diff module forest). So for a sanitizer
# build ONLY, cap parallelism by available memory (the determinism-gate precedent, ~3 GB/job).
# Non-sanitizer builds keep full -j (byte-identical behaviour to before).
_malf_build_jobs() {
    local ncpu; ncpu="$(nproc 2>/dev/null || echo 2)"
    [[ "${MALF_IS_SANITIZER:-0}" == "1" ]] || { echo "$ncpu"; return; }
    local mem_gb; mem_gb="$(awk '/MemAvailable/{print int($2/1024/1024)}' /proc/meminfo 2>/dev/null || echo 4)"
    local jobs=$(( mem_gb / 3 )); (( jobs < 1 )) && jobs=1; (( jobs > ncpu )) && jobs=$ncpu
    echo "$jobs"
}

# THE TREE'S CONFIGURATION IS CHECKED AGAINST THE PROFILE IT IS NAMED FOR (`N120`).
#
# WHY A CHECK AT ALL, when the build type is now derived from the profile in one place: because
# that derivation is a claim about malf's own variables, and the thing every reader trusts is the
# DIRECTORY NAME. This reads the two ends instead — the profile FILE on disk, and the CMakeCache
# the configure just produced — so it is two independent artifacts, not malf agreeing with itself.
# It is what makes the binding provable rather than argued, and it is why the mislabel cannot come
# back silently: any future path that forces a build type reds here, on the first configure.
#
# IT RUNS BEFORE `cmake --build`, deliberately. A mismatch is not a result to report at the end of
# a compile that took minutes and produced the wrong configuration; the build is the expensive part
# and it is exactly what must not happen.
#
# IT CANNOT GO VACUOUS ON A MISSING CACHE: a configure that emitted no CMakeCache.txt has already
# failed and `set -e` has already carried that failure out of this function, so reaching this point
# with no cache is impossible rather than tolerated — and it is asserted, not assumed.
_malf_assert_tree_matches_profile() {
    local build_dir="$1"
    local cache="$build_dir/CMakeCache.txt"
    if [[ ! -f "$cache" ]]; then
        echo "malf: FATAL: $build_dir has no CMakeCache.txt after a successful configure." >&2
        exit 1
    fi
    local declared cached
    declared="$(_malf_profile_build_type)"
    cached="$(sed -nE 's/^CMAKE_BUILD_TYPE:[A-Za-z]+=(.*)$/\1/p' "$cache" | head -n1)"
    [[ "$cached" == "$declared" ]] && return 0
    echo "malf: FATAL: build-type drift — $build_dir is configured" >&2
    echo "       CMAKE_BUILD_TYPE=${cached:-<empty>}, but the profile it is NAMED for" >&2
    echo "       ($MALF_PROFILE_NAME) declares build_type=$declared." >&2
    echo "       A tree whose configuration is not the one its name announces makes every green" >&2
    echo "       taken in it a claim about a leg nobody ran. Delete the tree and rebuild:" >&2
    echo "         rm -rf $build_dir" >&2
    exit 1
}

_malf_configure_and_build() {
    local target="$1"
    local build_dir="$2"
    shift 2
    local preset
    preset="$(_malf_preset)"
    cmake --preset "$preset" -S "$target" -B "$build_dir" \
        -DCMAKE_EXPORT_COMPILE_COMMANDS=ON \
        "$@"
    _malf_assert_tree_matches_profile "$build_dir"
    local jobs; jobs="$(_malf_build_jobs)"
    if [[ "${MALF_IS_SANITIZER:-0}" == "1" ]]; then
        # The companion to the -j cap: give the clang frontend stack headroom for the deep
        # import-std module instantiation under instrumentation (the named "stack exhaustion"
        # mechanism). The soft rlimit is inherited by ninja's child compiler processes; raising
        # it is best-effort (a lower hard cap is fine — the -j cap still relieves the pressure).
        ulimit -s 131072 2>/dev/null || true   # 128 MB frontend stack (default ~8 MB)
        echo "malf: sanitizer build — -j$jobs (mem-aware) + 128MB compiler stack (frontend-ICE guard)" >&2
    fi
    cmake --build "$build_dir" -j"$jobs"
}

_malf_repo_root() {
    # The repo root a package belongs to (where .clangd + the merged compile DB
    # live): the package's git toplevel — invocation-CWD-independent, so a
    # subfolder build feeds the same editor DB a repo-root build does. Falls
    # back to the package dir itself outside any git checkout.
    git -C "$1" rev-parse --show-toplevel 2>/dev/null || echo "$1"
}

_malf_merge_compile_commands() {
    # Fold the just-built package's compile_commands.json into its REPO-level root DB,
    # keyed by the ACTIVE profile — `<repo>/build-$(_malf_build_key)/`. This keeps the
    # editor's index in step with the incremental build WITHOUT the full `malf commands`
    # workspace walk: one file merge, no reconfigure. Entries are keyed by source file —
    # the freshly built package's entries replace any stale entry for the same file, while
    # entries contributed by *other* packages already in the root DB are preserved
    # (multi-package repos).
    #
    # KEYED BY THE ACTIVE PROFILE, not by MALF_DEFAULT_PROFILE, and that was a real defect
    # rather than a preference. This function used to write EVERY profile's entries to the
    # DEFAULT leg's root — a constant path — keyed per source file, last writer wins. So
    # `malf build --profile linux-gcc16-release` merged g++ commands into a directory named
    # build-clang21-libcxx-release, and the file went MIXED rather than merely wrong:
    # measured on insight-canon before this change, 169 g++ entries against 3 clang++-21.
    #
    # Three things independently say that is wrong, and all three predate it:
    #   - _malf_build_dir exists precisely so "a bare build/ can never masquerade as
    #     whichever toolchain built last" — this function bypassed the key and recreated
    #     exactly that defect under a clang-shaped name;
    #   - config/.clangd states the requirement outright: the DB "must come from the CLANG
    #     preset ... clangd can't consume gcc's -fmodule-mapper/-fmodules-ts commands nor
    #     .gcm CMIs from the ship-gcc tree";
    #   - `malf commands` (cmd_compile_commands) ALREADY writes per-profile via
    #     _malf_build_dir. Two writers of one file disagreed, and the incremental one was
    #     the one that was wrong.
    #
    # NOTHING AN EDITOR POINTS AT MOVES. _malf_build_key of the default profile IS
    # `clang21-libcxx-release`, so for a default build this resolves to the same
    # `<repo>/build-clang21-libcxx-release/compile_commands.json` that .clangd names
    # statically. The only change is that a NON-default build now writes its own leg's root
    # instead of overwriting that one — also strictly more useful, since each leg gets a
    # usable DB. Build roots are gitignored (`**/build*/`), so no new tracked file appears.
    #
    # The `malf lint` guard that refuses a foreign database STAYS. It closes this cause, not
    # every cause, and removing a detector because one source was fixed is how the next one
    # ships silently.
    local build_dir="$1" target="$2"
    local root_db="$(_malf_repo_root "$target")/build-$(_malf_build_key)/compile_commands.json"
    local pkg_db="$build_dir/compile_commands.json"
    # Building the repo root itself: cmake already wrote the root DB in place.
    [[ "$(realpath -m "$pkg_db")" == "$(realpath -m "$root_db")" ]] && return 0
    [[ -f "$pkg_db" ]] || return 0
    python3 - "$pkg_db" "$root_db" <<'PY'
import json, sys
from pathlib import Path

pkg_db = Path(sys.argv[1])
root_db = Path(sys.argv[2])

try:
    pkg_entries = json.loads(pkg_db.read_text())
except Exception as exc:  # malformed/partial DB: leave the root untouched
    raise SystemExit(f"malf: skipping compile_commands merge ({pkg_db}: {exc})")

root_entries = []
if root_db.exists():
    try:
        root_entries = json.loads(root_db.read_text())
    except Exception:
        root_entries = []  # stale/corrupt root DB is rebuilt from this package

# Files just rebuilt take precedence: drop their prior root entries, then append.
rebuilt = {e.get("file") for e in pkg_entries}
merged = [e for e in root_entries if e.get("file") not in rebuilt]
merged.extend(pkg_entries)

root_db.parent.mkdir(parents=True, exist_ok=True)
root_db.write_text(json.dumps(merged, indent=2) + "\n")
print(f"malf: refreshed {root_db} "
      f"({len(merged)} entries, {len(pkg_entries)} from this build)")
PY
}

# ─── Commands ────────────────────────────────────────────────────────────────

# The ONE compile flow all three verbs share: conan install + configure + build
# with the FULL target surface ON — package + tests + benches ("malf build
# compiles everything"). The verbs differ only in what they RUN afterwards
# (test -> ctest, bench -> the bench executables), never in what they compile —
# so a TU that only a test or bench pulls in can no longer slip past the desk
# and first fail in the release pipeline (the 1.7.2 drift-at-tag class).
# Content-only packages (a conanfile but no CMakeLists.txt — umbrella
# metapackages, scenario/data corpora) have nothing to compile: return 0 with
# a note, and the caller skips its run phase too.
_malf_build_flow() {
    local target="$1"
    if [[ ! -f "$target/CMakeLists.txt" ]]; then
        echo "malf: $(_malf_pkg_ref "$target/conanfile.py") is content-only (no CMakeLists.txt) — nothing to compile"
        return 0
    fi
    local build_dir
    build_dir="$(_malf_build_dir "$target")"
    mkdir -p "$build_dir"

    # DELIBERATELY OUTSIDE the target lock below. Each dependency takes and releases its own
    # build-dir lock inside _malf_build_editable_package, so no run ever holds two locks at once —
    # the property that makes the scheme deadlock-free. Hoisting the lock to cover this call would
    # break it the moment two runs disagreed on dependency order.
    _malf_bootstrap_workspace_deps "$target"

    _malf_with_build_lock "$build_dir" _malf_build_flow_locked "$target" "$build_dir"
}

# The guarded half of the target build — see _malf_with_build_lock for why this is serialized.
_malf_build_flow_locked() {
    local target="$1"
    local build_dir="$2"
    local user_presets_backup rc=0
    user_presets_backup="$(_malf_backup_user_presets "$target")"
    # Conan writes CMakeUserPresets.json to the source dir with multiple includes,
    # causing "Duplicate preset" errors. Rewrite it to include only the local build dir.
    # shellcheck disable=SC2046
    if conan install "$target" \
        --output-folder="$build_dir" \
        $(_malf_conan_install_args); then
        _malf_write_user_presets "$target" "$build_dir"
        local cmake_args=()
        mapfile -t cmake_args < <(_malf_cmake_feature_args "$target" ON ON)
        _malf_configure_and_build "$target" "$build_dir" "${cmake_args[@]}" || rc=1
    else
        rc=1
    fi
    if [[ $rc -ne 0 ]]; then
        _malf_restore_user_presets "$target" "$user_presets_backup"
        return 1
    fi
    [[ -n "$user_presets_backup" ]] && rm -f "$user_presets_backup"
    _malf_merge_compile_commands "$build_dir" "$target"
}

cmd_build() {
    local subdir="" fwd=()
    # NO BUILD-TYPE SEED AND NO --debug/--release. MALF_CONFIG is already the active profile's
    # declared build_type (seeded at load, re-derived by _malf_apply_profile). A verb that seeded
    # it, or a flag that moved it, put a configuration into a tree named for a profile that
    # declares a different one — and the tree name is the only thing anyone reads (`N120`).
    while [[ $# -gt 0 ]]; do
        case "$1" in
            # Select any registry profile (malf/profiles/<name>): build type + clean
            # build-context for sanitizers are derived from the profile.
            --profile) fwd+=("$1" "$2"); shift; _malf_apply_profile "$1" ;;
            # Sugar: ASan/UBSan(+libFuzzer-via-target) gate profile (canon→eidos parse path).
            --asan)    _malf_apply_profile "$MALF_ASAN_PROFILE"; fwd+=("$1") ;;
            # Build exactly the recipe at the resolved dir, never the recipes below it.
            # Not forwarded: a sweep cannot occur under it, so a member never sees it.
            --only)    MALF_ONLY=1 ;;
            -*) _malf_refuse_option build "$1" ;;
            *) subdir="$1" ;;
        esac
        shift
    done

    _malf_resolve_target_or_sweep build "$subdir" "${fwd[@]}"
    local target="$MALF_TARGET"

    _malf_use_keyed_cache

    echo "=== malf build: $target ($MALF_CONFIG${MALF_PROFILE_NAME:+, $MALF_PROFILE_NAME}) ==="
    _malf_build_flow "$target"
    echo "=== done: $(_malf_build_dir "$target") ==="
    _malf_run_inventory "$target"
}

cmd_test() {
    local subdir="" fwd=()
    local gtest_filter=""
    local verbose=false
    local corpus_only=false
    # No build-type seed and no --debug/--release — see cmd_build.
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --profile) fwd+=("$1" "$2"); shift; _malf_apply_profile "$1" ;;
            --asan)    _malf_apply_profile "$MALF_ASAN_PROFILE"; fwd+=("$1") ;;
            --verbose) verbose=true; fwd+=("$1") ;;
            # Run ONLY the ctest `corpus` label — the heavy gates that need a private
            # third-party corpus mounted. Forwarded, because a sweep member must make the
            # same choice; a member that quietly ran the default set would report a green
            # for a population the caller did not ask for.
            --corpus)  corpus_only=true; fwd+=("$1") ;;
            --filter)
                shift
                [[ $# -gt 0 ]] || { echo "malf test: --filter requires a pattern" >&2; exit 1; }
                gtest_filter="$1"; fwd+=(--filter "$1")
                ;;
            # Build exactly the recipe at the resolved dir, never the recipes below it.
            # Not forwarded: a sweep cannot occur under it, so a member never sees it.
            --only)    MALF_ONLY=1 ;;
            -*) _malf_refuse_option test "$1" ;;
            *) subdir="$1" ;;
        esac
        shift
    done

    _malf_resolve_target_or_sweep test "$subdir" "${fwd[@]}"
    local target="$MALF_TARGET"

    _malf_use_keyed_cache

    # THE insight-e2e RELEASE OVERRIDE IS GONE, and it was the second half of `N120` rather than a
    # convenience. It existed because `malf test` seeded Debug: an e2e package whose in-test drain
    # watchdog times out under a slow build had to be rescued per package. The rescue wrote Release
    # into a tree named for whatever profile was active — so under the dev default one package
    # carried Release while its 23 siblings carried Debug, and under linux-clang21-asan (build_type
    # Debug) `malf test insight-e2e` still produced a Release tree named `build-clang21-asan`.
    # A per-package divergence cannot be reasoned about at all without opening the cache, which is
    # strictly worse than a uniform mislabel. With the build type taken from the profile the reason
    # for the override is gone: the dev default IS Release. A profile that declares Debug is a
    # deliberate choice by whoever named it on the command line, and silently building one package
    # some other way is not malf's call to make.
    echo "=== malf test: $target ($MALF_CONFIG) ==="

    _malf_build_flow "$target"

    if [[ ! -f "$target/CMakeLists.txt" ]]; then
        return 0   # content-only: nothing to run either
    fi
    local ctest_args=(--test-dir "$(_malf_build_dir "$target")" --output-on-failure)
    $verbose && ctest_args+=(--verbose)
    [[ -n "$gtest_filter" ]] && ctest_args+=(-R "$gtest_filter")
    # THE TWO POPULATIONS ARE NEVER RUN TOGETHER (Founder, 2026-09-04: "I also dont want to mix
    # up big corpus tests/gates with regular self sustaining tests"). A test carrying the ctest
    # label `corpus` needs a PRIVATE third-party corpus mounted through an environment variable;
    # it can be neither built nor reasoned about from a checkout alone. Mixed into the default
    # run they did the one thing a test must never do — report a PASS for a subject never
    # reached — because a gtest skip exits 0 and ctest counts a skipping case as passed.
    #
    # So the default run EXCLUDES the label, and `--corpus` runs that label and nothing else.
    # The two are complementary, not overlapping: every registered test belongs to exactly one
    # of them, which is what makes "the suite is green" a statement with one meaning.
    # Inside the corpus population a missing mount is a HARD FAILURE rather than a skip — you
    # asked for it by name, so its absence is a broken invocation and not a quiet no-op.
    if $corpus_only; then
        ctest_args+=(-L corpus)
    else
        ctest_args+=(-LE corpus)
    fi
    ctest "${ctest_args[@]}"
    _malf_run_inventory "$target"
}

# Did this clang-tidy invocation DIE, rather than report? A dead run checked nothing at all,
# which is a different fact from "checked and found nothing" and from "checked and found
# something" — and it is the fact a lint gate has no vocabulary for by default.
# Two independent tells, because neither alone covers the class: a status at or above 124
# (timeout exits 124; a signal death exits 128+N), and the LLVM crash banner, which is emitted
# even where a wrapper normalises the status to something innocent. EXPORTED because the
# fan-out children are separate `bash -c` processes: one definition, reachable from both the
# parent and the self-test, instead of a predicate that exists only inside a quoted string.
_malf_tidy_crashed() {
    local rc="$1" out="$2"
    if (( rc >= 124 )); then return 0; fi
    if [[ "$out" == *"PLEASE submit a bug report"* ]]; then return 0; fi
    return 1
}

# THE RUN'S OWN SCOPE, STATED — printed at every exit that reached a file set.
# A LINT GATE'S GREEN IS SILENT ABOUT WHAT IT LOOKED AT, and that silence is the defect this
# closes. With no arguments `lint`'s subject is `git diff` against HEAD, so on a CLEAN worktree it
# printed "no files to check" and returned 0 having read zero bytes of source. Measured 2026-09-02
# in coderoast-ipc and insight-twin: both exited 0 on an empty set and the real verdict needed
# --all-files. The failure is in the READER, not the tool — "malf lint, 0 findings" is the same
# sentence whether 0 files or 400 were checked, so a report of the first is indistinguishable from
# the second and nothing in the output separates them. Three counts do separate them, and they are
# three because each answers a different question: `selected` is the population the MODE produced,
# `checked` is what actually reached clang-tidy after the module-lintability and compile-DB filters
# dropped the rest (selected > checked is a coverage gap the mode's own subject did not cover), and
# the findings/not-linted pair is the verdict. The mode is named because it is the fact that was
# invisible. The zero-file line is deliberately not phrased as a pass: it is the whole reason for
# the rule (Founder, 2026-09-03).
_malf_lint_summary() {
    local mode="$1" dir="$2" selected="$3" checked="$4" findings="$5" not_linted="$6" rc="$7"
    if (( checked == 0 )); then
        echo "malf lint: SUMMARY · mode=$mode · dir=$dir · selected $selected, CHECKED 0 — NOTHING WAS INSPECTED · rc=$rc"
        echo "malf lint: this run read no source, so it is NOT a clean verdict. 'malf lint --all-files' checks the tree."
        return 0
    fi
    echo "malf lint: SUMMARY · mode=$mode · dir=$dir · selected $selected, checked $checked, $findings finding(s), $not_linted not linted · rc=$rc"
}

cmd_lint() {
    local console=false all_files=false
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -c|--console)   console=true ;;
            --all-files)    all_files=true ;;
            *) _malf_refuse_option lint "$1" ;;
        esac
        shift
    done

    # The file-selection mode, spelled out rather than named, because the summary below is read by
    # someone who does not have this file open: "default" alone does not say that the subject is a
    # diff and therefore empty on a clean tree, which is the fact that went unstated.
    local lint_mode
    if $all_files; then
        lint_mode="--all-files (walk of source extensions under the tree)"
    else
        lint_mode="default (git diff --name-only HEAD, worktree+index, --relative)"
    fi

    # clang-tidy config: prefer CWD, fall back to the canonical config in this repo (config/)
    local tidy_config=""
    if [[ -f "$CWD/.clang-tidy" ]]; then
        tidy_config="$CWD/.clang-tidy"
    elif [[ -f "$MALF_DIR/config/.clang-tidy" ]]; then
        tidy_config="$MALF_DIR/config/.clang-tidy"
    fi

    # compile_commands.json: THE PROFILE-KEYED BUILD ROOT WINS, and a bare $CWD copy is only a
    # fallback. The order used to be the other way round, and it cost two months of silent
    # zero-coverage: insight-eidos/llm/compile_commands.json was a gcc-produced, gitignored file
    # from 2026-06-26 sitting beside the recipe, so `malf lint` in that directory read IT instead
    # of llm/build-clang21-libcxx-release/, and insight_llm went unlinted from then until
    # 2026-08-30 without one line of output saying so.
    #
    # The asymmetry that settles the order is PROVENANCE, not freshness: `malf` never writes a bare
    # $CWD/compile_commands.json. `_malf_merge_compile_commands` and `_malf_merge_db_tree` both
    # write `<dir>/build-$(_malf_build_key)/compile_commands.json` — keyed by the ACTIVE profile,
    # which is what makes the toolchain claim checkable at all. So a file at $CWD is by
    # construction something else: an editor symlink, a hand copy, or the residue of a tool that
    # has since moved on. Preferring an artifact of unknown provenance over the one this program
    # maintains has no reading under which it is right.
    #
    # The toolchain guard below does NOT subsume this. It catches a FOREIGN-compiler database —
    # which is what saved the eidos case from being wrong rather than merely absent — but a stale
    # CLANG database passes it while covering a subset of the tree, and a subset silently linted is
    # the failure mode this whole command is built to refuse.
    local comp_db="" comp_db_shadowed=""
    local _build_root; _build_root="$(_malf_default_build_root "$CWD")"
    if [[ -f "$_build_root/compile_commands.json" ]]; then
        comp_db="$_build_root"
        # Both exist: use the authoritative one and NAME the other. Silence here is what let the
        # eidos file survive two months — nothing ever printed its path.
        [[ -f "$CWD/compile_commands.json" ]] && comp_db_shadowed="$CWD/compile_commands.json"
    elif [[ -f "$CWD/compile_commands.json" ]]; then
        comp_db="$CWD"
        echo "malf lint: note: no database at $_build_root; falling back to $CWD/compile_commands.json," >&2
        echo "malf lint: which malf does not write and cannot key to a profile. If it is stale or partial" >&2
        echo "malf lint: this run covers less than it appears to. 'malf commands' rebuilds the keyed one." >&2
    fi
    if [[ -n "$comp_db_shadowed" ]]; then
        echo "malf lint: note: using $comp_db/compile_commands.json (profile-keyed, malf-maintained)." >&2
        echo "malf lint: ignoring $comp_db_shadowed — malf never writes that path; delete it if nothing needs it." >&2
    fi

    # No compile DB is not a "may miss context" warning — it is a total loss of context, and
    # it fails LOUDLY as noise rather than quietly as a gap. clang-tidy with no `-p` runs
    # "without flags": no -std=c++23, no -isystem dep headers, no module BMIs. Measured on a
    # clean insight-twin clone (2026-07-28): 39 clang-diagnostic-error, starting with
    # `error: unknown type name 'module'` on `export module insight.twin;`. Every one is a
    # phantom, and clang-tidy exits 1 — a gate wired this way can never PASS, whatever the
    # source says, which is the worst way for a gate to be wrong. So: refuse, and name the
    # remedy. This is the guard that makes `lint` safe to wire into CI at all.
    if [[ -z "$comp_db" ]]; then
        echo "malf lint: error: no compile_commands.json at $CWD or $(_malf_default_build_root "$CWD")." >&2
        echo "malf lint: refusing to run — with no compile database clang-tidy parses every TU without" >&2
        echo "malf lint: flags and reports phantom clang-diagnostic-errors it cannot be right about." >&2
        echo "malf lint: build the package ('malf build') or index it ('malf commands') first." >&2
        exit 1
    fi

    # ── ...and the database's TOOLCHAIN must be clang's, for the SAME reason. ──────────
    # The guard above refuses an ABSENT database because clang-tidy without flags reports
    # phantoms it cannot be right about. A WRONG-toolchain database is strictly WORSE than an
    # absent one, and that asymmetry is the whole argument: absent REFUSES, so there are no
    # findings to believe; wrong PRODUCES findings, and they are well-formed. Measured by
    # Hephaistos 2026-08-26 — a gcc-profile database against a clean file gave 10 findings,
    # zero after re-indexing the same file against clang, and FOUR of the ten named a real
    # rule id, at a real line, on a real symbol ("variable `render_value` is non-const and
    # globally accessible" — on a function). That is a false positive wearing the
    # instrument's own vocabulary, which is the shape a reader ACTS on.
    #
    # WHY REFUSE RATHER THAN WARN: a wrong-toolchain database can never be the INTENDED input
    # here. cmd_lint deliberately derives clang-tidy from the same install as the build clang
    # so module BMIs match; a gcc database carries no clang BMIs and gcc-only flags, so there
    # is no reading of it under which the findings mean what they say. A warning on an output
    # that is specific and wrong is a warning nobody re-reads.
    #
    # WHY ANY ENTRY AND NOT THE FIRST: a wrong database goes MIXED, not merely wrong, and the
    # path name still says clang, so a first-entry probe passes on it. Measured on insight-canon
    # the day this guard landed: build-clang21-libcxx-release/compile_commands.json held 169 g++
    # entries and 3 clang++-21.
    #
    # THAT MEASUREMENT'S CAUSE IS CLOSED, and the census probe is not. _malf_merge_compile_commands
    # used to fold every build into the DEFAULT leg's build root — a CONSTANT path derived from
    # MALF_DEFAULT_PROFILE — keyed per source file, last writer wins, so a gcc build overwrote
    # clang entries in place. `a181d1c` keys that root by _malf_build_key (the ACTIVE profile), so
    # a non-default leg now writes its own root and no longer contaminates the clang one; the same
    # commit landed the day this guard did. Two subjects remain, which is why the detector stays:
    # build trees written BEFORE a181d1c still hold a mixed file at that path until they are
    # re-indexed, and the NEXT cause — a hand-run cmake, an IDE, a future change to the merge —
    # would be silent if the detector were removed because one source was fixed.
    #
    # An UNREADABLE database refuses too: it must not print the same thing as a clean one.
    local db_verdict
    db_verdict="$(python3 - "$comp_db/compile_commands.json" <<'PY'
import collections, json, os, sys
try:
    entries = json.load(open(sys.argv[1], encoding="utf-8"))
except Exception as exc:
    print(f"UNREADABLE\t{exc}")
    raise SystemExit(0)
counts = collections.Counter()
for entry in entries:
    cmd = entry.get("command") or " ".join(entry.get("arguments", []))
    if cmd.strip():
        counts[os.path.basename(cmd.split()[0])] += 1
census = ", ".join(f"{name} x{n}" for name, n in counts.most_common())
alien = sorted(n for n in counts if "clang" not in n)
print(("ALIEN" if alien else "OK") + "\t" + (census or "no compiler field in any entry"))
PY
)"
    if [[ "${db_verdict%%$'\t'*}" != "OK" ]]; then
        if [[ "${db_verdict%%$'\t'*}" == "UNREADABLE" ]]; then
            echo "malf lint: error: the compile database at $comp_db could not be read." >&2
            echo "malf lint: parse error: ${db_verdict#*$'\t'}" >&2
        else
            echo "malf lint: error: the compile database at $comp_db was not produced by clang." >&2
            echo "malf lint: entries by compiler: ${db_verdict#*$'\t'}" >&2
        fi
        echo "malf lint: refusing to run — clang-tidy reading a foreign database emits findings that are" >&2
        echo "malf lint: WELL-FORMED and WRONG (real rule ids, real lines, real symbols), which is worse" >&2
        echo "malf lint: than the no-database case because there is something plausible to believe." >&2
        echo "malf lint: re-index against the default clang leg: 'malf commands', or build it with" >&2
        echo "malf lint: 'malf build' (no --profile). Note a tree built BEFORE malf-toolchain a181d1c" >&2
        echo "malf lint: holds a MIXED file at this path (every profile merged into one database) and" >&2
        echo "malf lint: keeps it until re-indexed; since a181d1c each profile writes its own root." >&2
        exit 1
    fi

    # ── A FIRST-PARTY HEADER IS NOT A SYSTEM HEADER, AND THE BUILD SAYS IT IS ─────────
    # Every dependency reaches a consumer as a CMake IMPORTED target, and CMake's default for an
    # IMPORTED target is that its INTERFACE_INCLUDE_DIRECTORIES are SYSTEM directories. So the
    # generator emits `-isystem` for our own editable packages exactly as it does for a conan
    # cache package, and clang-tidy — which suppresses every diagnostic whose location is in a
    # system header — cannot see our own headers. `--header-filter` does not reach this: the
    # filter chooses among diagnostics that were EMITTED, and a system-header diagnostic is never
    # emitted at all.
    #
    # MEASURED 2026-09-02 AT SUPERPROJECT fbf385c, BOTH DIRECTIONS, ON coderoast-server: an
    # explicit `throw 1;` outside the guard in `server-logging/include/coderoast/log_seat/
    # log_seat.hpp`'s `flush_logger` (a `noexcept` frame) is SILENT through
    # `server/src/app/trantor_bridge.cpp` — rc 0, no output; the identical `throw 1;` in a
    # `noexcept` lambda in that same `.cpp` fires `bugprone-exception-escape`, rc 1. Same check,
    # same config, same filter: only which side of `-isystem` the frame sits on differs.
    #
    # THE DAMAGE IS NOT THE MISSING DIAGNOSTICS, IT IS THE SENTENCES LEFT BEHIND THEM. That seat
    # header asserted "the body is total, so `bugprone-exception-escape` stays ARMED on this
    # frame" — a true-sounding guarantee about a check that could not see the frame.
    #
    # WHY THIS SEAT. The first-party/third-party distinction exists in three places and only one
    # of them is total and derivable:
    #   * the PRODUCING package's CMake (`EXPORT_NO_SYSTEM` on the exported target) cannot reach
    #     `coderoast_server_logging` or `coderoast_server_catalogs` AT ALL — they are conan
    #     header-libraries with no CMakeLists, whose imported target is written by CMakeDeps. The
    #     header this finding started from is one of theirs.
    #   * the CONSUMER's CMake needs a hand-written list of first-party target names, and a
    #     hand-written census can only be wrong silently.
    #   * here, the distinction is a FACT ON THE PATH: an include directory inside
    #     MALF_WORKSPACE_ROOT and inside no conan home IS a first-party editable. Both halves are
    #     already computed by this program; neither is a list anyone maintains.
    # Blast radius settles it. Flipping SYSTEM off in the BUILD would change the flags of every TU
    # in every repo on both toolchains — a build-policy question (do our own headers face
    # -Wall -Wextra in their consumers?) that is the Founder's, not something a lint repair rides
    # in on. This rewrite is read at lint time, written into this run's own scratch directory, and
    # destroyed with it: nothing that ships changes.
    #
    # THIRD-PARTY STAYS `-isystem`, and that is asserted rather than intended — the scan below
    # counts third-party `-isystem` references before and after and refuses if the two differ.
    # `--system-headers` was measured as the alternative and is WEAKER, not simpler: it
    # un-suppresses everything and leans on `--header-filter`, which keys on a diagnostic's own
    # location — so a diagnostic raised inside a THIRD-PARTY macro (spdlog's `SPDLOG_FUNCTION`
    # expanding `__FUNCTION__` inside a first-party lambda) lands on a first-party line and walks
    # straight through it. Same tree, same probe, 2026-09-02: `--system-headers` produced that
    # finding, this rewrite did not, and both armed the seat header.
    #
    # A ZERO IS A LEGITIMATE ANSWER AND IS NAMED. coderoast-ipc and coderoast-security have no
    # first-party editable include root at all, so their count is 0 and must pass — but a run that
    # rewrote nothing must not read like a run that failed to look, which is why the line prints
    # either way. A DERIVATION FAILURE REFUSES: falling back to the original database would
    # restore exactly the blindness this step exists to remove, and report a clean tree it never
    # inspected.
    _malf_lint_open_scratch
    local lint_db="$_MALF_LINT_SCRATCH/db"
    mkdir -p "$lint_db"
    local -a _lint_conan_homes=()
    mapfile -t _lint_conan_homes < <(_malf_conan_homes)
    local desystem_report
    if ! desystem_report="$(python3 - "$comp_db/compile_commands.json" "$lint_db/compile_commands.json" \
            "$MALF_WORKSPACE_ROOT" "${_lint_conan_homes[@]}" <<'PY'
import json, os, re, sys

src, dst, workspace = sys.argv[1], sys.argv[2], sys.argv[3]
caches = [os.path.realpath(p) for p in sys.argv[4:] if p]
workspace = os.path.realpath(workspace)


def under(path, parent):
    return path == parent or path.startswith(parent + os.sep)


def first_party(raw):
    # isdir() is load-bearing twice: it keeps a stale entry naming a directory that no longer
    # exists out of the rewrite, and it is what makes a path CONTAINING A SPACE safe — the
    # command-string form tokenises on whitespace, so such a path comes back truncated, and a
    # truncated path is not a directory.
    if not os.path.isdir(raw):
        return False
    real = os.path.realpath(raw)
    return under(real, workspace) and not any(under(real, cache) for cache in caches)


def tokens_of(entry):
    args = entry.get("arguments")
    return list(args) if args is not None else re.findall(r"\S+", entry.get("command", ""))


def scan(entries):
    """(first-party, third-party) -isystem references, over the same tokenisation the rewrite uses."""
    fp = tp = 0
    for entry in entries:
        toks = tokens_of(entry)
        i = 0
        while i < len(toks):
            tok, path, step = toks[i], None, 1
            if tok == "-isystem" and i + 1 < len(toks):
                path, step = toks[i + 1], 2
            elif tok.startswith("-isystem") and len(tok) > len("-isystem"):
                path = tok[len("-isystem"):]
            if path is not None:
                if first_party(path):
                    fp += 1
                else:
                    tp += 1
                i += step
                continue
            i += 1
    return fp, tp


try:
    entries = json.load(open(src, encoding="utf-8"))
except Exception as exc:
    print(f"{src}: {exc}", file=sys.stderr)
    raise SystemExit(1)

before_fp, before_tp = scan(entries)
files_before = [e.get("file") for e in entries]
roots = {}


def rewrite_command(cmd):
    def one(match):
        path = match.group(1)
        if first_party(path):
            roots[path] = roots.get(path, 0) + 1
            return "-I" + path
        return match.group(0)

    return re.sub(r"-isystem\s+(\S+)", one, cmd)


def rewrite_arguments(args):
    out, i = [], 0
    while i < len(args):
        tok, path, step = args[i], None, 1
        if tok == "-isystem" and i + 1 < len(args):
            path, step = args[i + 1], 2
        elif tok.startswith("-isystem") and len(tok) > len("-isystem"):
            path = tok[len("-isystem"):]
        if path is not None and first_party(path):
            roots[path] = roots.get(path, 0) + 1
            out.append("-I" + path)
            i += step
            continue
        out.append(tok)
        i += 1
    return out


for entry in entries:
    if "command" in entry:
        entry["command"] = rewrite_command(entry["command"])
    if "arguments" in entry:
        entry["arguments"] = rewrite_arguments(entry["arguments"])

after_fp, after_tp = scan(entries)
rewritten = sum(roots.values())
problems = []
if after_fp != 0:
    problems.append(f"{after_fp} first-party -isystem reference(s) survived the rewrite")
if after_tp != before_tp:
    problems.append(f"third-party -isystem count moved {before_tp} -> {after_tp}")
if rewritten != before_fp:
    problems.append(f"rewrote {rewritten} of {before_fp} first-party reference(s)")
if [e.get("file") for e in entries] != files_before:
    problems.append("the entry list changed shape")
if problems:
    print("; ".join(problems), file=sys.stderr)
    raise SystemExit(1)

try:
    with open(dst, "w", encoding="utf-8") as handle:
        json.dump(entries, handle)
except Exception as exc:
    print(f"{dst}: {exc}", file=sys.stderr)
    raise SystemExit(1)

# "left as system headers" counts every -isystem reference this run did NOT touch: the
# third-party ones, and any path that no longer resolves to a directory. Both are correct to
# leave alone and neither is first-party, so they are one number rather than two.
if rewritten == 0:
    print(f"no first-party include root reaches this database as -isystem; "
          f"{before_tp} reference(s) left as system headers.")
else:
    named = ", ".join(f"{path} (x{count})" for path, count in sorted(roots.items()))
    print(f"first-party headers de-systemed: {rewritten} include reference(s) over "
          f"{len(roots)} root(s); {before_tp} reference(s) left as system headers. "
          f"Roots: {named}")
PY
    )"; then
        echo "malf lint: error: could not derive this run's compile database from $comp_db." >&2
        echo "malf lint: refusing to run — the derivation turns the -isystem entries naming our own" >&2
        echo "malf lint: editable packages into -I, without which clang-tidy treats every first-party" >&2
        echo "malf lint: header as system code and reports nothing about it. Falling back to the" >&2
        echo "malf lint: original database would restore that blindness and green a tree it never" >&2
        echo "malf lint: inspected. Re-index with 'malf commands' if the database is the problem." >&2
        exit 1
    fi
    echo "malf lint: $desystem_report" >&2

    local output_file=""
    if ! $console; then
        output_file="$CWD/lint_output.txt"
        > "$output_file"
    fi

    # Use the clang-tidy from the SAME install as the build compiler (clang-21).
    # A C++ module BMI (.pcm) is pinned to the exact clang BUILD that produced it, so a
    # clang-tidy from a different install — e.g. a 21.1.0 release in /usr/local vs the
    # apt.llvm.org 21.1.8 snapshot in /usr/lib/llvm-21 — can't read it, and every TU
    # that imports a module errors out. Deriving clang-tidy from clang-21's resolved
    # path keeps them in lockstep (and the resource-dir below consistent). Fall back to
    # PATH if that install ships no clang-tidy, and say so.
    local clang_bin clang_tidy_bin="" install_tidy="" tidy_matches_build=false
    clang_bin="$(command -v clang-21 || command -v clang || true)"
    if [[ -n "$clang_bin" ]]; then
        install_tidy="$(dirname "$(readlink -f "$clang_bin")")/clang-tidy"
        # Same install as the build clang → its clang-tidy can read this build's
        # module BMIs (.pcm), so C++ module files become lintable (see the filter below).
        [[ -x "$install_tidy" ]] && { clang_tidy_bin="$install_tidy"; tidy_matches_build=true; }
    fi
    if [[ -z "$clang_tidy_bin" ]]; then
        clang_tidy_bin="$(command -v clang-tidy-21 || command -v clang-tidy || true)"
        [[ -n "$install_tidy" && -n "$clang_tidy_bin" ]] && \
            echo "malf lint: note: $install_tidy missing; using $clang_tidy_bin (a different clang build — module BMIs won't match it). 'sudo apt install clang-tidy-21' from the same source as clang-21 to align." >&2
    fi
