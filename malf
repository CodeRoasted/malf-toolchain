    else
        # The SAME exclusion the --all-files walk prunes with, applied per path because this leg
        # has no tree to prune — derived from the one list, never restated. See LSRC-1.
        #
        # THE PATHS ARE RESOLVED BY GIT, NOT BY THIS SCRIPT. `git diff --name-only` emits paths
        # relative to the REPO ROOT whatever `-C` says, and this leg used to prepend $CWD to them:
        # from a package subdirectory every path failed the existence test, the set came out empty,
        # and the run exited 0 as "no files to check" — a could-not-look wearing the exit status of
        # found-nothing. Measured by Kleio 2026-09-02 on insight-canon/core with one changed TU:
        # 0 files from the subdirectory, 1 from the repo root. `--relative` makes git emit paths
        # relative to $CWD AND scope the listing to $CWD's subtree — which is this run's whole
        # subject anyway, since the compile DB and the header filter are both $CWD-keyed — and at a
        # repo root it is a no-op. `--diff-filter=d` drops deletions, so every listed path MUST
        # exist on disk, and one that does not is a resolution failure this leg REFUSES on rather
        # than skips. Git's own failure (outside a checkout, an unborn HEAD) is a status, not an
        # empty list: it used to be swallowed by `2>/dev/null || true`, the same false zero one
        # layer down. Pinned by tests/test_malf.sh [7j2].
        local _leg _listing _listing_rc
        local -a _diff_args
        for _leg in worktree index; do
            _diff_args=(diff --relative --name-only --diff-filter=d)
            if [[ "$_leg" == index ]]; then _diff_args+=(--cached); else _diff_args+=(HEAD); fi
            _listing_rc=0
            _listing="$(git -C "$CWD" "${_diff_args[@]}" 2>&1)" || _listing_rc=$?
            if (( _listing_rc != 0 )); then
                echo "malf lint: error: could not list the changed files — 'git -C $CWD ${_diff_args[*]}' exited $_listing_rc:" >&2
                sed 's/^/malf lint:   /' <<< "$_listing" >&2
                echo "malf lint: refusing to report success — an empty set reached through a failed listing is" >&2
                echo "malf lint: not a clean tree. Run from inside a git checkout with at least one commit." >&2
                exit 1
            fi
            while IFS= read -r f; do
                [[ -n "$f" ]] || continue
                [[ "$f" =~ \.(cpp|cc|cxx|h|hpp|cppm)$ ]] || continue
                if [[ ! -f "$CWD/$f" ]]; then
                    echo "malf lint: error: git lists '$f' as changed (in the $_leg) but no such file resolves under $CWD." >&2
                    echo "malf lint: the listing and this directory disagree — refusing rather than passing over a file" >&2
                    echo "malf lint: that was never looked at. A deletion cannot be it: deletions are filtered out, so" >&2
                    echo "malf lint: this is a path staged and then removed, or a broken resolution of git's paths." >&2
                    exit 1
                fi
                _malf_lint_path_excluded "$f" || files+=("$CWD/$f")
            done <<< "$_listing"
        done
        # dedupe — GUARDED, and the guard is the whole point. `printf '%s\n'` applies its format
        # once even with NO arguments, so on an EMPTY array this pipeline emits one blank line and
        # mapfile turns "no changed files" into a one-element array holding "". That element then
        # reaches the DB filter below, where `${_db_files[$_rf]}` with an empty subscript is a hard
        # `bad array subscript` — so `malf lint` with no arguments died on any repo with a CLEAN
        # worktree, which is the common case, in every repo at once.
        if [[ ${#files[@]} -gt 0 ]]; then
            mapfile -t files < <(printf '%s\n' "${files[@]}" | sort -u)
        fi
    fi

    # THE POPULATION THE MODE PRODUCED, frozen here — before the module-lintability filter and the
    # compile-DB filter below narrow it. Both of those DROP files silently by design (a .cppm under
    # a mismatched clang-tidy, a TU absent from the database), so the count that reaches clang-tidy
    # is not the count the mode selected, and reporting only the second hides the gap between them.
    local lint_selected=${#files[@]}

    # C++ module files are lintable ONLY when clang-tidy is the same build as the
    # project's compiler: a module BMI (.pcm) is pinned to the exact clang build, so a
    # mismatched clang-tidy errors out ("module file '…' built from a different
    # branch") on every module INTERFACE unit (.cppm) and every TU that `import`s a
    # named module (the module-import tests, plus 1.5.1 production imports like
    # coderoast-server's `import coderoast.*`). When clang-tidy MATCHES the build
    # (derived from clang-21's own install above) we lint them; otherwise we skip them
    # (they still compile in the build + run as module-import tests) and rely on the
    # note printed above to align the toolchain.
    if ! $tidy_matches_build; then
        local lintable=()
        local _f
        for _f in "${files[@]}"; do
            [[ "$_f" == *.cppm ]] && continue
            grep -qE '^[[:space:]]*(export[[:space:]]+)?import[[:space:]]+[A-Za-z_]' "$_f" 2>/dev/null && continue
            lintable+=("$_f")
        done
        files=("${lintable[@]}")
    fi

    # DB-completeness + valid-directory filter. clang-tidy replays each file's command from the
    # compile DB and chdir's into the entry's `directory` first. TWO failure modes this closes:
    #   * a file ABSENT from the DB gets clang-tidy's flag-less fallback, which on a module TU cannot
    #     find `import std`, the third-party -isystem headers (glaze/curl), or the BMIs — a FLOOD of
    #     clang-diagnostic-error that mimics real findings (measured 2026-07-23: an incremental-build
    #     DB held 0 sift-cli entries -> 293 phantom errors, gone once `malf commands` rebuilt the DB);
    #   * a file whose entry's `directory` is a MISSING build dir (sub-package not built in this
    #     profile) makes clang-tidy abort with `LLVM ERROR: Cannot chdir` and hang symbolizing.
    # _malf_db_lintable_files handles both: it lists only entries with an existing directory, so a
    # file that is absent OR has a dead directory falls through to the report below. Either way the
    # file is unlintable and the fix is the same (build/index its package) — no silent coverage gap.
    # Skipped only when we HAVE a DB; with none, clang-tidy's own context note already fired above.
    if [[ -n "$comp_db" && -f "$comp_db/compile_commands.json" ]]; then
        local -A _db_files=()
        local _dbf
        while IFS= read -r _dbf; do [[ -n "$_dbf" ]] && _db_files["$_dbf"]=1; done < <(
            _malf_db_lintable_files "$comp_db/compile_commands.json")
        if [[ ${#_db_files[@]} -gt 0 ]]; then
            local -a _in_db=() _missing_tu=()
            local _rf
            for _f in "${files[@]}"; do
                _rf="$(realpath -e "$_f" 2>/dev/null || echo "$_f")"
                _malf_lint_db_verdict "$_rf" "$_f" "${_db_files[$_rf]:-}"
                case "$_MALF_LINT_VERDICT" in
                    in-db)   _in_db+=("$_f") ;;
                    header)  : ;;
                    missing) _missing_tu+=("$_f") ;;
                esac
            done
            if [[ ${#_missing_tu[@]} -gt 0 ]]; then
                echo "malf lint: ${#_missing_tu[@]} of $(( ${#_in_db[@]} + ${#_missing_tu[@]} )) translation unit(s) have no usable compile command (absent from the DB, or their build dir is missing):" >&2
                printf '  %s\n' "${_missing_tu[@]#"$CWD"/}" >&2
                # AND UNDER --all-files THAT IS FATAL, not a note. The two modes promise different
                # things and only one of them can absorb this. The default set is `git diff`, so an
                # unbuildable TU there is incidental — you are mid-edit and the file simply has not
                # been compiled yet. `--all-files` promises the TREE; a TU in the walk that no
                # compile command covers is a hole in exactly the subject the mode named, which is
                # the same species as the crashed-TU hole below and gets the same verdict.
                #
                # IT IS ALSO THE ONLY THING STANDING BETWEEN THIS GATE AND A BUILD-ORDER-DEPENDENT
                # GREEN. The repo-root database is an ACCUMULATION: `malf build <pkg>` merges that
                # package's entries into `<repo>/build-<key>/`, additively, while only
                # `malf commands` clears and rebuilds it whole. So after a partial build the root DB
                # describes whichever packages happened to be built last, and a tree walk against it
                # lints that subset and exits 0. Measured on insight-eidos 2026-08-30 with NO source
                # change: the root DB held 34 distinct files while the sub-package databases held 83,
                # 80 of them absent from the root — a 70% coverage hole that reported success. A gate
                # whose coverage depends on build order is a gate whose green means something
                # different every run, and nothing in the output distinguished the two.
                if $all_files; then
                    lint_status=1
                    echo "malf lint: refusing to report success — --all-files walks the TREE, so these are a" >&2
                    echo "malf lint: coverage hole in the subject this mode named, not files you chose to skip." >&2
                    echo "malf lint: the root database is built up by 'malf build <pkg>' one package at a time," >&2
                    echo "malf lint: so a partial build leaves a partial subject. Rebuild it whole: 'malf commands'" >&2
                    echo "malf lint: (or 'malf build' with no argument, which sweeps every package here)." >&2
                fi
            fi
            files=("${_in_db[@]}")
        fi
    fi

    if [[ ${#files[@]} -eq 0 ]]; then
        # An empty set means two opposite things depending on the mode, and only one of them
        # is benign. In the DEFAULT mode the set is `git diff --name-only HEAD`, so empty ==
        # "nothing changed" — the ordinary state of a clean worktree, and a correct pass.
        # Under --all-files empty can NEVER mean that: the mode walks the tree, so zero files
        # means the walk or the DB filter ate everything (wrong CWD, an over-broad
        # MALF_LINT_EXCLUDE_EXTRA, an unbuilt package whose TUs are all absent from the DB).
        # Passing there is the can't-FAIL vacuity: a gate that inspects nothing and reports
        # green. --all-files is the only mode fit for CI precisely because it does not depend
        # on a dirty worktree, so it is the one that must refuse to be vacuous.
        if $all_files; then
            echo "malf lint: error: --all-files matched no lintable file under $CWD." >&2
            echo "malf lint: refusing to report success — this mode walks the tree, so an empty set is a" >&2
            echo "malf lint: scoping failure (wrong directory, MALF_LINT_EXCLUDE_EXTRA too broad, or the" >&2
            echo "malf lint: package is not built so every TU was dropped as absent from the compile DB)." >&2
            _malf_lint_summary "$lint_mode" "$CWD" "$lint_selected" 0 0 0 1
            exit 1
        fi
        _malf_lint_summary "$lint_mode" "$CWD" "$lint_selected" 0 0 0 0
        return 0
    fi

    # LSRC-1's residue check, on the FINAL subject: the list above is a set of spellings and
    # cannot see one it does not carry, so the run refuses before spending a single TU of the
    # compute that law declines.
    _malf_lint_assert_no_test_tu "${files[@]}" || exit 1

    echo "malf lint: checking ${#files[@]} file(s) ..."

    # Parallel execution via xargs -P. Cap at 4 jobs (a real TU peaks at ~436 MB,
    # measured) AND cap each child's address space below — the job count alone
    # bounds how MANY processes run, not how large any one of them grows, which
    # is the half that lets a single pathological TU take the box down.
    local jobs
    jobs="$(( $(nproc) < 4 ? $(nproc) : 4 ))"
    export _MALF_MEM_LIMIT="$MALF_SOURCE_MEM_LIMIT_KB"

    local tmpdir="$_MALF_LINT_SCRATCH"

    local counter_file="$tmpdir/_progress"
    touch "$counter_file"
    export _MALF_TIDY="$clang_tidy_bin"
    export _MALF_ARGS="${extra_args[*]}"
    export _MALF_TMP="$tmpdir"
    export _MALF_CWD="$CWD"
    export _MALF_TOTAL="${#files[@]}"
    export _MALF_COUNTER="$counter_file"
    export _MALF_TU_TIMEOUT="$MALF_LINT_TU_TIMEOUT_S"
    export -f _malf_tidy_crashed

    # Pass each file as $1 to avoid xargs {} substitution inside the script body.
    # shellcheck disable=SC2016
    printf '%s\0' "${files[@]}" \
        | xargs -0 -P "$jobs" -n 1 bash -c '
            f="$1"
            ulimit -v "$_MALF_MEM_LIMIT"
            out=$(timeout "$_MALF_TU_TIMEOUT" $_MALF_TIDY $_MALF_ARGS -quiet "$f" 2>&1); rc=$?
            key=$(printf "%s" "$f" | md5sum | cut -c1-8)
            # A DEAD TOOL IS NOT A FINDING, and conflating the two is how a file goes
            # unchecked without anyone learning it did. A clang-tidy that crashes on a TU
            # inspected NOTHING in it — no check ran to completion — yet its crash dump is
            # well-formed text carrying real paths and real line numbers, so merged into the
            # findings list it reads as something the SOURCE did wrong, and the coverage hole
            # itself leaves no trace in any file. Split here, at the only place that still
            # knows WHICH file the tool died on. The predicate is _malf_tidy_crashed, exported
            # by the parent — see its definition for the two tells and why both are needed.
            if _malf_tidy_crashed "$rc" "$out"; then
                printf "%s\n" "$f"   > "$_MALF_TMP/${key}.crash"
                printf "%s\n" "$rc"  > "$_MALF_TMP/${key}.crashrc"
                printf "%s\n" "$out" > "$_MALF_TMP/${key}.crashlog"
            else
                filtered=$(printf "%s\n" "$out" \
                    | grep -vE "^\[|^Suppressed|warnings generated|^$" || true)
                [ -n "$filtered" ] && printf "%s\n" "$filtered" > "$_MALF_TMP/${key}.out"
            fi
            printf "x" >> "$_MALF_COUNTER"
            n=$(wc -c < "$_MALF_COUNTER")
            printf "[%d/%d] %s\n" "$n" "$_MALF_TOTAL" "${f#"$_MALF_CWD/"}" >&2
            exit $rc
        ' _ || lint_status=1

    # Merge in original file order, then deduplicate identical lines.
    # Headers included by multiple TUs produce identical diagnostics; awk
    # keeps the first occurrence of each line and drops repeats.
    local merged="$tmpdir/_merged.out"
    for file in "${files[@]}"; do
        local key
        key="$(printf '%s' "$file" | md5sum | cut -c1-8)"
        local slot="$tmpdir/${key}.out"
        [[ -f "$slot" ]] && cat "$slot" >> "$merged"
    done

    # Counted from the DEDUPED text, which is what a reader is handed: a header included by 40 TUs
    # produces 40 identical diagnostics and is one finding, not 40. A diagnostic is a `warning:` or
    # `error:` at a file:line:col — never a `note:`, which is a continuation of the finding above it,
    # nor the source snippet and caret lines clang-tidy prints under each one.
    local lint_findings=0
    if [[ -f "$merged" ]]; then
        local deduped
        deduped="$(awk '!seen[$0]++' "$merged")"
        lint_findings="$(grep -cE ':[0-9]+:[0-9]+: (warning|error):' <<< "$deduped" || true)"
        if [[ -n "$output_file" ]]; then
            printf '%s\n' "$deduped" >> "$output_file"
        else
            printf '%s\n' "$deduped"
        fi
    fi

    # THE TRANSLATION UNITS THAT WERE NOT CHECKED AT ALL — named, counted, and fatal.
    # This is the half a lint gate normally has no word for: a file can be clean, dirty, or
    # UNREAD, and only the first two have a vocabulary. Before this, a crash left the run red
    # with a stack dump in the findings and nothing anywhere saying that a named file had
    # gone through zero checks; both TUs it was true of on 2026-08-30 had been discovered by
    # accident, by lanes doing other work. An unlinted file must never be able to pass for a
    # linted one, so the count is reported separately and the run cannot exit 0.
    # THE CAUSE IS READ FROM THE STATUS THE CHILD RECORDED, never re-derived from the crash text.
    # `timeout` exits 124 when the per-TU cap fires, and `_malf_tidy_crashed` counts that as died —
    # correctly: the TU went through zero checks either way. But this report used to say
    # "clang-tidy died on them" for BOTH causes, which misattributes a slow TU under a lowered cap
    # as a checker death, and a reader then hunts a crash that never happened. Measured by
    # Hephaïstos 2026-09-02 on logcraft under MALF_LINT_TU_TIMEOUT_S=60: engine_manager.cpp and
    # http_sink.cpp read NOT LINTED as crashes; at the default cap they were 0 findings in 72 s
    # and 57 s. Same class as the empty-set false zero above: a verdict naming the wrong cause.
    local -a crashed=() timed_out=() died=()
    local ckey crc
    for file in "${files[@]}"; do
        ckey="$(printf '%s' "$file" | md5sum | cut -c1-8)"
        [[ -f "$tmpdir/${ckey}.crash" ]] || continue
        crashed+=("$file")
        crc="$(cat "$tmpdir/${ckey}.crashrc" 2>/dev/null || echo '?')"
        if [[ "$crc" == 124 ]]; then timed_out+=("$file"); else died+=("$file"); fi
    done
    if (( ${#crashed[@]} > 0 )); then
        lint_status=1
        echo "malf lint: ${#crashed[@]} of ${#files[@]} translation unit(s) NOT LINTED — clang-tidy died on ${#died[@]}, TIMED OUT on ${#timed_out[@]}:" >&2
        for file in "${timed_out[@]}"; do
            echo "  ${file#"$CWD"/} — TIMED OUT at ${MALF_LINT_TU_TIMEOUT_S} s (MALF_LINT_TU_TIMEOUT_S)" >&2
        done
        for file in "${died[@]}"; do
            ckey="$(printf '%s' "$file" | md5sum | cut -c1-8)"
            echo "  ${file#"$CWD"/} — died (exit $(cat "$tmpdir/${ckey}.crashrc" 2>/dev/null || echo '?'))" >&2
        done
        echo "malf lint: these files were checked by ZERO checks. This is a coverage hole, not a finding." >&2
        if (( ${#timed_out[@]} > 0 )); then
            echo "malf lint: A TIMED OUT unit is a slow TU under THIS RUN's per-TU cap, not a checker death:" >&2
            echo "malf lint: re-run it under a higher MALF_LINT_TU_TIMEOUT_S (default ${MALF_LINT_TU_TIMEOUT_DEFAULT_S} s) before" >&2
            echo "malf lint: reading it as a crash — a 60 s cap has read 72 s translation units as dead." >&2
        fi
        if (( ${#died[@]} > 0 )); then
            echo "malf lint: A DIED unit's crash dump below names the culprit on its" >&2
            echo "malf lint: \"ASTMatcher: Processing '<check>'\" line. Two remedies, and only two: remove" >&2
            echo "malf lint: the construct the check dies on, or disable that check in the config this run" >&2
            echo "malf lint: used (${tidy_config:-none}) with a reproducer, the coverage the disable costs," >&2
            echo "malf lint: and an expiry. A per-site NOLINT is NOT a third option: the crash happens" >&2
            echo "malf lint: inside the check, before any diagnostic exists to suppress." >&2
        fi
        {
            echo
            echo "=== NOT LINTED — ${#died[@]} crashed, ${#timed_out[@]} timed out at ${MALF_LINT_TU_TIMEOUT_S} s ==="
            for file in "${timed_out[@]}"; do
                echo "--- ${file#"$CWD"/}: TIMED OUT at ${MALF_LINT_TU_TIMEOUT_S} s (MALF_LINT_TU_TIMEOUT_S)"
            done
            for file in "${died[@]}"; do
                ckey="$(printf '%s' "$file" | md5sum | cut -c1-8)"
                echo "--- ${file#"$CWD"/}: died"
                head -n 40 "$tmpdir/${ckey}.crashlog"
            done
        } >> "${output_file:-/dev/stdout}"
    fi

    _malf_lint_scrub
    trap - EXIT INT TERM HUP
    unset _MALF_TIDY _MALF_ARGS _MALF_TMP _MALF_CWD _MALF_TOTAL _MALF_COUNTER _MALF_MEM_LIMIT _MALF_TU_TIMEOUT
    export -nf _malf_tidy_crashed

    if [[ -n "$output_file" ]]; then
        echo "malf lint: output written to $output_file"
    fi
    # On stdout, and NOT into $output_file: without --console the findings go to a file and the
    # terminal keeps only "output written to ...", so the one line stating what this run covered
    # must be the one the reader already has in front of them.
    _malf_lint_summary "$lint_mode" "$CWD" "$lint_selected" "${#files[@]}" \
        "$lint_findings" "${#crashed[@]}" "$lint_status"
    return "$lint_status"
}

# Emit `find` prune arguments for the shared hazard baseline plus any per-command
# additions passed as "$@". Consumed as: find DIR \( -type d \( ARGS \) -prune \) -o ...
# Emit, one per line, the `file` of every compile-DB entry whose `directory` EXISTS.
# clang-tidy chdir's into an entry's `directory` before parsing and aborts with
# `LLVM ERROR: Cannot chdir into "<dir>"!` (then hangs symbolizing its stack, so a timeout
# reads as "slow") when that dir is gone — a sub-package not built in the active profile. Such
# an entry is unlintable regardless (no BMIs / modmap there either), so lint must drop it up
# front rather than hand it to clang-tidy. Directory is load-bearing (commands carry relative
# @modmap paths that resolve against it), so it cannot simply be rewritten to an existing dir.
# Classify ONE walked file against the compile database: `in-db`, `header`, or `missing`.
#
# Split out of cmd_lint so it can be driven without a toolchain. The three-way answer is the
# point: `missing` is a COVERAGE HOLE (a TU the walk named that no compile command covers, which
# under --all-files fails the run), while `header` is not — a header has no own compile command and
# never appears in a database, and it is linted TRANSITIVELY through --header-filter when a TU that
# includes it is checked. Collapsing those two into "not linted" would red every run on every
# header; collapsing them the other way is how a real hole hides. Callers pass the DB-membership
# lookup they already did, so this stays pure and has no opinion about where the database lives.
# Answers through the global `_MALF_LINT_VERDICT` rather than stdout, deliberately: this runs once
# per WALKED FILE, and capturing stdout would mean a command substitution — a forked subshell per
# file, on a walk that reaches 700+ files across the workspace. A predicate this cheap must not cost
# a process. Testability is unaffected: a caller sets nothing up and reads the global afterwards.
_malf_lint_db_verdict() {
    local original="$2" db_hit="$3"
    if [[ -n "$db_hit" ]]; then
        _MALF_LINT_VERDICT="in-db"
    elif [[ "$original" == *.h || "$original" == *.hpp ]]; then
        _MALF_LINT_VERDICT="header"
    else
        _MALF_LINT_VERDICT="missing"
    fi
}

_malf_db_lintable_files() {
    python3 -c "
import json, os, sys
try:
    entries = json.load(open(sys.argv[1]))
except Exception:
    sys.exit(0)
for e in entries:
    if os.path.isdir(e.get('directory', '')):
        print(e['file'])
" "$1" 2>/dev/null
}

_malf_prune_args() {
    local -a out=()
    local dir_pattern
    # Split MALF_SOURCE_EXCLUDE_DIRS on whitespace but WITHOUT pathname expansion. A pattern
    # like `build-*` must reach `find -name` as the literal glob; unquoted here it instead
    # globs against the CWD, resolving to only the build dirs that sit at the CWD ROOT
    # (e.g. build-clang21-libcxx-release) and MISSING profile-variant build dirs in
    # SUB-packages (detection/build-clang21-asan). find then descends into those and hands
    # clang-tidy/clang-format the CMake compiler-probe TUs (CMakeCXXCompilerId.cpp) — spurious
    # findings, and on a module TU an ASTReader crash. `"$@"` is already-quoted array words,
    # unaffected by noglob. Measured 2026-07-23: 4 CMakeCXXCompilerId.cpp leaked into a
    # `lint --all-files` before this, 0 after.
    local _had_noglob=1; [[ -o noglob ]] || _had_noglob=0
    set -f
    for dir_pattern in $MALF_SOURCE_EXCLUDE_DIRS "$@"; do
        out+=(-name "$dir_pattern" -o)
    done
    (( _had_noglob )) || set +f
    unset "out[$((${#out[@]} - 1))]"   # drop the trailing -o
    printf '%s\0' "${out[@]}"
}

# Split MALF_SOURCE_EXCLUDE_DIRS and MALF_LINT_EXCLUDE_EXTRA into words ONCE, publishing two
# views of the same source. Word-splitting happens under noglob for the reason `_malf_prune_args`
# spells out: `build-*` must survive as a literal glob rather than resolve against the CWD.
# Answers through globals rather than stdout, the `_malf_lint_db_verdict` idiom — the path
# predicate below runs once per candidate file and must not cost a fork.
#   _MALF_LINT_EXCL_NAMES   the full walk exclusion: hazard baseline + lint policy
#   _MALF_LINT_POLICY_NAMES the lint policy alone (LSRC-1's four names)
_malf_lint_load_exclude_names() {
    local _had_noglob=1; [[ -o noglob ]] || _had_noglob=0
    set -f
    # shellcheck disable=SC2206
    _MALF_LINT_POLICY_NAMES=($MALF_LINT_EXCLUDE_EXTRA)
    # shellcheck disable=SC2206
    _MALF_LINT_EXCL_NAMES=($MALF_SOURCE_EXCLUDE_DIRS $MALF_LINT_EXCLUDE_EXTRA)
    (( _had_noglob )) || set +f
}

# Is PATH excluded by the same policy the --all-files walk prunes with? COMPONENT-EXACT, and
# that is the whole design. A glob test — `[[ $p == */$name/* ]]`, which this replaced — fails
# twice over: bash `*` crosses `/`, so the pattern for `build-*` also eats a source file named
# build-helper.cpp; and the leading `*/` demands a component ahead of the name, so it misses
# every excluded directory at the path's ROOT, which is where `git diff --name-only` puts a
# repo's own tests/. Splitting the DIRECTORY part and matching each component whole is the only
# shape that agrees with `find -type d -name PATTERN -prune` at every depth, root included.
# The file's own basename is deliberately not tested: `find` prunes directories, and testing it
# would exclude a TU whose NAME matched a pattern.
_malf_lint_path_excluded() {
    local path="$1"
    local dir="${path%/*}"
    [[ "$dir" == "$path" ]] && return 1   # a bare filename has no directory part to exclude
    local -a comps
    IFS=/ read -r -a comps <<< "$dir"     # read -a does not pathname-expand; a bare `for` would
    _malf_lint_load_exclude_names
    local comp name
    for comp in "${comps[@]}"; do
        [[ -n "$comp" ]] || continue
        for name in "${_MALF_LINT_EXCL_NAMES[@]}"; do
            # $name UNQUOTED: it is a glob pattern, matched against ONE whole component.
            # shellcheck disable=SC2053
            [[ "$comp" == $name ]] && return 0
        done
    done
    return 1
}

# LSRC-1's four names as --header-filter alternatives: glob-translated to regex and made
# position-free. `(?:.*/)?tests/` excludes a tests/ at ANY depth INCLUDING the walk root, which
# the hand-written `.*/tests/` did not — the same off-by-one the incremental leg carried, in the
# other of the two copies this replaced. The widening's domain is EMPTY on this workspace and
# that is a measurement, not an assumption (2026-08-31): no header file exists under a nested
# test_package/ or technical_docs/, and no repo-root tests/ or benchmarks/ holds one, so no
# diagnostic moves. Only MALF_LINT_EXCLUDE_EXTRA feeds this. The `\.conan2|build` alternatives at
# the call site stay written there on purpose — they are the "stay inside the project" guard, a
# different mechanism with PREFIX semantics (`build` must also catch build-gcc16-release/), and
# folding the whole hazard baseline in here would silently widen the filter over vendor/,
# third_party/ and data/, whose headers a shipped TU legitimately includes.
_malf_lint_header_filter() {
    _malf_lint_load_exclude_names
    local name rx out=""
    for name in "${_MALF_LINT_POLICY_NAMES[@]}"; do
        rx="${name//./\\.}"          # regex-escape, then translate the two glob metacharacters
        rx="${rx//\*/[^/]*}"          # component-scoped: neither may cross a path separator
        rx="${rx//\?/[^/]}"
        out+="|(?:.*/)?${rx}/"
    done
    printf '%s' "${out#|}"
}

# THE NAME LIST'S RESIDUE, MADE LOUD. MALF_LINT_EXCLUDE_EXTRA is a list of SPELLINGS, so it is
# blind by construction to a directory spelled something it does not carry — and blind reads as
# clean, because the TU is simply linted. This is the arm that sees past the spelling: a
# translation unit that DEPENDS on a test or benchmark framework IS test or bench code whatever
# its directory is called, and LSRC-1 puts it outside this surface.
#
# THE PATTERN SET IS MEASURED, NOT GUESSED — it is the entire framework surface of the eight C++
# repos on 2026-08-31: gtest/gtest.h (357 sites), benchmark/benchmark.h (23), and the module
# aggregators `import <pkg>.test;` / `import <pkg>.bench;` (247). gmock rides gtest and is listed
# with it. ARMING PROOF, on the real workspace rather than a fixture: run over the pre-rename
# --all-files subject it named exactly the 2 TUs of insight-canon's `bench/` package out of 425
# walked TUs, and nothing else — including insight-canon/semantic/test_frameworks/, which carries
# "test" in its directory name and is product code that must stay linted.
#
# ITS LIMIT, DECLARED: a test TU that includes no framework and imports no aggregator is
# invisible to it. It is a detector for the list's residue, never a replacement for the list.
_malf_lint_assert_no_test_tu() {
    local -a offenders=()
    local hit
    while IFS= read -r hit; do
        [[ -n "$hit" ]] && offenders+=("$hit")
    done < <(printf '%s\0' "$@" | xargs -0 -r grep -l -E \
        -e '^[[:space:]]*#[[:space:]]*include[[:space:]]*[<"](gtest/gtest\.h|gmock/gmock\.h|benchmark/benchmark\.h)' \
        -e '^[[:space:]]*(export[[:space:]]+)?import[[:space:]]+[A-Za-z0-9_.]+\.(test|bench)[[:space:]]*;' --)
    (( ${#offenders[@]} > 0 )) || return 0
    echo "malf lint: ${#offenders[@]} selected translation unit(s) carry a test/benchmark framework" >&2
    echo "malf lint: dependency, so LSRC-1 puts them OUTSIDE this surface — and the walk selected" >&2
    echo "malf lint: them anyway, which means their directory is spelled something the exclusion list" >&2
    echo "malf lint: does not carry (it holds: $MALF_LINT_EXCLUDE_EXTRA):" >&2
    printf '  %s\n' "${offenders[@]#"${CWD:-$PWD}"/}" >&2
    echo "malf lint: two remedies and only two: rename the directory to the spelling the other repos" >&2
    echo "malf lint: use, or add its spelling to MALF_LINT_EXCLUDE_EXTRA. Linting these is the compute" >&2
    echo "malf lint: LSRC-1 declines, so the run stops here rather than spending it." >&2
    return 1
}

# THE SCRATCH DIRECTORY MUST SAY WHETHER ITS RUN IS ALIVE. A killed `malf lint` left
# /tmp/malf_lint.*/ behind with its _progress counter frozen mid-count, and a run that is merely
# slow leaves the identical shape — so a lane inspecting the directory could not tell a stall
# from a corpse, and the only answer available (find the owning pid) was derivable from nothing
# IN the directory. Two parts, covering two different deaths: a trap removes the directory on
# every CATCHABLE exit, and _owner records an identity that survives SIGKILL, which no trap can
# reach.
#
# THE IDENTITY IS pid + PROCESS START TIME, NOT AN flock, and that is a measured choice rather
# than a preference. The obvious lock — an exclusive flock held for the run's lifetime — is
# WRONG here: a bash `{var}` descriptor is not close-on-exec, an flock belongs to the open file
# DESCRIPTION, and every child of the parallel fan-out inherits both. Measured 2026-08-31 while
# building this: SIGKILL the owner and the lock stayed held by an orphaned child, so the probe
# read ALIVE — for as long as one clang-tidy survived, bounded only by MALF_LINT_TU_TIMEOUT_S
# per remaining TU. Closing the descriptor on the fan-out does not repair it either: bash forks
# an intermediate subshell to run a function in a pipeline, and that subshell holds the
# descriptor while its child runs. `stat -c %Y /proc/<pid>` is inheritable by nothing, and
# comparing it against the value recorded at birth also closes the pid-reuse hole a bare
# `kill -0 <pid>` has: a recycled pid carries a different start time.
#
# RESIDUAL, stated: that stamp has one-second resolution, so a pid recycled inside the same
# second as the dead owner's start would read as alive. Bounded and far narrower than the two
# holes above; the alternative is parsing field 22 of /proc/<pid>/stat, whose comm field can
# contain the delimiter.
_malf_lint_open_scratch() {
    _MALF_LINT_SCRATCH="$(mktemp -d -t malf_lint.XXXXXX)"
    local owner="$_MALF_LINT_SCRATCH/_owner"
    local start; start="$(stat -c %Y "/proc/$$")"
    {
        # Line 1 is the MACHINE line and its shape is a contract — _malf_lint_owner_alive parses it.
        echo "pid $$ start $start"
        echo "malf lint scratch — started $(date -Is), host $(uname -n), cwd ${CWD:-$PWD}"
        echo
        echo "IS THAT RUN STILL ALIVE?   stat -c %Y /proc/$$"
        echo "  prints $start -> ALIVE: that is the owner, still running; _progress advances."
        echo "  anything else, or an error -> DEAD: the owner is gone. This directory is a"
        echo "                                corpse and 'rm -rf' on it is safe."
    } > "$owner"
    # Catchable death leaves nothing at all. INT/TERM/HUP re-raise after scrubbing so the shell
    # actually dies: a bare trap would return to the interrupted line and read the directory it
    # had just deleted.
    trap '_malf_lint_scrub' EXIT
    trap '_malf_lint_scrub; trap - INT;  kill -INT  $$' INT
    trap '_malf_lint_scrub; trap - TERM; kill -TERM $$' TERM
    trap '_malf_lint_scrub; trap - HUP;  kill -HUP  $$' HUP
    _malf_lint_reap_corpses
}

# Is the run that created this scratch directory still running? Reads the machine line written
# above; anything it cannot parse is reported DEAD, because an unreadable owner stamp is exactly
# the state a corpse is in and refusing to answer would restore the ambiguity this closes.
_malf_lint_owner_alive() {          # <scratch dir>
    local d="$1" tag pid key start live
    [[ -r "$d/_owner" ]] || return 1
    read -r tag pid key start _ < "$d/_owner" || return 1
    [[ "$tag" == "pid" && "$key" == "start" && -n "$pid" && -n "$start" ]] || return 1
    [[ -d "/proc/$pid" ]] || return 1
    live="$(stat -c %Y "/proc/$pid")" || return 1
    [[ "$live" == "$start" ]]
}

# Idempotent: it is both the normal exit path and every trap's body, so the two cannot diverge.
_malf_lint_scrub() {
    [[ -n "${_MALF_LINT_SCRATCH:-}" && -d "${_MALF_LINT_SCRATCH:-}" ]] && rm -rf "$_MALF_LINT_SCRATCH"
    _MALF_LINT_SCRATCH=""
    return 0
}

# Remove the scratch directories of runs that are GONE. Guarded four ways, because this is an
# `rm -rf` under a shared /tmp: the mktemp name pattern, our own uid, an mtime older than a
# minute, and a dead owner. The mtime and the owner check are not redundant — the owner check
# alone would reap a sibling run in the microseconds between its mktemp and its _owner write,
# and the mtime alone would reap a run that is merely quiet. Without a reaper the corpses the
# _owner file makes identifiable would still accumulate, one per killed run, forever.
_malf_lint_reap_corpses() {
    local d now age
    now="$(date +%s)"
    # A GLOB, not `find`. `find "${TMPDIR:-/tmp}" -maxdepth 1` writes "Permission denied" for
    # every root-owned systemd-private-* directory in /tmp — four lines of stderr on this box,
    # on EVERY lint run, from a sweep that was never going to look inside them. Measured
    # 2026-08-31. Silencing that stderr would have hidden a real failure of the sweep as well,
    # so the sweep stops generating it instead.
    for d in "${TMPDIR:-/tmp}"/malf_lint.*; do
        [[ -d "$d" ]] || continue                        # no match: the literal pattern
        [[ "$d" == "${_MALF_LINT_SCRATCH:-}" ]] && continue
        [[ -O "$d" ]] || continue                        # ours only
        age="$(stat -c %Y "$d")" || continue
        (( now - age > 60 )) || continue                 # the mktemp/_owner-write window
        _malf_lint_owner_alive "$d" && continue
        rm -rf "$d"
    done
}

# THE RUN'S OWN SCOPE, STATED — the format twin of _malf_lint_summary, deliberately in the SAME
# vocabulary, because two adjacent gates reporting in two grammars is a second thing for a reader
# to learn and one of them will be misread. Measured 2026-09-03: `malf format --check` from the
# workspace root inspected 887 files and printed exactly ONE line, the banner. It was already
# better off than lint was — its zero case IS named — but a GREEN still stated no population, so
# "malf format --check, exit 0" is the same sentence whether 887 files were checked, or 3, or
# none, and nothing in the output separated them.
#
# THE COUNTS ARE THE ONES THIS PATH ACTUALLY HOLDS, and they are not lint's three.
#   selected = every file the walk matched by extension, BOTH size classes
#   checked  = the files handed to clang-format (selected minus the oversized skips)
#   skipped  = the MALF_SOURCE_MAX_FILE_KB overruns, already listed by name above
# so `selected = checked + skipped` is an identity a reader can verify on the line itself, and a
# non-zero `skipped` is this path's ONE coverage gap — the analogue of lint's `selected > checked`.
# There is no further selected/checked split to invent: unlike lint there is no compile database
# and no lintability filter here, every checked file reaches the tool, and a distinction the path
# does not have must not be printed as though it did.
#
# `misformatted` is counted in CHECK mode only, from the DISTINCT paths clang-format names in
# `<file>:<line>:<col>: error: code should be clang-formatted` — one file with six violations is
# one misformatted file. WRITE mode has no such measurement: `clang-format -i` is silent and never
# reports which files it changed, so that field is ABSENT there rather than guessed, and the word
# is `formatted` (the post-state -i guarantees for those files), never "changed".
#
# rc IS PRINTED BECAUSE IT IS NOT 1. The tool runs under `xargs -n`, so any failing batch makes
# the run exit 123 — xargs's "some invocation exited 1-125" — and 123 is what an offender run
# returns today. Paired with the count it separates two states the status alone cannot: rc != 0
# with N > 0 is formatting, while rc != 0 with N == 0 is clang-format FAILING for a reason that is
# not formatting (the ulimit -v address-space cap, an unreadable file) — a coverage hole wearing a
# violation's exit status.
_malf_format_summary() {
    local mode="$1" dir="$2" selected="$3" checked="$4" misformatted="$5" skipped="$6" rc="$7"
    if (( checked == 0 )); then
        # Deliberately not phrased as a pass, for the same reason lint's is not (Founder,
        # 2026-09-03). The verb differs because the act differs: a check that read nothing
        # inspected nothing; a write that touched nothing rewrote nothing.
        if [[ "$mode" == check-* ]]; then
            echo "malf format: SUMMARY · mode=$mode · dir=$dir · selected $selected, CHECKED 0 — NOTHING WAS INSPECTED, $skipped skipped · rc=$rc"
            echo "malf format: this run read no source, so it is NOT a clean verdict. A tree with no C++ is a"
            echo "malf format: real state (the TypeScript repos); the wrong directory looks identical from here."
        else
            echo "malf format: SUMMARY · mode=$mode · dir=$dir · selected $selected, FORMATTED 0 — NOTHING WAS REWRITTEN, $skipped skipped · rc=$rc"
            echo "malf format: this run wrote no file. A tree with no C++ is a real state; the wrong directory"
            echo "malf format: looks identical from here."
        fi
        return 0
    fi
    if [[ "$mode" == check-* ]]; then
        echo "malf format: SUMMARY · mode=$mode · dir=$dir · selected $selected, checked $checked, $misformatted misformatted, $skipped skipped · rc=$rc"
        if (( rc != 0 && misformatted == 0 )); then
            echo "malf format: rc=$rc with ZERO violations counted — clang-format failed for a reason that is" >&2
            echo "malf format: NOT formatting (the ${MALF_SOURCE_MEM_LIMIT_KB}KB address-space cap, an unreadable file). Those" >&2
            echo "malf format: files were not checked at all; read the output above." >&2
        fi
        return 0
    fi
    echo "malf format: SUMMARY · mode=$mode · dir=$dir · selected $selected, formatted $checked, $skipped skipped · rc=$rc"
    if (( rc != 0 )); then
        echo "malf format: rc=$rc — at least one clang-format batch FAILED, so some of those $checked files" >&2
        echo "malf format: were not rewritten. Read the output above." >&2
    fi
}

cmd_format() {
    local check=false
    # PATHSPEC (Founder, 2026-08-08): `malf format [--check] [PATH...]`. A lane formats what it
    # OWNS and never touches what it does not.
    #
    # WHY IT EXISTS, since a no-arg sweep is otherwise fine: the repos share ONE worktree across
    # parallel lanes, so a whole-repo format touches files another lane has uncommitted. The
    # workaround was save-untracked -> format -> revert-foreign -> restore, run by hand on every
    # commit, twice over a sibling's live work. That manoeuvre has a data-loss failure mode and its
    # only safeguard is somebody remembering to save first. A pathspec removes the manoeuvre
    # instead of asking people to keep performing it correctly.
    #
    # No PATH = the whole-repo sweep, unchanged, for whoever wants it.
    local -a roots=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --check) check=true ;;
            -*) _malf_refuse_option format "$1" ;;
            *)
                if [[ ! -e "$1" ]]; then
                    # A typo'd path must NOT format nothing and exit 0 — that is a silent no-op
                    # reported as a clean format, the failure class this tool keeps finding
                    # elsewhere.
                    echo "malf format: error: path does not exist: $1" >&2; exit 1
                fi
                roots+=("$1")
                ;;
        esac
        shift
    done
    local explicit_paths=true
    if [[ ${#roots[@]} -eq 0 ]]; then explicit_paths=false; roots=("$CWD"); fi

    # The two axes that decide what a green covers, spelled out rather than labelled: what the run
    # DID (check / write) and where its population came from (a no-arg sweep of $CWD, or the paths
    # the caller named). Both are invisible in the output otherwise, and a reader who assumes the
    # wrong one on either axis reads the verdict as wider than it is.
    local fmt_mode
    if $check; then fmt_mode=check; else fmt_mode=write; fi
    if $explicit_paths; then fmt_mode="$fmt_mode-paths"; else fmt_mode="$fmt_mode-sweep"; fi

    # Use the clang-format from the SAME install as the build compiler (clang-21) for
    # consistency. clang-format is a pure formatter — a version skew can't error like
    # clang-tidy's BMI mismatch — but different clang-format versions reflow code
    # differently (churn), so match the toolchain. Derive from clang-21; fall back to PATH.
    local clang_bin clang_format_bin="" install_fmt=""
    clang_bin="$(command -v clang-21 || command -v clang || true)"
    if [[ -n "$clang_bin" ]]; then
        install_fmt="$(dirname "$(readlink -f "$clang_bin")")/clang-format"
        [[ -x "$install_fmt" ]] && clang_format_bin="$install_fmt"
    fi
    if [[ -z "$clang_format_bin" ]]; then
        clang_format_bin="$(command -v clang-format-21 || command -v clang-format || true)"
        [[ -n "$install_fmt" && -n "$clang_format_bin" ]] && \
            echo "malf format: note: $install_fmt missing; using $clang_format_bin (clang-21 is the build compiler). 'sudo apt install clang-format-21' for version-matched formatting." >&2
    fi
    [[ -n "$clang_format_bin" ]] || { echo "malf format: error: clang-format not found" >&2; exit 1; }

    # ── Style resolution: explicit, and NEVER a silent fallback ──────────────
    # A bare `-style=file` makes clang-format search upward from each FILE and, finding
    # nothing, format to LLVM style — with no warning and no error, so the whole tree
    # reports as misformatted for a reason that never appears in the output. That is not
    # hypothetical: every C++ repo here except insight-twin commits `.clang-format` as a
    # RELATIVE SYMLINK to `../malf/config/.clang-format`, which resolves in a workspace
    # checkout and DANGLES in a standalone clone — i.e. in every CI checkout, where the
    # sibling malf/ does not exist. `[[ -f ]]` follows symlinks, so a dangling link is
    # correctly "absent" here and we fall through to the toolchain's own copy, which is
    # the very file the symlink names, passed by explicit path.
    #
    # The old form looked for `$MALF_DIR/.clang-format` (the bundled config actually lives
    # in `$MALF_DIR/config/`, which is where cmd_lint reads its .clang-tidy from), so the
    # fallback could never fire and the silent-LLVM path was the only outcome. It also
    # COPIED the config into the tree it was about to check — a checker must not dirty its
    # own worktree; passing the path does the same job and leaves the checkout clean.
    local style
    if [[ -f "$CWD/.clang-format" ]]; then
        # Let clang-format do its own upward search so per-subdirectory overrides still apply.
        style="file"
    elif [[ -f "$MALF_DIR/config/.clang-format" ]]; then
        style="file:$MALF_DIR/config/.clang-format"
        echo "malf format: no usable $CWD/.clang-format (absent, or a symlink that does not resolve in this checkout) — using the toolchain config $MALF_DIR/config/.clang-format" >&2
    else
        echo "malf format: error: no .clang-format at $CWD and none at $MALF_DIR/config/.clang-format." >&2
        echo "malf format: refusing to run — clang-format would silently format to LLVM style and report the whole tree as misformatted." >&2
        exit 1
    fi

    local format_args
    if $check; then
        format_args=(--dry-run --Werror "-style=$style")
        echo "=== malf format: checking (-style=$style) ==="
    else
        format_args=(-i "-style=$style")
        echo "=== malf format: formatting (-style=$style) ==="
    fi

    # Prune list → find args. `-name` glob-matches, so `build-*` works as written.
    local -a prune_args=()
    mapfile -d '' -t prune_args < <(_malf_prune_args $MALF_FORMAT_EXCLUDE_EXTRA)

    local -a source_globs=(
        -name "*.cpp" -o -name "*.cxx" -o -name "*.cc"
        -o -name "*.h" -o -name "*.hpp" -o -name "*.cppm"
    )

    # A skipped file must be REPORTED, never silently dropped — a silent cap
    # reads as "formatted everything" when it did not. `! -size -Nk` is the
    # exact complement of the `-size -Nk` filter below, so nothing falls in a gap.
    local oversized
    oversized="$(find "${roots[@]}" \
        \( -type d \( "${prune_args[@]}" \) -prune \) -o \
        \( -type f \( "${source_globs[@]}" \) ! -size "-${MALF_SOURCE_MAX_FILE_KB}k" \
           -printf '  %p (%s bytes)\n' \))"
    if [[ -n "$oversized" ]]; then
        echo "malf format: SKIPPED ${MALF_SOURCE_MAX_FILE_KB}KB+ file(s) — clang-format needs ~500x a file's size in RAM:" >&2
        echo "$oversized" >&2
        echo "malf format: these are not formatted. Exclude their directory (MALF_FORMAT_EXCLUDE_EXTRA) if they are not source." >&2
    fi
    # One line per skipped file (the -printf above), so the line count IS the count. Guarded by
    # the -n test rather than let `grep -c` see an empty string: it would print 1 for the single
    # empty line, and `set -e` would kill the run on its exit status.
    local skipped=0
    if [[ -n "$oversized" ]]; then skipped="$(grep -c . <<< "$oversized")"; fi

    # `ulimit -v` applies to the clang-format child, so an overrun aborts the
    # formatter instead of the machine. Batched (-n) so one pathological file
    # cannot cost the whole run, and so the surviving output names the culprit.
    local -a targets=()
    mapfile -d '' -t targets < <(find "${roots[@]}" \
        \( -type d \( "${prune_args[@]}" \) -prune \) -o \
        \( -type f \( "${source_globs[@]}" \) -size "-${MALF_SOURCE_MAX_FILE_KB}k" -print0 \))

    # An EXPLICIT pathspec matching no source file is an error, never a quiet success: it means a
    # typo or a wrong directory, and reporting it as a clean format is the silent-green shape.
    # A no-arg sweep over a repo with no C++ stays inert and exit 0 — that is a real, declared
    # state (the lint workflow's `format-check: false` for TS repos rests on it).
    if [[ ${#targets[@]} -eq 0 ]]; then
        if $explicit_paths; then
            echo "malf format: error: no source file under: ${roots[*]}" >&2
            echo "malf format: (looked for .cpp .cxx .cc .h .hpp .cppm)" >&2
            _malf_format_summary "$fmt_mode" "${roots[*]}" "$skipped" 0 0 "$skipped" 1
            exit 1
        fi
        # This replaces "no source files found under … — nothing to do.", which was accurate and
        # still read as a pass. The summary says the same fact in the vocabulary every other run
        # of this verb uses, so the zero case and a real green are told apart by their SHAPE and
        # not by remembering which sentence means which.
        _malf_format_summary "$fmt_mode" "${roots[*]}" "$skipped" 0 0 "$skipped" 0
        return 0
    fi

    # The run's own output is CAPTURED so the violations can be counted, then reprinted in full —
    # buffered, never swallowed. Measured 2026-09-03: the workspace-root sweep is 887 files in
    # 5.9 s, so the delay this costs a reader is bounded by the whole run, and a verdict that
    # states its population is worth those seconds. Write mode prints nothing at all, so it loses
    # no streaming whatsoever.
    local fmt_log
    fmt_log="$(mktemp -t malf_format.XXXXXX)"
    # Both halves: the trap covers a Ctrl-C mid-run, the explicit rm below covers the ordinary
    # path. A trap alone would leak the file on every normal exit, since EXIT fires after it.
    trap 'rm -f "$fmt_log"' EXIT INT TERM HUP

    local fmt_rc=0
    printf '%s\0' "${targets[@]}" \
    | xargs -0 -r -n "$MALF_FORMAT_BATCH_SIZE" \
        bash -c 'ulimit -v "$0"; exec "$@"' \
        "$MALF_SOURCE_MEM_LIMIT_KB" "$clang_format_bin" "${format_args[@]}" \
        > "$fmt_log" 2>&1 || fmt_rc=$?
    cat "$fmt_log" >&2

    # DISTINCT paths, not diagnostics. clang-format emits one `error:` per violation, so a file
    # with six of them is ONE misformatted file and counting lines would report the severity of a
    # file as the size of the population. The path is everything before the trailing `:LINE:COL:`.
    local misformatted=0
    misformatted="$(grep -E ': error: code should be clang-formatted' "$fmt_log" \
                    | sed -E 's/:[0-9]+:[0-9]+: error: code should be clang-formatted.*$//' \
                    | sort -u | grep -c . || true)"

    rm -f "$fmt_log"
    trap - EXIT INT TERM HUP

    _malf_format_summary "$fmt_mode" "${roots[*]}" "$(( ${#targets[@]} + skipped ))" \
        "${#targets[@]}" "$misformatted" "$skipped" "$fmt_rc"
    return "$fmt_rc"
}

_malf_resolve_preset() {
    # Resolve the conan configure-preset name (conan-debug / conan-release) the way
    # cmake does: CMakePresets.json then CMakeUserPresets.json in the SOURCE dir,
    # following "include" chains. Prints the name, or nothing if none is found.
    python3 -c "
import json, pathlib, sys
subdir = pathlib.Path(sys.argv[1])
for fname in ('CMakePresets.json', 'CMakeUserPresets.json'):
    src = subdir / fname
    if not src.exists():
        continue
    try:
        data = json.loads(src.read_text())
    except Exception:
        continue
    for cp in data.get('configurePresets', []):
        if cp.get('name', '') in ('conan-release', 'conan-debug'):
            print(cp['name']); sys.exit(0)
    for inc in data.get('include', []):
        inc_path = (subdir / inc).resolve()
        if not inc_path.exists():
            continue
        try:
            inc_data = json.loads(inc_path.read_text())
        except Exception:
            continue
        for cp in inc_data.get('configurePresets', []):
            if cp.get('name', '') in ('conan-release', 'conan-debug'):
                print(cp['name']); sys.exit(0)
" "$1" 2>/dev/null || true
}

# THE TESTED REFERENCE IS THE ONE FACT A STANDALONE CONFIGURE CANNOT DERIVE, and it is handed over
# as `MALF_TESTED_VERSION`.
#
# `conan create` runs the test_package's OWN recipe: its `generate()` executes, so anything that
# method computes from `self.tested_reference_str` reaches CMake. This function does not run that
# recipe — it installs a SYNTHETIC consumer (`conan install --requires=<ref>`) and configures the
# directory directly, because running the real one means `conan test`, which BUILDS. So every
# cache variable the recipe's `generate()` would have set is absent here, and a test_package that
# refuses without one does not configure at all: measured 2026-09-03 in insight-metalog, whose
# CMakeLists FATAL_ERRORs when the version under test is missing (its consumer smoke asserts the
# emitted `producer.version` against the RELEASED reference, and that assertion has no oracle
# without it). Its one translation unit was absent from the editor database, and the run still
# exited 0.
#
# malf cannot reproduce arbitrary Python, so it hands over the one input that distinguishes a
# `conan create` test_package configure from a standalone one: the reference under test. The name
# is already in the directory path; the VERSION is not derivable from the test_package source at
# all. So ONE variable, `MALF_TESTED_VERSION`, with TWO producers and ONE consumer — malf sets it
# here, the test_package recipe sets the same name from `tested_reference_str` in its `generate()`,
# and the CMakeLists reads it. The guard cannot be satisfied on one path and not the other: a
# recipe that forgets it reds `conan create` at exactly the message that reds `malf commands`.
#
# REJECTED, each with the reason:
#   * malf derives the package's own variable name (`<NAME>_TESTED_VERSION`, uppercased). No recipe
#     change, and an UNDECLARED convention: a recipe naming it anything else gets a cache variable
#     nobody reads plus the same refusal, with malf's log now claiming it supplied the value.
#   * The test_package CMakeLists defaults the variable when absent. That is the assertion's whole
#     oracle; a default makes it compare the emitted version against a literal typed in the same
#     file, which measures the typist. Under `conan create` — the run that gates the release — the
#     degradation would be silent, and a silent oracle is worse than a loud refusal.
#   * `malf commands` skips test_package directories. Cheapest, and it drops NINE translation units
#     to fix one — counted 2026-09-03: every test_package holding a CMakeLists.txt in the workspace
#     (insight-canon/core, insight-eidos, insight-metalog, logcraft/core, coderoast-security/auth,
#     coderoast-server/server-logging, and coderoast-server/infra's clickhouse, postgres and redis)
#     carries exactly one. A test_package is the only consumer-shaped code a package has; losing
#     the editor on it is losing it on the only TU that compiles the package as an outsider does.
#   * Read the version off the package config that `find_package` loads. insight_metalog sets
#     `cmake_find_mode = "none"` and ships its own native config (it carries FILE_SET CXX_MODULES,
#     which conan's generator does not emit), and that config has no version — the CMake project()
#     declares none. Adding one would introduce a THIRD literal to keep in step with the recipe
#     version and the C++ constant, which is more authorities, not fewer.
_malf_configure_test_package() {
    # Configure a package's test_package so clangd indexes it too. conan create
    # builds it in a temp dir that the editor never sees, so we re-install its deps
    # and configure it in-tree. The COMPILER comes from the profile buildenv
    # (CC/CXX) — sourced below — not the toolchain (which only adds stdlib flags like
    # -stdlib=libc++); without it a libc++ profile would fall back to system g++.
    #
    # Returns non-zero when the directory did not configure. The caller turns that into a refusal:
    # the database's one reader is an editor, which reports a missing TU as an unknown symbol
    # rather than as a missing TU, so an exit code is the only place a truncation can be seen.
    local subdir="$1" tp_build="$2"
    local main_ref
    main_ref="$(_malf_pkg_ref "$subdir/conanfile.py")"
    # Fresh every run: the test_package build dir is unkeyed (reused across
    # profiles), so a stale CMakeCache/toolchain from a prior profile clashes (a
    # cached g++ vs a libc++ toolchain). Cheap — deps stay conan-cached.
    rm -rf "$tp_build"
    mkdir -p "$tp_build"
    # Deps: the tested package ($main_ref == self.tested_reference_str) + every
    # literal-versioned (test_)requires() in the test_package conanfile (e.g. a
    # private visible=False dep it re-requires for itself).
    local tp_req_args=("--requires=$main_ref")
    while IFS= read -r req; do
        [[ -n "$req" ]] && tp_req_args+=("--requires=$req")
    done < <(python3 -c "
import re, pathlib
txt = pathlib.Path('$subdir/test_package/conanfile.py').read_text()
for r in re.findall(r\"(?:test_)?requires\\s*\\(\\s*['\\\"]([^'\\\"]+)['\\\"]\\s*\\)\", txt):
    print(r)
" 2>/dev/null || true)
    echo "malf commands: installing test_package deps ($main_ref) in $(basename "$subdir")"
    conan install \
        "${tp_req_args[@]}" \
        -g CMakeToolchain -g CMakeDeps \
        --output-folder="$tp_build" \
        --profile:host="$MALF_PROFILE" \
        --profile:build="$MALF_PROFILE" \
        --build=missing \
        -c "tools.cmake.cmaketoolchain:generator=Ninja" \
        -s "build_type=$MALF_CONFIG" \
        2>&1 | grep -vE "^$|^======|^Requirements|^Packages|^Build" || true

    local tp_toolchain="$tp_build/conan_toolchain.cmake"
    if [[ ! -f "$tp_toolchain" ]]; then
        echo "malf commands: test_package deps FAILED for $(basename "$subdir"): the install wrote no" >&2
        echo "malf commands: $tp_toolchain, so there is nothing to configure against." >&2
        return 1
    fi
    # The tested module package ships its native config (FILE_SET CXX_MODULES) into the dir
    # malf JUST configured it in — the PARENT of tp_build (= _malf_build_dir "$subdir", the
    # package-anchored tree, which IS the editable build dir the recipe's builddir resolves
    # to). Point CMAKE_PREFIX_PATH at it so find_package(<pkg>) hits the fresh config.
    local main_build_dir; main_build_dir="$(dirname "$tp_build")"
    echo "malf commands: configuring $(basename "$subdir")/test_package"
    if ! ( source "$tp_build/conanbuild.sh" 2>/dev/null
           cmake -S "$subdir/test_package" \
                 -B "$tp_build" \
                 -G Ninja \
                 "-DCMAKE_TOOLCHAIN_FILE=$tp_toolchain" \
                 "-DCMAKE_PREFIX_PATH=$main_build_dir" \
                 "-DMALF_TESTED_VERSION=${main_ref#*/}" \
                 -DCMAKE_BUILD_TYPE="$MALF_CONFIG" \
                 -DCMAKE_EXPORT_COMPILE_COMMANDS=ON ) \
             > "$tp_build/cmake_configure.log" 2>&1; then
        echo "malf commands: test_package configure FAILED:" >&2
        tail -20 "$tp_build/cmake_configure.log" >&2
        return 1
    fi
    return 0
}

_malf_merge_db_tree() {
    # Merge every compile_commands.json under the given build dirs into
    # <build_root>/compile_commands.json (what .clangd's CompilationDatabase
    # points at). Structure-agnostic.
    local build_root="$1"; shift
    local root_db="$build_root/compile_commands.json"
    python3 - "$root_db" "$@" << 'PY'
import json, sys
from pathlib import Path

root_output = Path(sys.argv[1]).resolve()
scan_dirs   = [Path(p) for p in sys.argv[2:]]

# A single-package repo configures into its own build dir, so its DB IS
# root_output — read it first so those entries survive (it was cleared before
# the walk for multi-package repos, so it is absent there).
dbs, seen_paths = [], set()
if root_output.exists():
    seen_paths.add(root_output)
    dbs.append(root_output)
for scan_dir in scan_dirs:
    for found in sorted(scan_dir.rglob("compile_commands.json")):
        found = found.resolve()
        if found not in seen_paths:
            seen_paths.add(found)
            dbs.append(found)

if not dbs:
    raise SystemExit(f"malf commands: no compile_commands.json under {', '.join(map(str, scan_dirs))} "
                     "(did every configure fail?)")

merged, seen = [], set()
for db in dbs:
    try:
        entries = json.loads(db.read_text())
    except Exception as exc:
        print(f"malf commands: warning: {db}: {exc}", file=sys.stderr)
        continue
    for e in entries:                       # one entry per file (clangd convention)
        key = e.get("file")
        if key not in seen:
            seen.add(key)
            merged.append(e)

root_output.write_text(json.dumps(merged, indent=2) + "\n")
print(f"malf commands: merged {len(dbs)} database(s) -> {root_output} "
      f"({len(merged)} entries)")
PY
}

# ── THE ROLE COLLISION, AND WHY THE BUILD-TREE KEY DOES NOT GAIN A ROLE DIMENSION (`N146`) ──
#
# A package can be configured TWICE in one `malf commands` pass, under two ROLES: as the indexed
# TARGET (`_malf_cmake_feature_args <pkg> ON ON` — tests and benches ON), and as a sibling
# member's DEPENDENCY (`_malf_dependency_cmake_args` — both OFF) through
# `_malf_bootstrap_workspace_deps`. Both writes land in `<pkg>/build-<key>`, because that key is
# `(package, profile)` and carries NO DIMENSION FOR ROLE — so the second configure replaces the
# first's compile_commands.json, and the merge below reads whatever the last visit left.
#
# MEASURED, coderoast-ipc at profile clang21-libcxx-release, 2026-09-03: `coderoast_ipc_core` is a
# dependency of BOTH `consumer` and `producer`, so its ON/ON configure was overwritten twice and
# the merged root database came out at 15 entries against a complete 19. The 4 missing were ALL
# first-party and 0 external — core/tests/unit/test_channel_shutdown.cpp,
# core/tests/unit/test_shared_memory_channel.cpp, core/tests/core.test.cppm and
# core/benchmarks/bench_ipc.cpp. The editor index is the only consumer of that file and it had no
# gate, so the loss was silent in both directions: a 15-entry database reads exactly like a
# complete one.
#
# THE KEY DOES NOT GAIN A ROLE DIMENSION, and that is a decision rather than an omission:
#   * The recipes bind a consumer to its dependency's build directory BY NAME (the recipe layout
#     reads MALF_EDITABLE_BUILD_DIR — see _malf_editable_build_dir), so a second role-keyed tree
#     would be the one consumers LINK while the other is the one `malf test` greens: a green about
#     a tree nobody links. That is exactly the "second, inconsistent build tree" footgun the
#     one-tree rule in _malf_build_dir exists to kill, re-entered through another door.
#   * It doubles compile time and disk for every package that is both a target and a dependency,
#     and in this workspace that is most of them (21 of the 28 workspace packages, measured 2026-09-03,
#     are an intra- or cross-repo dependency of another package).
#   * It would not even fix the editor: clangd reads ONE database, so the merge would still have
#     to choose a role per package. The choice does not disappear, it only moves.
#
# WHAT MAKES ONE TREE SUFFICIENT is that the two roles are NOT SYMMETRIC — the dependency
# configuration is a strict SUBSET of the target one. VERIFIED 2026-09-03 by diffing the two
# CMakeCache.txt of coderoast-ipc/core: they differ in the two feature variables
# (CODEROAST_IPC_CORE_BUILD_TESTS, CODEROAST_IPC_CORE_BUILD_BENCH) and in one variable CMake
# itself derives from them (CMAKE_CTEST_COMMAND-ADVANCED, added by enable_testing()); compiler,
# flags, standard library, build type and every dependency path are byte-identical. So the rule is
# not "keep both trees", it is THE RICHER ROLE WINS THE TREE: a pass that INDEXES must leave every
# member configured as a target, and the target configure must be the LAST writer.
#
# REJECTED, each with the reason:
#   * Merge instead of overwrite — teach the merge to keep entries a later configure dropped. It
#     cannot tell a TU that vanished because the ROLE changed from one that vanished because it
#     was DELETED from the package, so the database would accumulate entries clangd then fails to
#     open. A stale entry is worse than a missing one: it is wrong rather than absent.
#   * Configure dependencies with tests ON so nothing is ever demoted. `cmake --build` builds every
#     target in the tree, so this compiles every dependency's tests and benches on every consumer
#     build — precisely the cost _malf_dependency_cmake_args exists to avoid.
#   * Snapshot each target-role database to a role-tagged sidecar and merge from sidecars. Robust
#     to ordering, but it adds a second artifact per package carrying its own staleness question
#     ("is this sidecar older than the tree it describes?") that nothing can answer. The
#     re-assertion below needs no new artifact.
#
# So the repair is PASS 2 in cmd_compile_commands — re-assert the target role on every member that
# another member's dependency bootstrap demoted — and the gate is _malf_commands_tree_role, which
# reads the CMakeCache the configure actually wrote (the tree's own artifact, never malf's intent),
# so the class cannot come back silently the next time something is inserted between a member's
# configure and the merge.

# THE TREE'S ROLE, READ FROM ITS OWN CMakeCache — the role twin of _malf_assert_tree_matches_profile,
# and two independent ends for the same reason: malf's intent agreeing with itself proves nothing.
# Pure and side-effect-free so the selftest can drive it against a fixture cache with no toolchain
# present; it publishes through globals because the caller wants the offending variable NAMES as
# well as the verdict.
#
#   target      every BUILD_TESTS/BUILD_BENCH variable in the cache is ON (or there is none)
#   dependency  at least one is OFF — the tree was last written by a dependency configure
#   no-cache    no CMakeCache.txt: this member never configured, so it is absent from the database
#
# A tree that declares NO BUILD_TESTS/BUILD_BENCH variable at all answers `target`, deliberately: a
# package with no test or bench option cannot be demoted, and reding on it would be the obvious
# wrong fix — it would make every option-less package unpassable while measuring nothing.
_malf_commands_tree_role() {          # <build_dir> -> _MALF_TREE_ROLE, _MALF_TREE_ROLE_VARS
    local cache="$1/CMakeCache.txt"
    _MALF_TREE_ROLE="no-cache"
    _MALF_TREE_ROLE_VARS=""
    [[ -f "$cache" ]] || return 0
    local off
    off="$(sed -nE 's/^([A-Za-z0-9_]*(BUILD_TESTS|BUILD_BENCH)[A-Za-z0-9_]*):BOOL=(OFF|FALSE|NO|0)$/\1/p' \
             "$cache" | sort -u | tr '\n' ' ')"
    off="${off% }"
    if [[ -n "$off" ]]; then
        _MALF_TREE_ROLE="dependency"
        _MALF_TREE_ROLE_VARS="$off"
    else
        _MALF_TREE_ROLE="target"
    fi
    return 0
}

# THE RUN'S OWN SCOPE, STATED — the `commands` member of the family _malf_lint_summary and
# _malf_format_summary opened, in the SAME grammar for the same reason: two adjacent gates
# reporting in two vocabularies is a second thing for a reader to learn and one of them gets
# misread.
#
# `malf commands` printed exactly ONE line — "merged N database(s) -> <path> (E entries)" — and E
# alone cannot separate a complete database from a truncated one. Measured 2026-09-03 in
# coderoast-ipc: the run that dropped four first-party TUs printed "(15 entries)" and the correct
# run prints "(19 entries)". Nothing in either line says which is which, and the file's only reader
# is an editor, which reports a missing TU as an unknown symbol rather than as a missing TU.
#
# THE COUNTS ARE THE ONES THIS PATH HOLDS, and they are not lint's three:
#   selected     every member `_malf_member_packages` produced
#   configured   the members that reached a target-role `cmake --preset`
#   content-only a member with no CMakeLists.txt ANYWHERE — neither its own nor its test_package's
#                — so it contributes no TU at all. Narrower than malf_graph.py's identically-named
#                term, which asks only about the member's own CMakeLists.txt; the difference is
#                the bucket below.
#   buildless    a member whose conan install produced no CMakePresets.json, so its own preset
#                configures nothing. A header-library recipe generates no CMakeToolchain and lands
#                here legitimately (coderoast-server/server-logging), and whatever it contributes
#                to the database arrives through its test_package. It is a SEPARATE term from
#                content-only because the two differ in what they promise: content-only says there
#                is nothing to index, buildless says only the member's OWN units are unindexed.
#                A buildless member that DOES carry a CMakeLists.txt is a failed install, and is
#                fatal below — the preset it should have had is missing.
#                So `selected = configured + content-only + buildless` is an identity verifiable
#                on the line, and a member accounted for by none of the three is fatal.
#   test_package a CENSUS — every test_package/CMakeLists.txt under a selected member — split into
#                configured, failed (the configure ran and refused) and unreached (in the census
#                and in neither outcome set). The denominator is what EXISTS rather than what the
#                run got to, because those two differed until 2026-09-03: coderoast-server holds
#                four test_package directories and the run attempted three, the fourth being
#                server-logging's, dropped by the preset gate in the member loop. A line counting
#                attempts would have printed "3" beside a repo holding 4 and read as complete.
#                Both residuals — unaccounted members and unreached test_packages — are SET
#                DIFFERENCES against a census taken before any gate, never a counter each branch
#                remembers to bump: a branch that forgets a counter prints a line that still sums.
#                It needs its own line because a test_package is configured OUTSIDE the member's
#                preset (a synthetic conan consumer, then a direct cmake -S) and so contributes no
#                CMakeCache for _malf_commands_tree_role to read — the per-member role verdict is
#                blind to it by construction.
#   entries      the merged database's size, SPLIT first-party (under the invocation root) versus
#                external (a standard-library module unit, a dependency in a SIBLING repo). The
#                split is the load-bearing half: `N146` moved the first-party count while leaving
#                the external one untouched, and a total alone cannot show that.
#   per member   its entries and how many of those are test/bench TUs — where a demotion shows up.
#                Rows cover CONFIGURED members and BUILDLESS ones. The role column of a configured
#                row is read from that member's CMakeCache; a buildless member has no cache to
#                read, so its row prints the literal role `buildless` — which is the outcome
#                itself, not a reading of one. It gets a row because it CONTRIBUTES: its
#                test_package units reach the database even though its own do not, and a member
#                with entries and no row is a database whose per-member breakdown silently does
#                not account for it. Measured 2026-09-03 before this: coderoast-server's five rows
#                totalled 128 against first-party 129, the odd one
#                server-logging/test_package/test_package.cpp.
#   unattributed the first-party entries under NO member prefix — the residual that makes the rows
#                CHECKABLE on the line instead of assumed. It is a legitimate shape, not a fault,
#                so it is a number and never a fatal: a first-party source directory that is not
#                itself a conan member (shared test-support code compiled into a sibling member's
#                test binary) lands here. Measured 2026-09-05 at profile clang21-libcxx-release,
#                coderoast-server: first-party 170, configured rows 168, buildless row 1,
#                unattributed 1 — infra/tests_support/local_container.cpp, compiled from
#                infra/redis's build dir and under none of the seven members. So the gap the
#                buildless row closes was ONE of TWO, and without this term the line would still
#                not sum while reading as though it did.
#
# Entries are attributed to the LONGEST matching member prefix, never the first match: members
# NEST (insight-eidos is a package and also the parent of insight-eidos/sift), so a shortest-prefix
# attribution bills every subpackage's TU to the parent and reports full coverage for a member that
# contributed nothing.
_malf_commands_summary() {            # <db> <root> <sel> <content_only> <buildless> <tp_present> <tp_conf> <tp_failed> [<role> <dir>]...
    local db="$1" root="$2" selected="$3" content_only="$4" buildless="$5"
    local tp_present="$6" tp_configured="$7" tp_failed="$8"
    shift 8
    if [[ ! -f "$db" ]]; then
        echo "malf commands: SUMMARY · root=$root · db=$db · NO DATABASE WAS WRITTEN — nothing was indexed" >&2
        return 1
    fi
    python3 - "$db" "$root" "$selected" "$content_only" "$buildless" \
              "$tp_present" "$tp_configured" "$tp_failed" "$@" <<'PY'
import json, os, sys

db, root, selected, content_only, buildless, tp_present, tp_configured, tp_failed = sys.argv[1:9]
rows = [a.split(" ", 1) for a in sys.argv[9:]]

files = [e.get("file", "") for e in json.loads(open(db).read())]
prefix = root.rstrip("/") + "/"
first = sum(1 for f in files if f.startswith(prefix))

# `configured` is DERIVED from the rows rather than passed beside them. The rows are already the
# caller's outcome sets; a second positional carrying the same fact would be a second producer of
# it, and the two would eventually disagree on a line whose whole job is to state an identity.
configured = sum(1 for role, _ in rows if role != "buildless")

TEST_HEADS = {"tests", "test", "test_package", "benchmarks", "benchmark", "bench"}
by_len = sorted((d for _, d in rows), key=len, reverse=True)
per = {d: [0, 0] for _, d in rows}
unattributed = []
for f in files:
    for d in by_len:
        base = d.rstrip("/")
        if f.startswith(base + "/"):
            per[d][0] += 1
            if f[len(base) + 1:].split("/", 1)[0] in TEST_HEADS:
                per[d][1] += 1
            break
    else:
        if f.startswith(prefix):
            unattributed.append(f)

print(f"malf commands: SUMMARY · root={root} · db={db}")
print(f"malf commands:   members {selected} selected = {configured} configured + {content_only} content-only "
      f"+ {buildless} buildless (content-only = no CMakeLists.txt anywhere, nothing to index; "
      f"buildless = no CMakePresets.json, so only its test_package reaches the database)")
print(f"malf commands:   test_package {tp_present} present = {tp_configured} configured + {tp_failed} failed + "
      f"{int(tp_present) - int(tp_configured) - int(tp_failed)} unreached (in the census, in neither "
      f"outcome set)")
print(f"malf commands:   entries {len(files)} = first-party {first} (under {root}) + external {len(files) - first}")
rows_total = sum(n for n, _ in per.values())
print(f"malf commands:   first-party {first} = {rows_total} in the member rows below + {len(unattributed)} "
      f"unattributed (first-party, under no member — a legitimate shape, never a fault)")
if unattributed:
    where = sorted({os.path.dirname(os.path.relpath(f, root)) for f in unattributed})
    shown = ", ".join(where[:5]) + (f", +{len(where) - 5} more" if len(where) > 5 else "")
    print(f"malf commands:   unattributed live under: {shown}")
width = max((len(os.path.relpath(d, root)) for _, d in rows), default=1)
for role, d in rows:
    n, t = per[d]
    print(f"malf commands:   {os.path.relpath(d, root):<{width}}  role={role:<10} {n} entries, {t} test/bench")
PY
}

cmd_compile_commands() {
    [[ $# -eq 0 ]] || _malf_refuse_option commands "$1"
    # Generate the repo-level compile_commands.json that .clangd reads
    # (CompilationDatabase: build-clang21-libcxx-release — the default leg's named
    # build root at the repo root). A repo is just a LIST of package dirs (the
    # member enumeration — a root recipe is a member too), so there is NO single-
    # vs-multi branch: each package is conan-installed, configured via its conan
    # preset (the SAME compiler/flags `malf build` uses), its test_package is
    # configured, and every emitted DB is merged. The build type is the profile's, so the DB
    # clangd reads is the configuration `malf build` / `malf test` actually produce — this line
    # used to force Debug "so test targets match malf build / malf test", which was true only
    # because those verbs forced Debug too, and stopped being true the moment either moved.
    #
    # THE PASS IS IN THREE PARTS because of the role collision documented above this function:
    # pass 1 configures each member as a target (and, on the way, DEMOTES any member that is a
    # sibling's dependency), pass 2 re-asserts the target role on exactly those demoted members,
    # and only then does the merge read the trees.
    local build_root; build_root="$(_malf_build_dir "$CWD")"
    mkdir -p "$build_root"
    # Rebuild the editor DB from scratch: clear the merged output so a single-package
    # repo's own DB (whose build dir IS the merge root) is the only copy the
    # merge reads back in (no stale entries from a previous run).
    rm -f "$build_root/compile_commands.json"

    local members=() _ref _dir
    while IFS=$'\t' read -r _ref _dir; do
        [[ -n "$_ref" && -n "$_dir" ]] && members+=("$_dir")
    done < <(_malf_member_packages "$CWD")
    if [[ ${#members[@]} -eq 0 ]]; then
        echo "malf commands: no conanfile.py found under $CWD" >&2; exit 1
    fi

    local db_dirs=("$build_root")
    local configured=()            # members that reached a target-role configure, in visit order
    local -A demoted_by_bootstrap=()   # every member dir a dependency bootstrap re-configured
    # THE OUTCOME BUCKETS ARE SETS OF MEMBER DIRECTORIES, NOT COUNTERS, and that is what makes the
    # two summary identities checkable: the residuals below are set DIFFERENCES against a census
    # this loop takes before any gate, so a future path that leaves a member early is caught by
    # arithmetic it cannot opt out of AND the offender is named. A counter each branch has to
    # remember to bump fails the other way — the branch that forgets prints a line that still sums.
    local content_only=()          # no CMakeLists.txt anywhere, its test_package's included
    local buildless=()             # the conan install produced no CMakePresets.json
    local tp_present_dirs=()       # holds a test_package/CMakeLists.txt — the census
    local tp_configured_dirs=()    # ... and its test_package configure succeeded
    local tp_failed=()             # ... and its test_package configure ran and refused
    local pkg_dir
    for pkg_dir in "${members[@]}"; do
        local subdir subdir_name subdir_build
        subdir="$pkg_dir"
        subdir_name="$(basename "$subdir")"
        # Content-only packages (no CMakeLists.txt anywhere) have no TUs to index.
        if [[ ! -f "$subdir/CMakeLists.txt" && ! -f "$subdir/test_package/CMakeLists.txt" ]]; then
            echo "malf commands: $subdir_name is content-only — skipped"
            content_only+=("$subdir")
            continue
        fi
        # The test_package CENSUS is taken HERE, before any of the gates below can drop this
        # member, so the denominator is what exists rather than what the run reached.
        local has_test_package=false
        if [[ -f "$subdir/test_package/CMakeLists.txt" ]]; then
            has_test_package=true
            tp_present_dirs+=("$subdir")
        fi
        # Canonical build dir, mirroring `malf build` — package-anchored
        # (<pkg>/build-<key>), the ONE tree per (package, profile).
        subdir_build="$(_malf_build_dir "$subdir")"
        db_dirs+=("$subdir_build")

        # conan install if this build dir has no toolchain/preset yet, so deps
        # (including test_requires like gtest) are present before cmake configures.
        if [[ ! -f "$subdir_build/CMakePresets.json" ]]; then
            mkdir -p "$subdir_build"
            echo "malf commands: installing deps for $subdir_name"
            # shellcheck disable=SC2046
            conan install "$subdir" \
                --output-folder="$subdir_build" \
                $(_malf_conan_install_args) \
                2>&1 | grep -vE "^$|^======|^Requirements|^Packages|^Build" || true
        fi
        # A MISSING PRESET BLOCKS THE MEMBER'S OWN CONFIGURE AND NOTHING ELSE, so this records a
        # fact and does not leave the iteration.
        #
        # The predicate is the ARTIFACT the install either wrote or did not, never the absence of
        # a CMakeLists.txt. Those are different questions and answering the second would be wrong
        # in both directions: a header-library legitimately has neither, while a member that DOES
        # declare a CMake project and whose install failed has the file and no preset — and reading
        # the file would let that one through as though nothing were wrong. The CMakeLists.txt is
        # read below, once, to decide whether a buildless member is a shape or a failure.
        #
        # WHAT THE REST OF THE ITERATION IS: the dependency bootstrap and the test_package
        # configure. The second needs no preset at all — it installs its own synthetic conan
        # consumer and configures `cmake -S <member>/test_package` against the toolchain THAT
        # install wrote — so a `continue` here dropped a translation unit for a reason that never
        # applied to it. Measured 2026-09-03: coderoast-server/server-logging is a header-library
        # recipe with no CMakeLists.txt, its install generates no CMakeToolchain, and it left
        # exactly here — so its test_package translation unit, the ONLY arm proving that
        # header-only seat's contract, had never been in any editor database.
        local member_has_preset=true
        if [[ ! -f "$subdir_build/CMakePresets.json" ]]; then
            member_has_preset=false
            buildless+=("$subdir")
        fi

        # Register/build the editable workspace deps this package needs.
        _malf_bootstrap_workspace_deps "$subdir"

        # CROSS-PACKAGE MODULES: fold each editable workspace dep's build DB in too.
        # clangd builds its OWN BMI for every imported module, and to build one it needs
        # that module's SOURCE unit (.cppm) present in the compile DB. A cross-package
        # import (`import insight.canon;` in an eidos file) has its .cppm in a SIBLING
        # repo, absent from this repo-scoped DB — so clangd fails to build the module and
        # reports EVERY symbol from it as unresolved. That is the false-positive flood that
        # makes named modules unusable in the editor (measured 2026-07-23: eidos's DB held
        # 0 of canon/metalog/logcraft's module units; clangd-21 --check on engine.cppm:
        # "Failed to build module insight.canon; Don't get the module unit"). The deps are
        # already built just above, so their build dirs carry exactly those units — merge
        # them. rglob in the merge dedups by file, so overlapping deps across members are
        # harmless.
        #
        # THE SAME LOOP RECORDS THE DEMOTIONS. _malf_bootstrap_workspace_deps just
        # re-configured every one of these dep dirs with tests and benches OFF; for a dep that
        # is ALSO a member of this repo, that write landed in the very tree pass 1 configured
        # as a target (one tree per (package, profile) — no role dimension), so pass 2 has to
        # put it back. Guarded on MALF_AUTO_WORKSPACE_DEPS because with the bootstrap disabled
        # nothing was demoted and a re-assert would be a configure paid for no reason.
        local _dep_ref _dep_dir _dep_build
        while IFS=$'\t' read -r _dep_ref _dep_dir; do
            [[ -n "$_dep_dir" ]] || continue
            _dep_build="$(_malf_editable_build_dir "$_dep_dir")"
            [[ -d "$_dep_build" ]] && db_dirs+=("$_dep_build")
            [[ "$MALF_AUTO_WORKSPACE_DEPS" == "0" ]] || demoted_by_bootstrap["$_dep_dir"]=1
        done < <(_malf_workspace_dep_entries "$subdir")

        # test_package (if any) -> its own compile_commands.json. DELIBERATELY ABOVE the
        # member_has_preset gate below: its inputs are the synthetic consumer's own toolchain and
        # its own source dir, and the member's preset is not among them.
        if [[ "$has_test_package" == true ]]; then
            if _malf_configure_test_package "$subdir" "$subdir_build/test_package"; then
                tp_configured_dirs+=("$subdir")
            else
                tp_failed+=("$subdir")
            fi
        fi

        # Everything below configures the MEMBER through its own preset, which a buildless member
        # does not have. _malf_write_user_presets is included on purpose: it would write an
        # include of a CMakePresets.json that does not exist, breaking `cmake --preset` in that
        # source dir for every other reader of it.
        [[ "$member_has_preset" == true ]] || continue

        # Point the source dir's CMakeUserPresets.json at the canonical build dir.
        # This MUST run AFTER the test_package install above. In a SINGLE-package repo
        # (subdir == repo root) that install — run from the repo root — APPENDS
        # build/test_package/CMakePresets.json to this very CMakeUserPresets.json
        # (conan updates an existing one unconditionally; the user_presets conf does not
        # suppress it). Both it and build/CMakePresets.json define `conan-debug`, so the
        # preset graph gains a duplicate and `cmake --preset conan-debug` aborts
        # ("Duplicate preset: conan-debug") — the package (with tests ON) then never
        # configures, and its unit-test TUs never reach the DB. Re-asserting the
        # canonical single-include here removes that pollution before we configure.
        _malf_write_user_presets "$subdir" "$subdir_build"

        # Configure the package itself via its preset -> compile_commands.json.
        # The preset's binaryDir is authoritative, so do NOT pass -B.
        local preset=""
        preset="$(_malf_resolve_preset "$subdir")"
        if [[ -n "$preset" ]]; then
            echo "malf commands: configuring $subdir_name ($preset)"
            local cmake_feature_args=()
            mapfile -t cmake_feature_args < <(_malf_cmake_feature_args "$subdir" ON ON)
            cmake --preset "$preset" -S "$subdir" \
                -DCMAKE_EXPORT_COMPILE_COMMANDS=ON \
                "${cmake_feature_args[@]}" 2>&1 | tail -1 || \
                echo "malf commands: warning: cmake configure failed for $subdir_name (continuing)"
            configured+=("$subdir")
        fi
    done

    # PASS 2 — RE-ASSERT THE TARGET ROLE on every member another member's dependency bootstrap
    # demoted. This is the `N146` repair; the block above cmd_compile_commands carries the
    # argument and the rejected alternatives. It is a CONFIGURE, not a build: nothing is
    # recompiled, the objects the dependency build produced stay valid, and the only thing that
    # changes is which targets the tree declares — which is the only thing the database records.
    # Scoped to the intersection (member AND bootstrapped) rather than run over every member,
    # because a member nothing demoted is already correct and a configure is not free.
    local reasserted=0
    for pkg_dir in "${configured[@]}"; do
        [[ -n "${demoted_by_bootstrap[$pkg_dir]:-}" ]] || continue
        local re_preset=""
        re_preset="$(_malf_resolve_preset "$pkg_dir")"
        [[ -n "$re_preset" ]] || continue
        local re_args=()
        mapfile -t re_args < <(_malf_cmake_feature_args "$pkg_dir" ON ON)
        echo "malf commands: re-asserting target role for $(basename "$pkg_dir")" \
             "(a sibling's dependency bootstrap configured it with tests and benches OFF)"
        _malf_write_user_presets "$pkg_dir" "$(_malf_build_dir "$pkg_dir")"
        cmake --preset "$re_preset" -S "$pkg_dir" \
            -DCMAKE_EXPORT_COMPILE_COMMANDS=ON \
            "${re_args[@]}" 2>&1 | tail -1 || \
            echo "malf commands: warning: re-assert configure failed for $(basename "$pkg_dir") (continuing)"
        reasserted=$((reasserted + 1))
    done
    (( reasserted == 0 )) || echo "malf commands: re-asserted the target role on $reasserted member(s)"

    _malf_merge_db_tree "$build_root" "${db_dirs[@]}"

    # THE TWO RESIDUALS, DERIVED. `unaccounted` is the members the loop reached no outcome for and
    # `tp_unreached` the test_packages in the census that reached neither outcome; both are set
    # differences, so neither can be kept at zero by a branch forgetting to record itself.
    local m
    local -A member_accounted=() tp_accounted=()
    for m in "${configured[@]}" "${content_only[@]}" "${buildless[@]}"; do member_accounted["$m"]=1; done
    local unaccounted=()
    for m in "${members[@]}"; do [[ -n "${member_accounted[$m]:-}" ]] || unaccounted+=("$m"); done
    for m in "${tp_configured_dirs[@]}" "${tp_failed[@]}"; do tp_accounted["$m"]=1; done
    local tp_unreached=()
    for m in "${tp_present_dirs[@]}"; do [[ -n "${tp_accounted[$m]:-}" ]] || tp_unreached+=("$m"); done

    # THE GATE. Every configured member's tree is interrogated for the role it is ACTUALLY in,
    # read from its own CMakeCache — so a database that is short because a member is sitting in
    # dependency role, or because it never configured at all, is a red rather than a number
    # nobody can interpret. It should never fire now that pass 2 exists; that is the point. A
    # detector that only ever fires when the repair is removed is what keeps the class from
    # coming back silently, and this one costs one sed per member.
    local rows=() demoted=() commands_rc=0
    for m in "${configured[@]}"; do
        _malf_commands_tree_role "$(_malf_build_dir "$m")"
        rows+=("$_MALF_TREE_ROLE $m")
        [[ "$_MALF_TREE_ROLE" == "target" ]] || \
            demoted+=("$_MALF_TREE_ROLE|$m|$_MALF_TREE_ROLE_VARS")
    done
    # A BUILDLESS MEMBER GETS A ROW TOO, and deliberately NOT through the role gate above: it has
    # no CMakeCache, so _malf_commands_tree_role would answer `no-cache` and the loop would red on
    # a member that is behaving exactly as its recipe says. Its role IS `buildless` — the outcome
    # the member loop already recorded, not a reading of a tree. It earns a row because it
    # CONTRIBUTES: its test_package units are in the database while its own are not, and until this
    # they were in no row, so the per-member breakdown did not account for entries it can see.
    for m in "${buildless[@]}"; do
        rows+=("buildless $m")
    done

    _malf_commands_summary "$build_root/compile_commands.json" "$CWD" \
        "${#members[@]}" "${#content_only[@]}" "${#buildless[@]}" \
        "${#tp_present_dirs[@]}" "${#tp_configured_dirs[@]}" "${#tp_failed[@]}" "${rows[@]}" || commands_rc=1

    # A test_package that did not configure is a truncation of the same database the role gate
    # guards, reached by the one path that gate cannot see: the directory is configured outside the
    # member's preset, so it leaves no CMakeCache for _malf_commands_tree_role to read. Before
    # this, the failure printed and the command exited 0 — loud on a console nobody is reading and
    # invisible to every caller.
    local tp_pkg
    for tp_pkg in "${tp_failed[@]}"; do
        commands_rc=1
        echo "malf commands: FATAL: $(basename "$tp_pkg")/test_package did not configure, so NONE of its" >&2
        echo "malf commands: translation units are in the database — the only code in the package that" >&2
        echo "malf commands: compiles it the way an outside consumer does. The configure output is in" >&2
        echo "malf commands: $(_malf_build_dir "$tp_pkg")/test_package/cmake_configure.log." >&2
    done
    for tp_pkg in "${tp_unreached[@]}"; do
        commands_rc=1
        echo "malf commands: FATAL: $(basename "$tp_pkg")/test_package was never configured, so its" >&2
        echo "malf commands: translation units are absent from the database. It is in the census the" >&2
        echo "malf commands: member loop takes before its first gate and in neither outcome set, so the" >&2
        echo "malf commands: loop left that member before the test_package configure. That is a defect" >&2
        echo "malf commands: in the loop rather than in the package: read the member loop for the path" >&2
        echo "malf commands: that skipped it." >&2
    done

    # A BUILDLESS MEMBER IS A SHAPE OR A FAILURE, AND THE CMakeLists.txt IS WHAT SEPARATES THEM.
    # A header-library recipe generates no CMakeToolchain and so no preset, and that is correct —
    # it has no units of its own to index. A member that DOES declare a CMake project and produced
    # no preset lost its whole translation-unit set, and the two states are otherwise identical
    # from the outside: same empty build dir, same absence from the per-member rows.
    local bl_pkg
    for bl_pkg in "${buildless[@]}"; do
        [[ -f "$bl_pkg/CMakeLists.txt" ]] || continue
        commands_rc=1
        echo "malf commands: FATAL: $(basename "$bl_pkg") declares a CMake project and produced no" >&2
        echo "malf commands: $(_malf_build_dir "$bl_pkg")/CMakePresets.json, so NONE of its own" >&2
        echo "malf commands: translation units are in the database. That preset comes from the" >&2
        echo "malf commands: recipe's CMakeToolchain generator, so an absent one means the conan" >&2
        echo "malf commands: install this run made for that member failed — its output is above." >&2
    done

    # THE MEMBER LINE STATES AN IDENTITY, so a member accounted for by none of its three terms
    # makes that line false. It cannot happen through any path written today; it is here because
    # the identity is what a reader checks, and a line that silently stops summing is exactly the
    # truncated-database-that-reads-as-complete failure this whole command exists to refuse.
    local ua_pkg
    for ua_pkg in "${unaccounted[@]}"; do
        commands_rc=1
        echo "malf commands: FATAL: $(basename "$ua_pkg") is a selected member that reached none of" >&2
        echo "malf commands: the three outcomes the member line accounts for — configured," >&2
        echo "malf commands: content-only, buildless — so that line's identity does not hold and the" >&2
        echo "malf commands: status of its translation units is unknown. A defect in the member loop." >&2
    done

    if (( ${#demoted[@]} > 0 )); then
        commands_rc=1
        local row _role _pkg _vars
        for row in "${demoted[@]}"; do
            IFS='|' read -r _role _pkg _vars <<< "$row"
            if [[ "$_role" == "no-cache" ]]; then
                echo "malf commands: FATAL: $(basename "$_pkg") never configured — there is no" >&2
                echo "malf commands: $(_malf_build_dir "$_pkg")/CMakeCache.txt, so NONE of its" >&2
                echo "malf commands: translation units are in the database." >&2
            else
                echo "malf commands: FATAL: $(basename "$_pkg") is in the database as a DEPENDENCY, not as the" >&2
                echo "malf commands: indexed target ($_vars = OFF in $(_malf_build_dir "$_pkg")/CMakeCache.txt)," >&2
                echo "malf commands: so its test and benchmark translation units are ABSENT. A dependency" >&2
                echo "malf commands: configure wrote that tree after its target configure." >&2
            fi
        done
        echo "malf commands: the editor index is this file's only reader, and an editor reports a" >&2
        echo "malf commands: missing TU as an unknown symbol rather than as a missing TU — so a" >&2
        echo "malf commands: truncated database is silent. This refuses instead of handing one over." >&2
    fi
    exit "$commands_rc"
}

# Does this package DECLARE a benchmark target? Answered from SOURCE, before any build.
#
# `malf bench` used to answer it from the build OUTPUT — build the package, then look for a
# *bench* executable and skip if none. Correct, and it pays a full compile for every benchless
# package in a sweep (llm, fuzz, insight-mcp, sift today) purely to learn there was nothing
# to run. That was most of the sweep's marginal cost.
#
# The predicate is the same one the output check applies, evaluated one step earlier: a bench
# executable exists iff some CMakeLists declares an `add_executable(<...>bench...)`. Validated
# against every workspace package before being trusted, and the direction matters — a false
# POSITIVE only costs the build we already paid, while a false NEGATIVE would silently drop a
# package's benchmarks. Measured: zero false negatives (every package producing bench exes is
# detected), and the only "extra" hits are real declarations whose build dir simply had not been
# built with benchmarks on. The output check below is KEPT as the belt: this is a fast-path skip,
# never the sole authority.
_malf_pkg_declares_bench() {
    local target="$1"
    find "$target" -name CMakeLists.txt -not -path '*/build*' -not -path '*/.conan2/*' 2>/dev/null \
        | xargs -r rg -l -i 'add_executable\s*\(\s*[A-Za-z0-9_]*bench' 2>/dev/null \
        | head -1 | grep -q .
}

cmd_bench() {
    local subdir="" quick=false filter="" compare=false threshold="0.10" baseline="" extra=()
    local repetitions="" fwd=() no_build=false
    # No build-type seed and no --debug/--release — see cmd_build. A benchmark run is meaningful
    # only under an optimized profile, and that is now a property of the profile you name: the dev
    # default declares Release, and `--asan` declares Debug because an instrumented -O1 build is
    # what that leg IS. Seeding Release here silently produced an optimized tree inside
    # build-clang21-asan/ when a caller combined the two.
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --compare)   compare=true; fwd+=("$1") ;;
            --threshold) threshold="$2"; fwd+=("$1" "$2"); shift ;;
            --baseline)  baseline="$2"; fwd+=("$1" "$2"); shift ;;
            --repetitions) repetitions="$2"; fwd+=("$1" "$2"); shift ;;
            --quick)     quick=true; fwd+=("$1") ;;
            # Run the benches that are already built; do NOT compile first. Exists so a caller can
            # separate the two phases — notably the CI deadlock watchdog, which must time the RUN
            # only. Wrapping `malf bench` whole makes the watchdog's budget track COMPILE time, so
            # a slow build reports a "presumed DEADLOCK" that never happened.
            --no-build)  no_build=true; fwd+=("$1") ;;
            --filter)    filter="$2"; fwd+=("$1" "$2"); shift ;;
            --profile)   fwd+=("$1" "$2"); shift; _malf_apply_profile "$1" ;;
            --asan)      _malf_apply_profile "$MALF_ASAN_PROFILE"; fwd+=("$1") ;;
            --)          shift; extra+=("$@"); fwd+=(-- "$@"); break ;;
            # Build exactly the recipe at the resolved dir, never the recipes below it.
            # Not forwarded: a sweep cannot occur under it, so a member never sees it.
            --only)    MALF_ONLY=1 ;;
            -*)          _malf_refuse_option bench "$1" ;;   # benchmark flags go after `--`
            *)           subdir="$1" ;;
        esac
        shift
    done

    _malf_resolve_target_or_sweep bench "$subdir" "${fwd[@]}"
    local target="$MALF_TARGET"

    # Sweep fast path: skip a benchless package BEFORE paying for its build. Sweep only —
    # an explicit `malf bench <pkg>` must still reach the hard error below, because you asked
    # for benches by name and silence would be the wrong answer.
    if [[ "${MALF_SWEEP:-0}" == "1" ]] && ! _malf_pkg_declares_bench "$target"; then
        echo "malf bench: $(basename "$target") declares no benchmark target — skipped (not built)"
        return 0
    fi

    _malf_use_keyed_cache

    echo "=== malf bench: $target ($MALF_CONFIG) ==="

    if [[ "$no_build" == true ]]; then
        echo "malf bench: --no-build — running the benches already present in the build tree"
    else
        _malf_build_flow "$target"
    fi

    if [[ ! -f "$target/CMakeLists.txt" ]]; then
        return 0   # content-only: nothing to run either
    fi
    local build_dir
    build_dir="$(_malf_build_dir "$target")"

    # Find bench executables (*_bench or *bench*)
    local bench_exes=()
    while IFS= read -r exe; do bench_exes+=("$exe"); done < <(
        find "$build_dir" -maxdepth 3 -type f -executable \
            \( -name "*bench*" -o -name "*benchmark*" \) \
            -not -name "*.sh" 2>/dev/null | sort
    )

    if [[ ${#bench_exes[@]} -eq 0 ]]; then
        # In a multi-package sweep a benchless package is normal — skip it.
        # An EXPLICIT `malf bench <pkg>` stays a hard error (you asked for benches).
        if [[ "${MALF_SWEEP:-0}" == "1" ]]; then
            echo "malf bench: no benchmark executables in $(basename "$target") — skipped"
            return 0
        fi
        echo "malf bench: no benchmark executables found in $build_dir" >&2; exit 1
    fi

    local out_dir="$target/bench_results"
    mkdir -p "$out_dir"
    local ts
    ts="$(date +%Y%m%dT%H%M%S)"

    # The regression gate is variance-aware (bench_compare.py): comparing needs SAMPLES, so
    # --compare defaults to 5 repetitions (median + cv aggregates). This is loop-INVARIANT — it
    # reads only --repetitions and --compare — so it is derived once, here, rather than
    # re-derived per executable. That is also what lets the baseline guard below read it.
    local reps="${repetitions:-$($compare && echo 5 || echo 1)}"

    local last_json=""
    for exe in "${bench_exes[@]}"; do
        local name
        name="$(basename "$exe")"
        local out_file="${out_dir}/${name}_${ts}.json"
        local bench_args=(
            "--benchmark_out=${out_file}"
            "--benchmark_out_format=json"
        )
        $quick && bench_args+=("--benchmark_min_time=0.1")
        if [[ "$reps" -gt 1 ]]; then
            bench_args+=("--benchmark_repetitions=${reps}"
                         "--benchmark_report_aggregates_only=true")
        fi
        [[ -n "$filter" ]] && bench_args+=("--benchmark_filter=$filter")

        echo "=== malf bench: $name ==="
        "$exe" "${bench_args[@]}" "${extra[@]}"
        echo "Results saved to: $out_file"
        last_json="$out_file"
    done

    # ── update the baseline only from a run that IS a baseline measurement ─────
    # The baseline is what every later --compare is judged against, so a run that measured
    # something other than the whole suite at full precision must never silently become one:
    # the next comparison then reads noise as a regression or as a win, and nothing in its
    # output says the BASELINE was the unusual half. Four refusals, each for its own reason,
    # and each NAMED in the message — a silent refusal would only move the surprise.
    #   --compare      this run is the challenger; overwriting the reference it was just
    #                  judged against destroys the comparison and the next one too.
    #   --quick        --benchmark_min_time=0.1 is a different measurement CONFIGURATION, not
    #                  a faster one. Comparing a full run against it is a ratio across two
    #                  configurations, which is the one thing a ratio may not be.
    #   --filter       the JSON holds only the matched subset, so the next --compare takes
    #                  bench_compare.py's missing-benchmark path and exits 1 on every bench
    #                  the filter excluded. MEASURED TWICE, and both times the file had to be
    #                  restored from a hand-made copy (DONE.md, the insight-metalog KeyAlloc
    #                  runs: "a plain `malf bench` copies the filtered run's JSON over
    #                  bench_results/baseline.json").
    #   reps == 1      a single sample carries no cv, so bench_compare.py cannot widen the
    #                  threshold from the baseline side at all and falls back to the
    #                  challenger's own noise. All six published hub baselines are 100%
    #                  aggregate (488 rows, 0 single-run — measured 2026-08-05), so a
    #                  single-sample baseline is not what any real baseline here is.
    # What this does NOT refuse, and the distinction is load-bearing: bench_compare.py's
    # single-sample branch stays live and wanted, because it is for the CHALLENGER side — an
    # ad-hoc `malf bench` judged against a good baseline. This guard is about the WRITER.
    if [[ -n "$last_json" && -f "$last_json" ]]; then
        local refusals=()
        if $compare; then
            refusals+=("--compare: this run is the challenger, not a new reference")
        fi
        if $quick; then
            refusals+=("--quick: --benchmark_min_time=0.1 is a different measurement configuration")
        fi
        if [[ -n "$filter" ]]; then
            refusals+=("--filter '$filter': the JSON holds only the matched subset")
        fi
        if [[ "$reps" -le 1 ]]; then
            refusals+=("--repetitions $reps: a single sample carries no cv")
        fi
        if [[ ${#refusals[@]} -eq 0 ]]; then
            cp "$last_json" "$out_dir/baseline.json"
            echo "Baseline updated: $out_dir/baseline.json ($reps repetitions, unfiltered, full precision)"
        else
            echo "malf bench: baseline NOT updated — $out_dir/baseline.json is unchanged, because:"
            printf 'malf bench:   · %s\n' "${refusals[@]}"
            echo "malf bench: this run's results are in $last_json."
            echo "malf bench: to make a baseline: malf bench $(basename "$target") --repetitions 5" \
                 "(no --quick, no --filter, no --compare)"
        fi
    fi

    # ── bench --compare ────────────────────────────────────────────────────────
    if $compare; then
        [[ -z "$baseline" ]] && baseline="$target/bench_results/baseline.json"
        if [[ ! -f "$baseline" ]]; then
            echo "malf bench --compare: error: baseline not found: $baseline" >&2; exit 2
        fi
        if [[ -z "$last_json" || ! -f "$last_json" ]]; then
            echo "malf bench --compare: error: no bench JSON produced" >&2; exit 2
        fi
        echo
        echo "Comparing $last_json vs $baseline (floor ±$(python3 -c "print(${threshold}*100)")%, variance-aware)"
        echo
        python3 "$MALF_DIR/bench_compare.py" "$baseline" "$last_json" "$threshold"
    fi
}

_malf_editables_sync() {
    # Clear the editable registry and re-register every workspace package at the
    # version currently declared in its conanfile.py. `malf build/test` now self-heal
    # stale same-name editables for the deps they touch (see _malf_editable_add), so the
    # normal "bump then build a consumer" cycle no longer needs this. Sync remains the
    # one-shot for the cases the per-build path can't reach: a bumped package that is
    # never built as a dep in a given cache (its stale ref lingers unused), and syncing
    # EVERY keyed cache at once (the per-build path only refreshes the active one).
    # Registration alone fixes resolution — editables build on demand.
    local entries=()
    mapfile -t entries < <(_malf_workspace_packages)
    if [[ ${#entries[@]} -eq 0 ]]; then
        echo "malf editables sync: no workspace packages found under $MALF_WORKSPACE_ROOT" >&2
        exit 1
    fi

    # Sync EVERY cache, not just the active one. malf keys CONAN_HOME per build-type
    # (the base + .conan2/<key> keyed subdirs, each created by _malf_use_keyed_cache);
    # each keyed cache has its OWN editable registry. Syncing only the active cache left
    # the others drifting — e.g. after a 1.x→1.5.0 bump the gcc15-release cache still
    # carried stale 1.4.x editables + a partial 1.5.0 set, so a `--profile linux-gcc15-release`
    # build failed to resolve a freshly-bumped dep.
    local caches; mapfile -t caches < <(_malf_conan_homes)

    local cache entry ref dep_dir label
    for cache in "${caches[@]}"; do
        export CONAN_HOME="$cache"
        label="${cache#$MALF_CONAN_HOME_BASE}"; label="${label#/}"; [[ -z "$label" ]] && label="base"
        echo "malf editables sync [$label]: re-registering ${#entries[@]} package(s)"
        _malf_editables_clear
        for entry in "${entries[@]}"; do
            IFS=$'\t' read -r ref dep_dir <<< "$entry"
            [[ -n "$ref" && -n "$dep_dir" ]] || continue
            _malf_editable_add "$dep_dir"
        done
    done
    echo "malf editables sync: ${#caches[@]} cache(s) re-registered to ${#entries[@]} editables each"
}

cmd_editables() {
    local sub="${1:-}"
    case "$sub" in
        list)     conan editable list ;;
        sync)     _malf_editables_sync ;;
        "")       echo "malf editables: specify a subcommand (list|sync)" >&2; exit 1 ;;
        *)        echo "malf editables: unknown subcommand '$sub' (list|sync)" >&2; exit 1 ;;
    esac
}

# Regenerate malf/conan.lock by ACCUMULATING every workspace root into one lockfile
# (`conan lock create` chained --lockfile in / --lockfile-out). One file serves every
# profile: measured 2026-07-21, the clang-21 and gcc-15 lockfiles for coderoast_server are
# byte-identical (44 requires / 12 build_requires), because `requires` is profile-independent
# — so per-profile lockfiles would be 9 copies of one fact.
#
# First-party editables land WITHOUT a recipe revision, i.e. they float and are resolved from
# the editable registry. Only third-party is revision-pinned — which is the whole point.
#
# CAREFUL — the sentence that used to sit here said "first-party churn never touches this
# file", and that is only true of REVISION churn. First-party entries still carry a VERSION,
# so a post-cut `malf bump` desynchronises this file from every recipe: the recipes read the
# new version and the lockfile still names the old one. CI resolves strict, and strict RAISES
# `Requirement '<pkg>/<new>' not in lockfile` rather than degrading — so it reds every repo
# before any of the cut's actual work is reached. Measured twice, one cut apart (the 1.8.4 and
# 1.8.5 bumps), and the old comment is the likeliest reason it recurred: it tells a reader this
# file needs no attention on a first-party change. It does, on a version change.
#
# The fix after a bump is a plain `malf lock` (behaviour-neutral: first-party versions only,
# third-party untouched) — NOT `--update`, which additionally pulls upstream movement.
#
# By default this locks WHAT WE CURRENTLY BUILD (no --update), so regenerating on a green
# tree is behaviour-neutral and any later red is attributable to the change that caused it.
# `--update` resolves ranges against the REMOTES instead (newest), which is how you take
# upstream movement deliberately — expect a reviewable diff, and re-run the gates.
# Every SBOM the workspace publishes, as "<package dir>|<sbom path>". These are DERIVED
# artifacts (malf/sbom_gen.py projects the resolved conan graph) — the hand-maintained
# predecessor drifted three minors before anyone noticed, and since sbom-cve.yml scans the
# file, its accuracy is the ceiling on our CVE detection.
_MALF_SBOM_TARGETS=(
    "insight-eidos/sift|insight-eidos/sift/sbom.cdx.json"
    "coderoast-server/server|coderoast-server/server/sbom.cdx.json"
)

# `malf sbom` regenerates them; `malf sbom --check` fails if one is stale against the graph,
# which is the form a CI/release leg wants.
cmd_sbom() {
    local check="" rc=0 entry pkg out
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --check) check="--check" ;;
            *) _malf_refuse_option sbom "$1" ;;
        esac
        shift
    done
    for entry in "${_MALF_SBOM_TARGETS[@]}"; do
        pkg="${entry%%|*}"; out="${entry##*|}"
        python3 "$MALF_DIR/sbom_gen.py" \
            --root "$MALF_WORKSPACE_ROOT/$pkg" \
            --profile "$MALF_PROFILE" \
            --lockfile "$MALF_DIR/conan.lock" \
            --out "$MALF_WORKSPACE_ROOT/$out" \
            ${check:+$check} || rc=1
    done
    return $rc
}

cmd_lock() {
    local update="" root
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --update) update="--update" ;;
            *) _malf_refuse_option lock "$1" ;;
        esac
        shift
    done

    local out tmp ok=0 fail=0 failed=()
    out="$MALF_DIR/conan.lock"
    tmp="$(mktemp)"; rm -f "$tmp"

    echo "=== malf lock: accumulating every root${update:+ (--update: resolving ranges from REMOTES)} ==="
    # Reuse the SAME enumeration `editables sync` uses — a second recipe-discovery path here
    # would drift from it the first time a package is added.
    while IFS= read -r root; do
        local args=(--profile:all="$MALF_PROFILE" --lockfile-out="$tmp")
        [[ -f "$tmp" ]] && args+=(--lockfile="$tmp")
        [[ -n "$update" ]] && args+=("$update")
        if conan lock create "$root" "${args[@]}" >/dev/null 2>&1; then
            ok=$((ok + 1)); printf '  ok    %s\n' "${root#"$MALF_WORKSPACE_ROOT"/}"
        else
            fail=$((fail + 1)); failed+=("${root#"$MALF_WORKSPACE_ROOT"/}")
            printf '  FAIL  %s\n' "${root#"$MALF_WORKSPACE_ROOT"/}"
        fi
    done < <(_malf_workspace_packages | cut -f2)

    # A root that fails to resolve is NOT a partial success: its third-party edges would be
    # silently absent from the lockfile, and an absent entry resolves freely — the exact drift
    # the lockfile exists to stop. Refuse to install a lockfile that does not cover the tree.
    if [[ $fail -gt 0 ]]; then
        echo "malf lock: $fail root(s) failed to resolve — lockfile NOT written:" >&2
        printf '  - %s\n' "${failed[@]}" >&2
        rm -f "$tmp"
        return 1
    fi
    mv "$tmp" "$out"
    echo "=== malf lock: $ok root(s) -> $out ==="
    python3 - "$out" <<'PY'
import json, sys
d = json.load(open(sys.argv[1]))
req = d.get("requires", [])
pinned = [r for r in req if "#" in r]
print(f"    requires        {len(req):>3}  ({len(pinned)} third-party pinned, "
      f"{len(req) - len(pinned)} first-party floating)")
print(f"    build_requires  {len(d.get('build_requires', [])):>3}  (all third-party pinned)")
multi = {}
for r in req + d.get("build_requires", []):
    multi.setdefault(r.split("/")[0], set()).add(r.split("#")[0])
multi = {k: sorted(v) for k, v in multi.items() if len(v) > 1}
if multi:
    print("    NOTE — pinned at MULTIPLE versions (two roots disagree; a link-time skew "
          "hazard, not a lockfile error):")
    for k, v in sorted(multi.items()):
        print(f"      {k}: {', '.join(v)}")
PY

    # The lockfile IS the resolved graph, and the SBOM is a projection of it, so
    # writing one without re-deriving the other publishes a description of a graph that no
    # longer exists. `--update` is the sharp case: it re-resolves third-party against the
    # REMOTES, so upstream movement lands in the lock and the committed SBOM silently stops
    # matching — and the SBOM's accuracy is the ceiling on CVE detection, since sbom-cve.yml
    # scans that file and a component it omits is one no scanner ever looks at.
    #
    # Chained here as well as in `bump` because the two commands move DIFFERENT halves of the
    # graph — bump moves first-party, `lock --update` moves third-party — and the documented
    # post-cut ceremony runs them back to back. Fixing only bump would leave the operator's
    # manual `malf sbom` as the sole thing between a bump and a red tag in exactly the case
    # where upstream had moved, which is the case that matters.
    echo "── re-deriving the SBOM from the graph just locked ──"
    cmd_sbom || return 1
}

# Surgically remove STALE first-party conan packages: old-version (and ghost/renamed)
# binaries of CodeRoast-owned packages left in the cache after a coordinated version bump.
# They are INERT for malf builds — editables shadow every first-party ref at the current
# version — but they are disk bloat and a real footgun for any RAW (non-malf) conan call,
# especially the stray ~/.conan2 which has no editables to shadow them. The surgical opposite
# of `clean conan` (which nukes every package dir, third-party included, forcing a full
# from-source rebuild — our own gcc toolchain has no ConanCenter binaries). SAFE by construction: removes ONLY
# CodeRoast namespaces (pin_coherence.CODEROAST_PREFIXES — the single source of truth) at a
# version != the uniform workspace baseline; NEVER third-party, NEVER the current version.
# Sweeps every cache `editables sync` touches (base + keyed subdirs) plus the stray default
# home.
_malf_clean_stale() {
    # Homes: base + every keyed subdir (_malf_conan_homes, exactly as editables sync), plus
    # the stray default ~/.conan2 iff it is a real, DISTINCT cache (raw conan ran outside malf).
    local homes; mapfile -t homes < <(_malf_conan_homes)
    local d
    if [[ -f "$HOME/.conan2/settings.yml" ]] \
        && [[ "$(realpath "$HOME/.conan2")" != "$(realpath "$MALF_CONAN_HOME_BASE")" ]]; then
        homes+=("$HOME/.conan2")
    fi

    # Read-only planning pass (Python): derive the uniform baseline + owned namespaces from
    # the recipes, list each home, emit "home<TAB>ref" for every stale first-party package.
    # Python only READS (conan list); the conan remove WRITES stay in bash below, visible.
    local plan
    plan="$(python3 - "$MALF_WORKSPACE_ROOT" "${homes[@]}" <<'PY'
import ast, json, os, pathlib, subprocess, sys

ws = pathlib.Path(sys.argv[1]).resolve()
homes = sys.argv[2:]
sys.path.insert(0, str(ws / "scripts"))
from pin_coherence import CODEROAST_PREFIXES   # single source of truth for owned namespaces

# Uniform workspace baseline from the first-party recipes (refuse to guess if non-uniform).
ignore = {".conan2", ".git", ".venv", "node_modules", "test_package"}
def skip(p): return any(x in ignore or x == "build" or x.startswith("build-") for x in p.parts)
versions = set()
for cf in ws.rglob("conanfile.py"):
    if skip(cf):
        continue
    tree = ast.parse(cf.read_text(), filename=str(cf))
    nodes = list(tree.body)
    for item in tree.body:
        if isinstance(item, ast.ClassDef):
            nodes.extend(item.body)
    name = version = None
    for node in nodes:
        if isinstance(node, ast.Assign) and isinstance(node.value, ast.Constant) \
                and isinstance(node.value.value, str):
            for tgt in node.targets:
                if getattr(tgt, "id", None) == "name":
                    name = node.value.value
                elif getattr(tgt, "id", None) == "version":
                    version = node.value.value
    if name and name.startswith(CODEROAST_PREFIXES) and version:
        versions.add(version)
if len(versions) != 1:
    sys.stderr.write(f"malf clean stale: workspace baseline is not uniform "
                     f"({sorted(versions) or 'no first-party recipes found'}) — fix pin coherence "
                     f"(`malf bump` / `malf editables sync`) before pruning stale cache\n")
    sys.exit(2)
baseline = next(iter(versions))
sys.stderr.write(f"malf clean stale: baseline {baseline}; sweeping {len(homes)} cache(s)\n")

for home in homes:
    res = subprocess.run(["conan", "list", "*/*", "--format=json"],
                         env={**os.environ, "CONAN_HOME": home}, capture_output=True, text=True)
    if res.returncode != 0:
        continue
    try:
        refs = json.loads(res.stdout).get("Local Cache", {})
    except json.JSONDecodeError:
        continue
    for ref in refs:
        name, _, version = ref.partition("/")
        if name.startswith(CODEROAST_PREFIXES) and version and version != baseline:
            print(f"{home}\t{ref}")
PY
)" || return 1

    if [[ -z "$plan" ]]; then
        echo "malf clean stale: no stale first-party packages in any cache — already clean."
        return 0
    fi

    local removed=0 failed=0 home ref label
    while IFS=$'\t' read -r home ref; do
        [[ -n "$home" && -n "$ref" ]] || continue
        label="${home#$MALF_CONAN_HOME_BASE}"; label="${label#/}"
        [[ -z "$label" ]] && label="base"
        [[ "$home" == "$HOME/.conan2" ]] && label="stray ~/.conan2"
        if CONAN_HOME="$home" conan remove "$ref" -c >/dev/null 2>&1; then
            echo "  removed  $ref   [$label]"
            removed=$((removed + 1))
        else
            echo "  FAILED   $ref   [$label]" >&2
            failed=$((failed + 1))
        fi
    done <<< "$plan"
    echo "malf clean stale: removed $removed stale first-party ref(s) ($failed failed)"
    [[ $failed -eq 0 ]]
}

# CWD + every member package dir under it — where package-anchored build trees
# (and the repo root's merged clangd DB) live. `clean build` and `run` walk these.
_malf_build_tree_roots() {
    echo "$CWD"
    local _ref _dir
    while IFS=$'\t' read -r _ref _dir; do
        [[ -n "$_dir" && "$_dir" != "$CWD" ]] && echo "$_dir"
    done < <(_malf_member_packages "$CWD")
}

_malf_clean_build_trees() {
    local dir
    while IFS= read -r dir; do
        rm -rf "$dir"/build "$dir"/build-*
    done < <(_malf_build_tree_roots)
}

# NO DEFAULT TARGET, since 2026-09-02 (Founder: "N114 : Yes, semantic change approved"). A bare
# `malf clean` used to mean `all`, so ONE MISSING WORD wiped every build tree under the cwd, every
# cached conan package (third-party included — our gcc-16 toolchain has no ConanCenter binary, so
# the next build is a from-source rebuild of the world) and the editable registry. That is the
# N113 class on the last verb still carrying it: a bare invocation performing a workspace-wide
# destructive act. It now refuses and removes nothing.
#
# The refusal SPELLS `malf clean all`, because an operator reads a terminal, not a runbook: a
# refusal that does not say what to type next has moved the work, not removed it. An extra
# argument is refused for the same reason — `malf clean build conan` used to run `build` and drop
# `conan` silently, which reports a cache as wiped that is still there.
cmd_clean() {
    local target="${1:-}"
    case "$target" in -*) _malf_refuse_option clean "$target" ;; esac
    if [[ -z "$target" ]]; then
        echo "malf clean: no target — nothing was removed. 'clean' has no default." >&2
        echo "  build     build trees under the cwd (and every member package)" >&2
        echo "  conan     cached conan packages" >&2
        echo "  editables the editable registry" >&2
        echo "  stale     old-version/ghost first-party packages only" >&2
        echo "  all       THE NUCLEAR FORM: all three at once — type 'malf clean all'" >&2
        _malf_usage_of clean >&2
        exit 1
    fi
    [[ $# -le 1 ]] || { echo "malf clean: one target at a time; got '$*'. Re-run 'malf clean $target', then the next one." >&2; exit 1; }
    case "$target" in
        build)     _malf_clean_build_trees ;;
        conan)     rm -rf "$MALF_CONAN_HOME_BASE"/p "$MALF_CONAN_HOME_BASE"/*/p ;;
        editables) _malf_editables_clear ;;
        stale)     _malf_clean_stale; return $? ;;
        all)       _malf_clean_build_trees && rm -rf "$MALF_CONAN_HOME_BASE"/p "$MALF_CONAN_HOME_BASE"/*/p && _malf_editables_clear ;;
        *)         echo "malf clean: unknown target '$target' (build|conan|editables|stale|all)" >&2; _malf_usage_of clean >&2; exit 1 ;;
    esac
    echo "malf clean: $target done"
}

cmd_run() {
    local exe_name="${1:-}"
    case "$exe_name" in -*) _malf_refuse_option run "$exe_name" ;; esac
    [[ -n "$exe_name" ]] || { echo "malf run: specify an executable name" >&2; exit 1; }
    local found="" dir
    while IFS= read -r dir; do
        found="$(find "$dir"/build "$dir"/build-* -type f -executable -name "$exe_name" \
            -not -name "*.sh" 2>/dev/null | head -1)"
        [[ -n "$found" ]] && break
    done < <(_malf_build_tree_roots)
    if [[ -z "$found" ]]; then
        echo "malf run: '$exe_name' not found in any package build tree under $CWD" >&2; exit 1
    fi
    echo "malf run: $found"
    exec "$found" "${@:2}"
}

# The usage of ONE verb, extracted from `cmd_help`'s own text — its line and the indented
# continuation lines under it, up to the next verb line, a blank line or a section header. One
# authoring: the help text is the registry, and a verb without a line there says so by name.
_malf_usage_of() {
    local verb="$1" pat
    case "$verb" in
        commands|compile-commands) pat='^    commands [|] compile-commands' ;;
        *)                         pat="^    ${verb}( |\$)" ;;
    esac
    local block
    block="$(cmd_help | awk -v pat="$pat" '
        !found && $0 ~ pat { found = 1; print; next }
        found && ($0 ~ /^    [a-z][a-z-]*( |$|\|)/ || $0 ~ /^$/ || $0 !~ /^ /) { exit }
        found { print }')"
    if [[ -n "$block" ]]; then
        echo "usage:"; printf '%s\n' "$block"
    else
        echo "usage: malf $verb — no usage line in 'malf help' for this verb"
    fi
}

# THE ONE REFUSAL EVERY VERB SHARES: name the option, print the verb's usage, exit 1. Never a
# fall-through. Measured 2026-09-02 (N113): `malf bench --help` — no such flag — was forwarded to
# the benchmark binaries as an extra argument, the target stayed empty, and the empty target is
# the WORKSPACE-WIDE sweep: started beside a live `malf lint`, outside the build-slot protocol,
# and stopped only by a closed pipe. `build`/`test`/`bin-dir` did the other wrong thing (the
# unknown flag became the TARGET — and bin-dir's exit died inside a `$(…)`, so a script reading
# it got exit 0 and a wrong path), `commands`/`profiles` dropped every argument. An unknown flag
# is an error and exits 1; `-h`/`--help` is a usage request and exits 0 — the dispatch answers it
# before any verb runs. tests/test_malf.sh [2b] proves both for every dispatched verb.
_malf_refuse_option() {
    echo "malf $1: unknown option '$2'" >&2
    _malf_usage_of "$1" >&2
    exit 1
}

cmd_help() {
    cat <<'EOF'
